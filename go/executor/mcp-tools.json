[
  {
    "name": "request_child",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "description": "Submit separate Fleet work. Reuse requestId on retry. After acceptance finish your turn so the child can run; do not wait or claim completion.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "profileId",
        "input"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "profileId": {
          "type": "string",
          "enum": [
            "reviewer"
          ]
        },
        "input": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32000
        }
      }
    }
  },
