  {
    "name": "connections_key_request",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "description": "Ask the owner to add an API key to a Fleet connection. Never pass a key value: the owner pastes it into a field Fleet shows them, and the answer in question_history is only {connection, fingerprint, state} or decline. Reuse requestId on retry.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "connection"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "connection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "The connection name, as in the API keys screen."
        },
        "reason": {
          "type": "string",
          "maxLength": 500,
          "description": "Why the work needs the key."
        }
      }
    }
  },
  {
    "name": "artifact_save",
    "description": "Store a file of your working area as an artifact of this execution now (otherwise FLEET_OUTPUT_DIR is collected when the run ends). required=true makes this run wait for it.",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "artifact_list",
    "description": "List artifact metadata, newest first, 50 per call; never returns content. Without arguments: this execution's artifacts. scope=\"project\" lists the whole project; execution_id or task_id list another execution or task. A reply with nextCursor has more: call again with cursor set to it.",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "execution_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "execution",
            "project"
          ]
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "artifact_get",
    "description": "Download an artifact into FLEET_INPUT_DIR and return its local path and metadata.",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "session_start",
    "description": "Start a new Fleet session in your project: requestId, preset (an id from session_presets) or role (pm|worker|reviewer from the project roles) or profileId, optional access read|write and branch true|false (override the preset; write needs a branch), text (first turn), setup run|skip. You are woken with a message when it finishes.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "profileId": {
          "type": "string"
        },
        "account": {
          "type": "string"
        },
        "hostId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "setup": {
          "type": "string"
        },
        "preset": {
          "type": "string"
        },
        "access": {
          "type": "string",
          "enum": [
            "read",
            "write"
          ]
        },
        "branch": {
          "type": "boolean"
        }
      },
      "required": [
        "requestId"
      ]
    }
  },
  {
    "name": "session_presets",
    "annotations": {
      "readOnlyHint": true,
