  {
    "name": "pipeline_run",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "description": "Start a pipeline search for query. Reuse requestId on retry: the same requestId returns the same run. A search may return a durable running run; read it with pipeline_get by runId, never redispatch after an uncertain response.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "query"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "methodId": {
          "type": "string",
          "description": "A method id from catalogue; omitted, Fleet recommends one."
        }
      }
    }
  },
