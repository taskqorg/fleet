[
  {
    "name": "request_child",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "description": "Submit separate Fleet work. Reuse requestId on retry. After acceptance finish your turn so the child can run; do not wait or claim completion.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "profileId",
        "input"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "profileId": {
          "type": "string",
          "enum": [
            "reviewer"
          ]
        },
        "input": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32000
        }
      }
    }
  },
  {
    "name": "project_context",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "description": "The project's settings and context. The host supplies the project; no arguments.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  },
  {
    "name": "catalogue",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "description": "The project's search methods and pipelines. No arguments.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  },
  {
    "name": "pipeline_run",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "description": "Start a pipeline search for query. Reuse requestId on retry: the same requestId returns the same run. A search may return a durable running run; read it with pipeline_get by runId, never redispatch after an uncertain response. If truncated is true, use pipeline_get with the returned id for details.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "query"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "methodId": {
          "type": "string",
          "description": "A method id from catalogue; omitted, Fleet recommends one."
        }
      }
    }
  },
  {
    "name": "direct_search",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    },
    "description": "Run a direct search for query, as pipeline_run. Reuse requestId on retry; read a running run with pipeline_get by runId.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "query"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "methodId": {
          "type": "string",
          "description": "A method id from catalogue; omitted, Fleet recommends one."
        }
      }
    }
  },
  {
    "name": "pipeline_history",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "description": "Page through this project's pipeline runs oldest first. Pass nextCursor as cursor to continue. Use pipeline_get for full run details.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 19,
          "description": "nextCursor from the previous page."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      }
    }
  },
  {
    "name": "pipeline_get",
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "description": "One pipeline run of this project by runId.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  },
  {
    "name": "question_ask",
