{
  "$comment": "Fleet design tokens. Source of truth; docs/design-system/tokens.md explains them. scripts/tokens.mjs turns this into CSS custom properties.",
  "font": {
    "sans": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "size-xs": "11px",
    "size-sm": "12px",
    "size-md": "13px",
    "size-lg": "15px",
    "size-xl": "18px",
    "line": "1.4",
    "weight-regular": "400",
    "weight-medium": "500",
    "weight-bold": "600"
  },
  "space": {
    "1": "2px",
    "2": "4px",
    "3": "8px",
    "4": "12px",
    "5": "16px",
    "6": "24px",
    "7": "32px"
  },
  "size": {
    "row": "32px",
    "row-compact": "28px",
    "row-phone": "44px",
    "control": "28px",
    "hit-phone": "44px",
    "focus-ring": "2px",
    "icon": "16px",
    "icon-sm": "14px",
    "badge": "20px",
    "chip": "24px",
    "fill": "160px",
    "search": "220px",
    "list": "320px",
    "total": "120px",
    "clock": "64px",
    "label": "160px",
    "input": "120px"
  },
  "radius": {
    "sm": "3px",
    "md": "4px",
    "lg": "6px",
    "pill": "999px"
  },
  "elevation": {
    "popover": "0 4px 16px rgba(0,0,0,.14)",
    "pill": "0 2px 6px rgba(0,0,0,.18)"
  },
  "motion": {
    "fast": "150ms",
    "highlight": "1200ms",
    "ease": "cubic-bezier(.2,0,0,1)"
  },
