{
  "name": "fleet",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run typecheck && node packages/coordinator/build.mjs && node packages/coordinator/package-assets.mjs && node app/build.mjs",
    "start": "node dist/packages/coordinator/server.js",
    "test": "node --test tests/coordinator/*.test.ts tests/ui/*.test.ts",
    "book": "node packages/ui/scripts/build-book.mjs",
    "check:design": "node packages/ui/scripts/check-design.mjs",
    "app:build": "node app/build.mjs",
    "app:dev": "node --watch-path=app/src --watch-path=packages/ui --watch-path=packages/view-url app/build.mjs",
    "check:filter": "pnpm run build && node tests/ui/filter.check.ts --assert",
    "typecheck": "tsc && tsc -p app && tsc -p packages/ui"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@clickhouse/client": "1.25.0",
    "@fastify/static": "8.3.0",
    "@preact/signals": "2.11.4",
    "@tanstack/virtual-core": "3.19.11",
    "better-sqlite3": "12.4.1",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "preact": "11.2.0",
    "wouter-preact": "3.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.0",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "playwright": "1.56.1",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.18"
  }
}
