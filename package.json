{
  "name": "fleet",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run app:build && pnpm run go:build",
    "start": "go/bin/fleet-coordinator",
    "check": "scripts/check.sh",
    "test": "scripts/check.sh",
    "book": "node packages/ui/scripts/build-book.mjs",
    "board:tokens": "node packages/ui/scripts/board-tokens.mjs",
    "check:design": "node packages/ui/scripts/build-book.mjs; node packages/ui/scripts/check-design.mjs",
    "app:build": "pnpm run typecheck && node app/build.mjs",
    "app:bundle": "node contracts/gen-ts.mjs && node app/build.mjs",
    "app:dev": "node --watch-path=app/src --watch-path=packages/ui --watch-path=packages/view-url app/build.mjs",
    "contracts": "node contracts/gen-ts.mjs",
    "typecheck": "node contracts/gen-ts.mjs && tsc && tsc -p app && tsc -p packages/ui",
    "go:sqlc": "cd go && GOFLAGS=-mod=readonly go tool sqlc generate -f coordinator/sqlc.yaml",
    "go:build": "cd go && for c in coordinator executor gateway update; do CGO_ENABLED=0 go build -trimpath -o bin/fleet-$c ./$c || exit 1; done"
  },
  "dependencies": {
    "@sentry/browser": "11.10.0",
    "@solidjs/web": "^2.0.3",
    "@tanstack/virtual-core": "3.19.11",
    "@ui-sdk/core": "0.1.0-beta.16",
    "@ui-sdk/solid": "0.1.0-beta.16",
    "solid-js": "^2.0.3"
  },
  "devDependencies": {
    "@solidjs/compiler": "^2.0.2",
    "@types/node": "22.18.0",
    "esbuild": "0.28.2",
    "modern-web-guidance": "1.0.1",
    "playwright": "1.56.1",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.18"
  }
}
