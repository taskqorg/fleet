              d1d00bec2f10148e t("608 ms",JetBrains Mono,11,r,align(l),lh(1.4)) p(318.39,6) s(hug:39.61,hug:15.4) f[(4113e1d781b27ede,#77777C)] "Text 324"
    cc6cd7393c3032b9 al(v,g(8)) p(1314,0) s(440,hug:413) f[] "Frame 366"
      08d84e00d8c24c85 t("What changes",Inter,15,sb,align(l),lh(1.4)) p(0,0) s(fill,hug:21) ext(440,) f[(8d9320f6ed5bed34,#ECECEC)] "Text 325"
      6ac8ec04e83186d2 t("• Results: only real outputs. Images and video inline, files as chips. Derived previews are not rows; links the text already gave are not repeated.",Inter,12,r,align(l),lh(1.4)) p(0,29) s(420,hug:50.4) f[(b51eb13df973369b,#9A9A9F)] "Text 326"
      2445e4d61760c0c6 t("• MCP receipts get role diagnostic: never in the thread or Results, deleted after 7 days. A failed MCP start shows as a failed chip.",Inter,12,r,align(l),lh(1.4)) p(0,87.4) s(420,hug:33.6) f[(ac5007e88619bef1,#9A9A9F)] "Text 327"
      ab13b4a0a16908ab t("• Bot Home: one session per bot, inside it one thread per work item (task, question, PR, topic, or a person's request). Done threads park; a new event on the item resumes its thread.",Inter,12,r,align(l),lh(1.4)) p(0,129) s(420,hug:50.4) f[(da0cd46c8fc6ac6d,#9A9A9F)] "Text 328"
      7327c9b556fe4fc6 t("• Timer ticks with no change run no agent turn: they fold into the Every 5m row. A tick with changes routes to the thread of that item.",Inter,12,r,align(l),lh(1.4)) p(0,187.4) s(420,hug:33.6) f[(6fdc974e4a1a2afb,#9A9A9F)] "Text 329"
      481b79808c88c844 t("• The bot is pinned to one host, so its native thread is no longer reset on every turn.",Inter,12,r,align(l),lh(1.4)) p(0,229) s(420,hug:33.6) f[(29b7ae0991591053,#9A9A9F)] "Text 330"
      d86fde284b8b7652 t("• Tool chips by kind (Shell, Files, Fleet, Results, Web, Context) with count, failures and time. A chip opens its calls with readable targets (codes and names, not UUIDs or host paths); a call opens its input and output, loaded on open.",Inter,12,r,align(l),lh(1.4)) p(0,270.6) s(420,hug:67.2) f[(df079025128d86a8,#9A9A9F)] "Text 331"
      56876e1d27b6b3d5 t("• Data, no visual change: session_get becomes a light head plus paged executions (with the data-layer session); the head state follows the live run; trigger_list is read once per change; artifact_save accepts paths under output/.",Inter,12,r,align(l),lh(1.4)) p(0,345.8) s(420,hug:67.2) f[(bc88e1f336cae07e,#9A9A9F)] "Text 332"
bp:end
