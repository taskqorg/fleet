      1247735126ff8d0c t("Composer commands (one server parser over triggers)",Inter,15,sb,align(l),lh(auto,1.2)) p(16,16) s(fill,hug:18) ext(528,) f[(a98f153816787dd5,#ECECEC)] "Text 87"
      f988d021ab29adb5 t("Built on fleet-triggers.md: trigger_list, trigger_save with baseRevision. Text is the trigger text field.",Inter,12,r,align(l),lh(auto,1.25)) p(16,42) s(528,hug:30) f[(4564dcfd2d286a7b,#9A9A9F)] "Text 88"
      fc53022d9d417e57 t("/trigger conversation-check every 5m if changed: <text> edit; parts optional (every 10m alone keeps the text)",Inter,12,r,align(l),lh(auto,1.25)) p(16,80) s(528,hug:30) f[(a11626c04025f6dd,#9A9A9F)] "Text 89"
      6ae06c91c420655b t("/trigger <name> pause · resume · run · delete /trigger new <preset>: <text>",Inter,12,r,align(l),lh(auto,1.25)) p(16,118) s(528,hug:15) f[(0b24c6d870810a8d,#9A9A9F)] "Text 90"
      149937a2665fd3ba t("if changed = ifChanged kinds (task, question, execution); always = fire on time with no check.",Inter,12,r,align(l),lh(auto,1.25)) p(16,141) s(528,hug:30) f[(f709f00c43e0ab99,#9A9A9F)] "Text 91"
      c28a29165181e22a t("session_command {sessionId, text, apply:false} answers a preview; apply:true runs trigger_save with the preview revision; 409 when it moved. Agents call the same op.",Inter,12,r,align(l),lh(auto,1.25)) p(16,179) s(528,hug:30) f[(e76ec56cca2caead,#9A9A9F)] "Text 92"
      6da9118272aff787 t("Text not starting with a known /command is an ordinary message.",Inter,12,r,align(l),lh(auto,1.25)) p(16,217) s(528,hug:15) f[(e1b7540c962e1bc3,#9A9A9F)] "Text 93"
    0c86ea0fea8f4587 al(v,g(8),pad(16)) p(584,0) s(560,hug:172) f[(1dc38edd4fdbf80b,#121213)] st[(1e6e19e1835fbc3f,#2A2A2D,w(1))] "Frame 135"
      09e1c06f0b74dba3 t("Visibility rules",Inter,15,sb,align(l),lh(auto,1.2)) p(16,16) s(fill,hug:18) ext(528,) f[(fc40a15210ad30fa,#ECECEC)] "Text 94"
      0a77642324c9c67f t("A trigger that exists is always visible: a chip in the session head and a row in the context panel.",Inter,12,r,align(l),lh(auto,1.25)) p(16,42) s(528,hug:30) f[(31e834e8ba3a7ae8,#9A9A9F)] "Text 95"
      f7863c8f4d83a3bc t("Live age: next check in 3m ticks (shared live-age control, OR-2). Paused: muted pause icon, no age.",Inter,12,r,align(l),lh(auto,1.25)) p(16,80) s(528,hug:30) f[(99dc9422a516c7f0,#9A9A9F)] "Text 96"
      599bdb524330b954 t("Quiet checks (no change, no model call) show as 12 quiet checks since 14:05.",Inter,12,r,align(l),lh(auto,1.25)) p(16,118) s(528,hug:15) f[(a4320e87cca15ee3,#9A9A9F)] "Text 97"
      ec6114b1755ea127 t("Edit never opens a form: it fills the composer with the current command and focuses it.",Inter,12,r,align(l),lh(auto,1.25)) p(16,141) s(528,hug:15) f[(17886ac08c77e523,#9A9A9F)] "Text 98"
