        9ab7eaeadb2d2425 t("· Heading row: bot icon, “Bots”, ›. Click opens Library › Bots (all bots). Tooltip “All bots”.",Inter,16,r,align(l),lh(auto,1.19)) p(0,0) s(fill,hug:28.5) ext(420,) f[(32c8e147aec7273f,tok(color.text.primary,#161617))] "Text 50"
          spans[(0,94,s(12),#9A9A9F)]
        74c49890cfbf2370 t("· Pinned bots first, in pin order. Pins are the Library pins (bot:<id>): pin a bot there or right-click a zone row.",Inter,16,r,align(l),lh(auto,1.19)) p(0,34.5) s(fill,hug:28.5) ext(420,) f[(b1e463b1ea5b072a,tok(color.text.primary,#161617))] "Text 51"
          spans[(0,115,s(12),#9A9A9F)]
        2bae57d6a0d10e38 t("· Then recent bots not pinned: working and waiting first, then by last run, up to the person’s count.",Inter,16,r,align(l),lh(auto,1.19)) p(0,69) s(fill,hug:28.5) ext(420,) f[(600aa898c35d32b3,tok(color.text.primary,#161617))] "Text 52"
          spans[(0,101,s(12),#9A9A9F)]
        20126b303ab9be9f t("· Default count: 0 recent, so the zone = pinned + bots active right now (they leave when they finish).",Inter,16,r,align(l),lh(auto,1.19)) p(0,103.5) s(fill,hug:28.5) ext(420,) f[(b4f8f5d804bca6eb,tok(color.text.primary,#161617))] "Text 53"
          spans[(0,102,s(12),#9A9A9F)]
        57eac7987b125090 t("· Each row: bot mark with state dot (running, waiting, failed, stopped; asleep has no dot), name, right: run age 4m / “asks” / last run 2h.",Inter,16,r,align(l),lh(auto,1.19)) p(0,138) s(fill,hug:28.5) ext(420,) f[(4827238191d28319,tok(color.text.primary,#161617))] "Text 54"
          spans[(0,139,s(12),#9A9A9F)]
        9b62c1de3bf9ddb8 t("· Click opens the bot’s Home conversation. Right-click: Pin/Unpin, Open in Library.",Inter,16,r,align(l),lh(auto,1.19)) p(0,172.5) s(fill,hug:28.5) ext(420,) f[(4171f2f6bf2a5b6f,tok(color.text.primary,#161617))] "Text 55"
          spans[(0,83,s(12),#9A9A9F)]
        f4fee3fa3c4dbd32 t("· No bots pinned and none active: heading row only (still the way to all bots).",Inter,16,r,align(l),lh(auto,1.19)) p(0,207) s(fill,hug:28.5) ext(420,) f[(5af0d0454a85b329,tok(color.text.primary,#161617))] "Text 56"
