    d66d948212e83305 t("· Settings live on the server per person (railBots in person_settings), restored on every device; agents set them with person_settings_set (R7).",Inter,16,r,align(l),lh(auto,1.19)) p(0,40.5) s(fill,hug:14.25) ext(1200,) f[(6c6c731d4bd7af59,tok(color.text.primary,#161617))] "Text 133"
      spans[(0,144,s(12),#9A9A9F)]
    9ddb676358b152bf t("· No limit invented: the recent count is the person’s; a zone longer than the free space scrolls inside its own area, the rail itself never scrolls (OR-25).",Inter,16,r,align(l),lh(auto,1.19)) p(0,60.75) s(fill,hug:14.25) ext(1200,) f[(231c891e85029da4,tok(color.text.primary,#161617))] "Text 134"
