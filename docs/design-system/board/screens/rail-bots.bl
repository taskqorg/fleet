    9226a57ace53d5fd t("· Off by default. Toggling adds or removes the zone at the bottom; no section row or icon moves, on the toggle or on bot activity.",Inter,16,r,align(l),lh(auto,1.19)) p(0,0) s(fill,hug:14.25) ext(1200,) f[(706f4c1104a3399e,tok(color.text.primary,#161617))] "Text 131"
