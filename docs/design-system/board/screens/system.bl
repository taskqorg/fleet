      93627a937d54fc0b t("4 · Credits, and the same for agents",Inter,15,sb,align(l),lh(auto,1.2)) p(16,16) s(fill,hug:18) ext(508,) f[(4182e00e031337c4,#ECECEC)] "Text 196"
      b40a36924a3cd0b6 t("Credits or balance: read when the provider allows it with that key (Meshy, Tavily, Google tier). Otherwise the owner types the monthly limit ($200) and Fleet counts calls against it.",Inter,12,r,align(l),lh(auto,1.25)) p(16,44) s(fill,hug:30) ext(508,) f[(cf57ea4781b52442,#ECECEC)] "Text 197"
      30adb721ba01d275 t("Agents first (R7): ops access_status, access_check, access_onboard. An agent may ask for a key or a login; the owner gets it under Needs you with this same card.",Inter,12,r,align(l),lh(auto,1.25)) p(16,84) s(fill,hug:30) ext(508,) f[(55cffd3e18306fb4,#ECECEC)] "Text 198"
        spans[(23,36,f(JetBrains Mono)),(38,50,f(JetBrains Mono)),(52,66,f(JetBrains Mono))]
      221f8bd588a62ccc t("Every check is read-only. A login never starts from a check (no surprise browser pages).",Inter,12,r,align(l),lh(auto,1.25)) p(16,124) s(fill,hug:15) ext(508,) f[(70e54cfa6448cdd1,#ECECEC)] "Text 199"
