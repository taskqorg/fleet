        eaae9a757bb97af8 t("· Heading row: bot icon, “Bots”, ›. Click opens Library › Bots (all bots). Tooltip “All bots”.",Inter,16,r,align(l),lh(auto,1.19)) p(0,0) s(fill,hug:28.5) ext(420,) f[(cc0832a8979ac971,tok(color.text.primary,#161617))] "Text 311"
          spans[(0,94,s(12),#9A9A9F)]
        32c5d80dc486c414 t("· Pinned bots first, in pin order. Pins are the Library pins (bot:<id>): pin a bot there or right-click a zone row.",Inter,16,r,align(l),lh(auto,1.19)) p(0,34.5) s(fill,hug:28.5) ext(420,) f[(86fdd887d4ab8d76,tok(color.text.primary,#161617))] "Text 312"
          spans[(0,115,s(12),#9A9A9F)]
        80c135a19c124f15 t("· Then recent bots not pinned: working and waiting first, then by last run, up to the person’s count.",Inter,16,r,align(l),lh(auto,1.19)) p(0,69) s(fill,hug:28.5) ext(420,) f[(26bf92c8a5efd706,tok(color.text.primary,#161617))] "Text 313"
          spans[(0,101,s(12),#9A9A9F)]
        eed4183064af6523 t("· Default count: 0 recent, so the zone = pinned + bots active right now (they leave when they finish).",Inter,16,r,align(l),lh(auto,1.19)) p(0,103.5) s(fill,hug:28.5) ext(420,) f[(c2f8222f6a57f1b5,tok(color.text.primary,#161617))] "Text 314"
          spans[(0,102,s(12),#9A9A9F)]
        6626fae865906c04 t("· Each row: bot mark with state dot (running, waiting, failed, stopped; asleep has no dot), name, right: run age 4m / “asks” / last run 2h.",Inter,16,r,align(l),lh(auto,1.19)) p(0,138) s(fill,hug:28.5) ext(420,) f[(f99d30ce0f7ccd20,tok(color.text.primary,#161617))] "Text 315"
          spans[(0,139,s(12),#9A9A9F)]
        07bd94dd0fcdf778 t("· Click opens the bot’s Home conversation. Right-click: Pin/Unpin, Open in Library.",Inter,16,r,align(l),lh(auto,1.19)) p(0,172.5) s(fill,hug:28.5) ext(420,) f[(af8ab006d24ab02c,tok(color.text.primary,#161617))] "Text 316"
          spans[(0,83,s(12),#9A9A9F)]
        32cc6d30d4e42b35 t("· No bots pinned and none active: heading row only (still the way to all bots).",Inter,16,r,align(l),lh(auto,1.19)) p(0,207) s(fill,hug:28.5) ext(420,) f[(34bec48b2b5078ea,tok(color.text.primary,#161617))] "Text 317"
