  c42d4bf19929b0ce al(v,g(12:$spacing.lg)) p(32,1541) s(hug:1180,hug:205) f[] "Rules"
    3afa5ef138b69009 t("RULES",Inter:$font.family,11:$font.size.xs,sb,align(l),lh(auto,1.18)) p(0,0) s(hug:35.31,hug:13) f[(ff8c17b62b738b18,tok(fleet.fg-muted,#9A9A9F))] "Text 255"
    eb6971324b6f8e60 t("· Avatar: the person's initial on the selected surface, fg letter. Same in every state, theme and width. No dot.",Inter:$font.family,12:$font.size.sm,r,align(l),lh(auto,1.25)) p(0,25) s(1180,hug:15) f[(bcbfe355c313f443,tok(fleet.fg-muted,#9A9A9F))] "Text 256"
    ce1128da4d284076 t("· Version mark: the Fleet release (coordinator) in mono. Its slot is reserved from the first paint: no \"…\" then a number.",Inter:$font.family,12:$font.size.sm,r,align(l),lh(auto,1.25)) p(0,52) s(1180,hug:15) f[(c0352a4d17bd676f,tok(fleet.fg-muted,#9A9A9F))] "Text 257"
    c530b01afffe0287 t("· Toned only by a confirmed problem that is true now: danger for a host update failed, host polls failing with its problem open, gateway unreachable on a probe and its immediate re-probe; attention for a host behind with auto-update off or held. An icon carries the tone too (not colour alone).",Inter:$font.family,12:$font.size.sm,r,align(l),lh(auto,1.25)) p(0,79) s(1180,hug:30) f[(4adb31ce0812277c,tok(fleet.fg-muted,#9A9A9F))] "Text 258"
    39362d5815371e61 t("· Never toned: this tab not yet checked, a probe not yet repeated, a failed or late versions read (the overview says \"could not check\" with the last check), a host offline (System counts it), a host updating.",Inter:$font.family,12:$font.size.sm,r,align(l),lh(auto,1.25)) p(0,121) s(1180,hug:15) f[(7821db0aa02d5689,tok(fleet.fg-muted,#9A9A9F))] "Text 259"
    d069d232fe9c5c80 t("· Update: offered when the site serves a different app than this tab (hashed assets), naming the new version. One click reloads into it. It shows Reloading until the page unloads. A failure says why in place, with Retry; the tab keeps working.",Inter:$font.family,12:$font.size.sm,r,align(l),lh(auto,1.25)) p(0,148) s(1180,hug:30) f[(2baec1dca18361fd,tok(fleet.fg-muted,#9A9A9F))] "Text 260"
    1ef04fa3dd948772 t("· The overview stays open while values update in place; problem rows link to the host. Agents read the same facts: system_versions.",Inter:$font.family,12:$font.size.sm,r,align(l),lh(auto,1.25)) p(0,190) s(1180,hug:15) f[(526c90c166688907,tok(fleet.fg-muted,#9A9A9F))] "Text 261"
8e0d8438e7bfef5e al(v,g(32:$spacing.3xl),pad(32:$spacing.3xl)) ds(, theme(dark)) p(3700,0) s(hug:1260,hug:1120) f[(bdb127889a85e463,tok(fleet.bg,#0B0B0C))] "Shell · app update installs itself when idle (approved 25 Nov)"
  d6569b78587cd8e9 t("App update · installs itself when idle (approved 25 Nov)",Inter:$font.family,22:$font.size.2xl,sb:$font.weight.bold,align(l),lh(auto,1.23)) p(32,32) s(hug:586.07,hug:27) f[(b0917ac5b362ea66,tok(fleet.fg,#ECECEC))] "Text 397"
  519a20aec3cde3bb t("Owner: the strip needs a click many times a day. Target: when a new app is ready, the strip counts down 30 s of no activity and then reloads by itself. Any pointer move, key, scroll, touch or focus change resets it to 30. A hidden tab counts as idle, so it updates in the background. One click still updates at once. Never loses work: the count holds while a composer, field or form has unsaved input, a dialog is open, or a save is in flight (chosen over restoring drafts after the reload: holding cannot lose what a page did not save, and a restored draft can come back to a changed page). The reload keeps the route and the scroll position.",Inter:$font.family,12:$font.size.sm,r:$font.weight.regular,align(l),lh(auto,1.25)) p(32,91) s(1180,hug:60) f[(ff1f6a2b870b156e,tok(fleet.fg-muted,#9A9A9F))] "Text 398"
  b91affc90621273d al(v,g(12:$spacing.lg)) p(32,183) s(hug:1196,hug:207) f[] "Expanded rail"
