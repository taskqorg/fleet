  670c0b0b4628f5d5 al(v,g(4:$spacing.sm)) p(32,980) s(1180,hug:108) f[] "Rules"
    2459ab139ba75706 t("RULES",Inter:$font.family,11:$font.size.xs,sb:$font.weight.bold,align(l),lh(auto,1.18)) p(0,0) s(hug:35.31,hug:13) f[(e2ab05049a9ebc43,tok(fleet.fg-muted,#9A9A9F))] "Text 477"
    c79e300fee9a4ba0 t("· Idle means no pointer move, key, scroll, touch or focus change for 30 s. The tab reads them with passive listeners into one timestamp; one timer counts. A hidden tab is idle.",Inter:$font.family,12:$font.size.sm,r:$font.weight.regular,align(l),lh(auto,1.25)) p(0,17) s(fill,hug:15) ext(1180,) f[(46807dff74f3adf0,tok(fleet.fg-muted,#9A9A9F))] "Text 478"
    350e17be41f4ff5d t("· The strip shows the seconds left and a thin bar that empties; activity puts both back to 30. Update now (or the collapsed button) reloads at once.",Inter:$font.family,12:$font.size.sm,r:$font.weight.regular,align(l),lh(auto,1.25)) p(0,36) s(fill,hug:15) ext(1180,) f[(3c809efd94193748,tok(fleet.fg-muted,#9A9A9F))] "Text 479"
    7a887fd892ddb9d7 t("· Held, never lost: unsaved input in a composer, field or form, an open dialog, or a save in flight holds the count; the strip says which. Update now still works on purpose.",Inter:$font.family,12:$font.size.sm,r:$font.weight.regular,align(l),lh(auto,1.25)) p(0,55) s(fill,hug:15) ext(1180,) f[(cfbc51220386b640,tok(fleet.fg-muted,#9A9A9F))] "Text 480"
    7732c0b8b5bf5d62 t("· At 0 the tab reloads onto the new app, on the same route and scroll position. Reloading stays until the page unloads; a failure says why with Retry, and the next check starts the count again.",Inter:$font.family,12:$font.size.sm,r:$font.weight.regular,align(l),lh(auto,1.25)) p(0,74) s(fill,hug:15) ext(1180,) f[(a5edb7fb39cbd0c6,tok(fleet.fg-muted,#9A9A9F))] "Text 481"
    ee015258173203c0 t("· Unchanged: offered when the site serves a different app than the tab; the avatar never changes; only a confirmed problem tones the version.",Inter:$font.family,12:$font.size.sm,r:$font.weight.regular,align(l),lh(auto,1.25)) p(0,93) s(fill,hug:15) ext(1180,) f[(a7eef812532376c6,tok(fleet.fg-muted,#9A9A9F))] "Text 482"
7698eedb8527ce03 al(v,g(24),pad(32)) p(3800,0) s(1800,hug:2186.85) f[(cfe85946ef5772ac,#0B0B0C)] "Shell · rail Pinned zone (approved)"
  6d2f13f58d286ce7 t("Rail · Pinned zone replaces the bots zone (approved 26 Nov, as drawn)",Inter,22,sb,align(l),lh(auto,1.23)) p(32,32) s(fill,hug:27) ext(1736,) f[(73e45e1a46d8ddb3,#ECECEC)] "Text 483"
  bc8bfd8016816958 t("One pin per object, everywhere. Pin a conversation (any: bot line, PM, Telegram, a worker) or a bot from the object: the pin button in its head, or Pin in the row menu (right-click, long-press, or the keyboard menu key). No pin on row hover: rows carry no hover buttons (OR-37, owner 26 Nov, no exceptions). The same pin puts it on top of its list (Pinned group, as today) and into the Pinned zone of the navigation. The zone replaces the bots zone: no automatic active or recent bots, only what the person pinned, in pin order. Row: mark (bot avatar with its state, or the conversation's mark with a state dot), title, then asks / unread count / age. Click opens it; right-click: Unpin, Open. The user menu shows or hides the zone (the existing switch). Pins live in person settings on the server (keyed by session id and bot id), so they follow across devices; agents read and set them with person_settings_get / person_settings_set rowPin. Existing Library bot pins carry over as they are. Later: tasks and projects use the same pin.",Inter,16,r,align(l),lh(auto,1.19)) p(32,83) s(1500,hug:80.75) f[(aa7c42b9be1c3071,tok(color.text.primary,#161617))] "Text 484"
    spans[(0,936,s(12),#9A9A9F)]
  4417fa92f8098c95 t("RAIL 1440 · EXPANDED, COLLAPSED, MENUS, EMPTY",Inter,11,sb,align(l),lh(auto,1.18),ls(0.5px)) p(32,187.75) s(fill,hug:13) ext(1736,) f[(4e75af493490ce7d,#9A9A9F)] "Text 485"
