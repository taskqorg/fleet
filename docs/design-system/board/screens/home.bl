  56d2f2cb5234214a t("Home cards · work facts, quiet form B",Inter:$font.family,22:$font.size.2xl,sb,align(l),lh(auto,1.23)) p(32,32) s(hug:399.99,hug:27) f[(57d2a2f2f6063af8,tok(fleet.fg,#ECECEC))] "title"
  accbd36ef2b56c10 t("A card shows one session at a glance, so only the facts that change what you do next: how long it waits for you, how long it is in work, how many attempts when there were several, and a failing start's count. The agent is already the avatar and the name, so no agent mark on Home. Long waits and runs stand out against the cards of the same group. The facts sit at the right end of the meta line, the time last, so it lines up at the card's right edge. Time is always the rightmost fact (owner, 25 Nov): ×N, then the agent mark, then the time, so times line up in one column down the list. ",Inter:$font.family,13:$font.size.md,r,align(l),lh(auto,1.23)) p(32,83) s(1240,hug:48) f[(855569a0b338f340,tok(fleet.fg-muted,#9A9A9F))] "note"
