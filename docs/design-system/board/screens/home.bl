            3c41c74f27e2160f t("Finished: Home canvas in 4 states.",Inter,13,r,align(l),lh(1.5)) p(16,63) s(fill,hug:19.5) ext(268,) f[(e6df9b78c86a0636,#ECECEC)] "Text 365"
            e161796ab6ddcd6a t("done 2m ago · stays 1h, then leaves Home",Inter,12,r,align(l),lh(auto,1.25)) p(16,92.5) s(fill,hug:15) ext(268,) f[(d2c0953ce79fe9fe,#77777C)] "Text 366"
        58852afc4bab6f25 al(v,g(8)) p(0,223.36) s(1500,hug:152.9) f[] "Frame 557"
          c137ee06f09a63ad t("Order on Home: Waiting for you (oldest first) → Failed → Working (most recent activity first) → Queued → Asleep. Done cards stay one hour, then leave Home (they remain in Conversations).",Inter,13,r,align(l),lh(1.55)) p(0,0) s(fill,hug:20.15) ext(1500,) f[(c09084270badd917,#B4B9C1)] "Text 367"
            spans[(0,14,b,#E6E8EB)]
          593569b116cef9bb t("Card anatomy: avatar (bot or PM, project colour) · name · project chip · state word with dot (NR-6) · one line of what it does now · thin progress when there is a plan · one meta line (step, elapsed, host, timer) · at most one question with buttons (NR-4). Whole card opens the session (OR-26); buttons act in place.",Inter,13,r,align(l),lh(1.55)) p(0,28.15) s(fill,hug:40.3) ext(1500,) f[(a090e86152ca841c,#B4B9C1)] "Text 368"
            spans[(0,13,b,#E6E8EB)]
          2ca28eb234cceb00 t("Never on a card: model, tokens, cost, ids, tool output (NR-5). They are in the session's Details.",Inter,13,r,align(l),lh(1.55)) p(0,76.45) s(fill,hug:20.15) ext(1500,) f[(71f87883a4d1c208,#B4B9C1)] "Text 369"
            spans[(0,16,b,#E6E8EB)]
          c363bc3f2283081f t("Asleep bots: dashed outline, what they are for, when last used, Wake. Wake opens the session with its memory; typing in the composer to an asleep bot wakes it too.",Inter,13,r,align(l),lh(1.55)) p(0,104.6) s(fill,hug:20.15) ext(1500,) f[(9389c463969d384b,#B4B9C1)] "Text 370"
            spans[(0,12,b,#E6E8EB)]
          51e6683df99bb7c9 t("Composer: picks who to talk to (project PMs, bots, new session with preset); Enter sends and opens that session. Same picker as Telegram /pm and @bot.",Inter,13,r,align(l),lh(1.55)) p(0,132.75) s(fill,hug:20.15) ext(1500,) f[(c67b2234af813bad,#B4B9C1)] "Text 371"
            spans[(0,9,b,#E6E8EB)]
bp:end
