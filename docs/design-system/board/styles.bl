    9ad020e217d25b92 t("Font: the product renders system-ui (SF Pro on macOS); the board draws Inter, the closest bundled face. Widths differ by a few percent, so a board-versus-prod check compares layout, spacing and colour, not glyph widths.",Inter:$font.family,13:$font.size.md,r,align(l),lh(auto,1.23)) p(12,12) s(fill,hug:32) ext(1112,) f[(e7e2c1caa73ed8fb,tok(fleet.fg,#ECECEC))] "Text 169"
