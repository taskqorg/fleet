        68d318bc47238fe1 t("Questions are actions",Inter,15,sb,align(l),lh(auto,1.2)) p(86,12) s(240,hug:18) f[(608afe623d8f4681,#E6E8EB)] "Text 58"
        40d89a5dae20fac9 t("A question from an agent is a card with its choices as buttons plus free text. Its answer edits the card in place. The same question shows on the session card on Home.",Inter,14,r,align(l),lh(1.5)) p(342,12) s(fill,hug:21) ext(1230,) f[(52a7285a578590df,#B4B9C1)] "Text 59"
