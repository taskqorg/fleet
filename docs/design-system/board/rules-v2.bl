        f2c280b941161453 t("Quiet by default",Inter,15,sb,align(l),lh(auto,1.2)) p(86,12) s(240,hug:18) f[(6dd0b5bea4405749,#E6E8EB)] "Text 62"
        c4500bdbc9336955 t("No metrics header, no model badge per message, no cost on every row. Model, tokens, cost, CPU, ids live under Details.",Inter,14,r,align(l),lh(1.5)) p(342,12) s(fill,hug:21) ext(1230,) f[(a3de88799dec1ae2,#B4B9C1)] "Text 63"
