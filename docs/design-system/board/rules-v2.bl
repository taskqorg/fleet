        eef9153919fac68e t("Tools fold into one line",Inter,15,sb,align(l),lh(auto,1.2)) p(86,12) s(240,hug:18) f[(bd677ca047eaa064,#E6E8EB)] "Text 54"
        0d6cd8da335edc0a t("Consecutive tool calls and system events become one quiet line (\"Checked hosts and running work · 3s\"), expanded on click. Repeated attachments and heartbeats never show.",Inter,14,r,align(l),lh(1.5)) p(342,12) s(fill,hug:21) ext(1230,) f[(56cac43d162c3d62,#B4B9C1)] "Text 55"
