        791828b2546a4fca t("Home is sessions",Inter,15,sb,align(l),lh(auto,1.2)) p(86,12) s(240,hug:18) f[(0e941ec113bc6ff5,#E6E8EB)] "Text 46"
        fc7a0633120dad11 t("The first screen lists active sessions as cards (what it does now in one line, its questions with answer buttons), then asleep bots with Wake, a composer that picks who to talk to, and one pulse line (working · queued · done · blockers).",Inter,14,r,align(l),lh(1.5)) p(342,12) s(fill,hug:42) ext(1230,) f[(1ede4990b39b9be2,#B4B9C1)] "Text 47"
