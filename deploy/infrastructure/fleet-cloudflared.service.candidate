# Fleet store tunnel on PDS18 (tight D8). Remote-managed tunnel fleet-store-pds18, ingress
# fleet-store-pds18.ufobe.com -> http://127.0.0.1:9490 (Garage S3), behind Cloudflare Access app "Fleet store pds18".
# Host-only token file (0600): /home/fleet/.config/fleet/cloudflared/fleet-store-pds18.token
[Unit]
Description=Fleet store Cloudflare Tunnel (fleet-store-pds18.ufobe.com)
After=network-online.target fleet-garage.service
Wants=fleet-garage.service

[Service]
ExecStart=/home/fleet/runtime/cloudflared tunnel --no-autoupdate run --token-file /home/fleet/.config/fleet/cloudflared/fleet-store-pds18.token
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
