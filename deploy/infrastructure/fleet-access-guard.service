# Cloudflare Access origin verifier for Caddy's forward_auth (fleet.caddy.candidate), a user unit of fleet:
# `fleet-gateway guard` from the current release. access-guard.env holds FLEET_BROWSER_SECRET only.
[Unit]
Description=Fleet Cloudflare Access origin verifier
[Service]
EnvironmentFile=/home/fleet/.config/fleet/access-guard.env
ExecStart=/home/fleet/releases/current/fleet-gateway guard 127.0.0.1:9471
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=default.target
