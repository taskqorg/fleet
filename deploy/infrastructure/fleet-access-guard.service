[Unit]
Description=Fleet Cloudflare Access origin verifier
[Service]
WorkingDirectory=/home/fleet/runtime/access-guard
EnvironmentFile=/home/fleet/.config/fleet/access-guard.env
ExecStart=/home/fleet/runtime/guard-venv/bin/python -m uvicorn origin_guard:app --host 127.0.0.1 --port 9471 --no-access-log --limit-concurrency 32
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=default.target
