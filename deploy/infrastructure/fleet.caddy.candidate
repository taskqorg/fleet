# Fleet browser credential and X-Fleet-Person are injected only after Access JWT verification; client copies are stripped.
fleet.ufobe.com {
    tls internal
    request_header -X-Dashq-Subject
    request_header -X-Fleet-Person
    route {
        @machine {
            method POST
            path /api/hosts/*
        }
        handle @machine {
            reverse_proxy 127.0.0.1:9470
        }
        # API calls from remote hosts (fleet-connections.md §3): Access app "Fleet gateway" (fleet.ufobe.com/v1/call) admits only
        # the fleet-machines service token; the gateway checks the run token.
        @gateway {
            method POST
            path /v1/call/*
        }
        handle @gateway {
            reverse_proxy 127.0.0.1:8742
        }
        request_header -Authorization
        # fleet-access-guard.service: `fleet-gateway guard` checks the Access JWT and adds the Bearer and X-Fleet-Person.
        forward_auth 127.0.0.1:9471 {
            uri /verify
            copy_headers Authorization X-Fleet-Person
            header_up -Upgrade
            header_up -Connection
        }
        reverse_proxy 127.0.0.1:9470
    }
}
