[Unit]
Description=Fleet coordinator
After=network.target
[Service]
WorkingDirectory=/home/fleet/releases/current
EnvironmentFile=/home/fleet/.config/fleet/coordinator.env
Environment=FLEET_UI_ROOT=/home/fleet/ui
ExecStart=/home/fleet/releases/current/fleet-coordinator
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=default.target
