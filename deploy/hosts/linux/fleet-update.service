# fleet-update on a Linux or WSL executor host (docs/designs/fleet-self-update.md §3.5), a user unit of the executor
# service user. Install: copy this file and fleet-update.timer to ~/.config/systemd/user/, then
#   systemctl --user daemon-reload && systemctl --user enable --now fleet-update.timer
[Unit]
Description=Fleet self-update (executor)
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/fleet/executor.env
ExecStart=%h/releases/current/fleet-update executor
