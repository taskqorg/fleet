[Unit]
Description=Fleet coordinator prototype
After=network.target
[Service]
User=fleet
Group=fleet
WorkingDirectory=/opt/fleet/current
EnvironmentFile=/etc/fleet/coordinator.env
ExecStart=/home/fleet/node/bin/node /opt/fleet/current/dist/packages/coordinator/server.js
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/fleet
PrivateTmp=true
[Install]
WantedBy=multi-user.target
