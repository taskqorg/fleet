[Unit]
Description=Private Fleet designer capture worker inside the isolated VM

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I -B /opt/fleet-design-verifier/current/deploy/design-verifier/vm-capture-guest.py
TimeoutStartSec=595s
TimeoutStopSec=5s
KillMode=control-group
UMask=0077
Environment=PATH=/usr/bin:/bin HOME=/nonexistent LANG=C
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/fleet-design-capture-job/job/results
TemporaryFileSystem=/tmp:size=256M,mode=0700,nosuid,nodev,noexec
InaccessiblePaths=/var/tmp
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_SETUID CAP_SETGID
MemoryAccounting=yes
MemoryMax=1152M
MemorySwapMax=0
CPUQuota=200%
TasksMax=128
LimitCORE=0
