[Unit]
Description=Protected fixed Fleet design renderer VM broker
RequiresMountsFor=/var/lib/fleet-render-vm /opt/fleet-render-vm

[Service]
Type=simple
User=fleet-render-vm
Group=fleet-render-vm
SupplementaryGroups=kvm
EnvironmentFile=/etc/fleet-render-vm/image.env
Environment=PATH=/usr/bin:/bin HOME=/nonexistent TMPDIR=/tmp LANG=C
RootDirectory=/opt/fleet-render-vm/root
MountAPIVFS=yes
BindReadOnlyPaths=/usr:/usr /opt/fleet-render-vm/bin:/app /opt/fleet-render-vm/image.qcow2:/image/base.qcow2 /var/lib/fleet-render-vm-volume.img:/volume/backing.img
BindReadOnlyPaths=/sys/dev/block:/sys/dev/block /sys/devices/virtual/block:/sys/devices/virtual/block
BindPaths=/var/lib/fleet-render-vm:/state /var/lib/fleet-render-vm/tmp:/tmp /var/lib/fleet-render-vm/vartmp:/var/tmp /dev/kvm:/dev/kvm
WorkingDirectory=/state
ExecStartPre=/usr/bin/python3 -I /app/vm-preflight.py
ExecStart=/usr/bin/python3 -I /app/vm-broker.py
Restart=no
TimeoutStopSec=20s
KillMode=control-group
UMask=0077
MemoryAccounting=yes
MemoryHigh=1600M
MemoryMax=2G
MemorySwapMax=0
CPUAccounting=yes
CPUQuota=200%
TasksAccounting=yes
TasksMax=128
IOAccounting=yes
IOWeight=20
IOReadBandwidthMax=/var/lib/fleet-render-vm 40M
IOWriteBandwidthMax=/var/lib/fleet-render-vm 20M
IOReadBandwidthMax=/opt/fleet-render-vm/image.qcow2 40M
IOReadBandwidthMax=/var/lib/fleet-render-vm-volume.img 40M
IOWriteBandwidthMax=/opt/fleet-render-vm/image.qcow2 20M
IOWriteBandwidthMax=/var/lib/fleet-render-vm-volume.img 20M
LimitFSIZE=2G
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
PrivateDevices=yes
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallFilter=~@mount
InaccessiblePaths=-/usr/local -/dev/shm
StandardInput=null
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
