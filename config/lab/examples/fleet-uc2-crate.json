 "checks": [
  {
   "id": "triangles",
   "run": "node -e \"const s=JSON.parse(require('fs').readFileSync('stats.json','utf8')),r=JSON.parse(require('fs').readFileSync('references/stats.json','utf8'));const t=3000,tol=0.25;if(!(Math.abs(s.triangles-t)<=t*tol))throw Error('triangles '+s.triangles+' outside 3000 +-25%')\""
  },
  {
   "id": "components",
   "run": "node -e \"const s=JSON.parse(require('fs').readFileSync('stats.json','utf8')),r=JSON.parse(require('fs').readFileSync('references/stats.json','utf8'));if(!(s.components>=1&&s.components<=r.components*2))throw Error('components '+s.components+' over twice the reference '+r.components)\""
  },
  {
   "id": "proportions",
   "run": "node -e \"const s=JSON.parse(require('fs').readFileSync('stats.json','utf8')),r=JSON.parse(require('fs').readFileSync('references/stats.json','utf8'));const q=d=>[d[0]/d[1],d[2]/d[1]];const a=q(s.dimensions_m),b=q(r.dimensions_m);if(a.some((x,i)=>!(Math.abs(x-b[i])<=b[i]*0.15)))throw Error('proportions '+a+' vs reference '+b)\""
  },
  {
   "id": "uv-base-color",
   "run": "node -e \"const s=JSON.parse(require('fs').readFileSync('stats.json','utf8')),r=JSON.parse(require('fs').readFileSync('references/stats.json','utf8'));if(!s.uv||!s.pbr.base_color)throw Error('uv or base colour missing')\""
  },
  {
   "id": "renders",
   "run": "for v in front side top three-quarter; do test -s renders/$v.png || { echo \"renders/$v.png missing\"; exit 1; }; done"
