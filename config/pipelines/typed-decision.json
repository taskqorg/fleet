{
  "id": "typed-decision",
  "steps": [
    {
      "arguments": {
        "model": "jev-latest",
        "questions": {
          "q": {
            "instructions": "Answer the question at the end of the state: yes or no.",
            "type": "noul"
          }
        },
        "state": "${example.prompt}"
      },
      "connection": "typesafe",
      "id": "decide",
      "kind": "api",
      "output": {
        "answer": "${reply.answers.q}",
        "answered_by": "${reply.model}",
        "p": "${reply.answers.q.noul}",
        "tokens": "${reply.usage}"
      },
      "tool": "system_one"
    }
  ],
  "version": 2
}
