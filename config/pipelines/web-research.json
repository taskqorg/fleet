{
  "id": "web-research",
  "steps": [
    {
      "arguments": {
        "max_results": 5,
        "query": "${example.prompt}",
        "search_depth": "basic"
      },
      "connection": "tavily",
      "id": "search",
      "kind": "api",
      "tool": "web_search"
    },
    {
      "arguments": {
        "extract_depth": "basic",
        "urls": "${steps.search.output.results.0.url}"
      },
      "connection": "tavily",
      "id": "read",
      "kind": "api",
      "tool": "web_extract"
    },
    {
      "id": "summary",
      "kind": "agent",
      "profile": "codex-researcher",
      "prompt": "Research task: ${example.prompt}\nThe search results are in $FLEET_INPUT_DIR/search/output.json and the extracted page in $FLEET_INPUT_DIR/read/output.json. If you need more sources, use the web_search and web_extract tools of the tavily connection. Write the answer to output/summary.md with a Sources section listing every URL you used."
    },
    {
      "command": "test -s \"$FLEET_INPUT_DIR/summary/summary.md\" && grep -qi 'sources' \"$FLEET_INPUT_DIR/summary/summary.md\" && grep -q 'http' \"$FLEET_INPUT_DIR/summary/summary.md\"",
      "id": "check",
      "kind": "script"
    }
  ],
  "version": 2
}
