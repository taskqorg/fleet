{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "operations": {
    "youtrack_project_connect": {
      "read": false,
      "long": true,
      "errors": [400,403,404,409,503],
      "auth": "owner",
      "agent": "tool",
      "description": "Connect YouTrack project. Preview or apply with a stable bindingId. Supply the immutable YouTrack project ID and exactly one selector (issueIds, issueKeys or wholeProject: true), a YouTrack reviewer ID or login mapped to their Fleet person, and the SHA-256 of a high-entropy webhook bearer configured in YouTrack. Reuse botId or provision the project's PM bot at bindingId. Applying the same setup is idempotent. Use baseRevision for credential rotation, reviewer or selector changes, or reconnection. existingTasks can adopt an explicitly selected managed Fleet task for an issue. Optionally pause an explicitly named polling trigger at its expected revision."
    },
    "youtrack_project_disconnect": {
      "read": false, "errors": [400,404,409], "auth": "owner", "agent": "tool",
      "description": "Disconnect the YouTrack webhook and reconciliation at baseRevision. Retain correlated tasks. Reconnect or rotate through youtrack_project_connect with the latest revision."
    },
    "youtrack_comment_sync": {
      "read": false,
      "errors": [400,403,404,409],
      "auth": "person",
      "agent": "tool",
      "description": "Queue a zero-PII YouTrack comment for a correlated Fleet task's open question or current result offer. milestoneId is the Fleet question or acceptance question ID. Replaying the same milestone reuses its durable write and reports the last confirmed outcome. recheck: true expedites the safe readback of an unknown write."
    },
    "bot_list": {
      "read": true,
      "errors": [
        404
      ],
      "auth": "person",
      "agent": "tool",
      "description": "List bot settings and runtime status visible in granted projects, optionally for one project.",
      "changes": [
        "bot",
        "execution",
        "setting-change",
        "question"
      ]
    },
    "bot_get": {
      "read": true,
      "errors": [
        404
      ],
      "auth": "person",
      "agent": "tool",
      "description": "Read the saved settings, scoped memory and runtime status of a bot by id.",
      "changes": [
        "bot",
        "execution",
        "setting-change",
        "question"
      ]
    },
    "bot_settings_save": {
      "read": false,
      "errors": [
        400,
        404,
        409
      ],
      "auth": "project:projectId",
      "agent": "tool",
      "description": "Save a new settings revision. A caller-generated botId and baseRevision 0 create a bot and its conversation without a subject."
    },
    "bot_memory_save": {
      "read": false,
      "errors": [
        400,
        404,
        409
      ],
      "auth": "person",
      "agent": "tool",
      "description": "Save a new project-scoped bot memory revision."
    },
    "bot_avatar_set": {
      "read": false,
      "errors": [
        400,
        403,
        404
      ],
      "auth": "person",
      "agent": "tool",
      "description": "Set a bot's avatar to a stored image or video artifact of the bot's project: any still or animated picture (PNG, JPEG, WebP, AVIF, GIF, APNG, SVG) or a muted loop (WebM, MP4). stillArtifactId is an optional still frame that lists show in place of an animated file; glow (#RRGGBB) colours the activity light. Make one with the avatar-make pipeline or upload it (artifact_upload_begin)."
    },
    "bot_avatar_clear": {
      "read": false,
      "errors": [
        403,
        404
      ],
      "auth": "person",
      "agent": "tool",
      "description": "Clear a bot's avatar: the bot shows its letter again."
    },
    "bot_identity_set": {
      "read": false,
      "errors": [
        400,
        403,
        404
      ],
      "auth": "person",
      "agent": "tool",
      "description": "Set a bot's identity colour and pattern (OR-72): color one of rose, violet, sky, teal, lime, sand, coral, slate, or '' for the automatic one; pattern solid, hatch or '' (solid)."
    },
    "bot_run": {
      "read": false,
      "errors": [
        400,
        404,
        409
      ],
      "auth": "person",
      "agent": "tool",
      "description": "Run a bot now in its conversation without a subject (with automationId: the trigger's conversation), pinning settings, memory and project. A busy conversation queues the message as its next turn: the reply then has no run."
    },
    "bot_pause": {
      "read": false,
      "errors": [
        400,
        404
      ],
      "auth": "person",
      "agent": "tool",
      "description": "Pause or resume a bot's future scheduled and Needs-you wakes."
    },
    "bot_stop": {
      "read": false,
      "errors": [
        400,
        404
      ],
      "auth": "person",
      "agent": "tool",
      "description": "Request cancellation of a bot's active execution through the execution lifecycle and report the observed stop outcome."
    },
    "bot_runs": {
      "read": true,
      "errors": [
        400,
        404
      ],
      "auth": "person",
      "agent": "tool",
      "description": "List bot runs: the agent runs of the bot's conversations, including quiet wakes and queued, failed and unconfirmed work. A trigger wake that never ran is in the trigger's last run (trigger_list), not here.",
      "changes": [
        "execution",
        "session"
      ]
    },
    "bot_tasks": {
      "read": true,
      "errors": [
        400,
        404
      ],
      "auth": "person",
      "agent": "tool",
      "description": "List managed Fleet tasks linked to a bot, keeping each task's own Fleet state and independent history.",
      "changes": [
        "bot",
        "task",
        "execution",
        "question"
      ]
    },
    "bot_task_link": {
      "read": false,
      "errors": [
        400,
        403,
        404,
        409
      ],
      "auth": "person",
      "agent": "tool",
      "description": "Link a Fleet task in the bot's project as a managed task of the bot without attaching the Home conversation."
    }
  },
  "$defs": {
    "YoutrackProjectConnectRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["bindingId", "projectId", "youtrackProjectId", "reviewerPerson", "webhookTokenSha256", "zeroPii"],
      "properties": {
        "bindingId": {"type": "string"}, "projectId": {"type": "string"}, "baseRevision": {"type": "integer"},
        "youtrackProjectId": {"type": "string"}, "botId": {"type": "string"},
        "wholeProject": {"type": "boolean"}, "issueIds": {"type": "array", "items": {"type": "string"}},
        "issueKeys": {"type": "array", "items": {"type": "string"}},
        "existingTasks": {"type": "array", "items": {"$ref": "#/$defs/YoutrackExistingTask"}},
        "reviewerLogin": {"type": "string"}, "reviewerUserId": {"type": "string"}, "reviewerPerson": {"type": "string"},
        "webhookTokenSha256": {"type": "string"}, "zeroPii": {"type": "boolean"},
        "preview": {"type": "boolean"},
        "pollingTriggerId": {"type": "string"}, "pollingTriggerRevision": {"type": "integer"}
      }
    },
    "YoutrackExistingTask": {
      "type": "object", "additionalProperties": false, "required": ["issue", "task"],
      "properties": {"issue": {"type": "string"}, "task": {"type": "string"}}
    },
    "YoutrackProjectConnectReply": {
      "type": "object", "additionalProperties": false,
      "required": ["bindingId", "projectId", "botId", "triggerId", "youtrackProjectId", "issueIds", "wholeProject", "reviewerUserId", "reviewerPerson", "zeroPii", "webhookPath", "applied", "revision"],
      "properties": {
        "bindingId": {"type": "string"}, "projectId": {"type": "string"}, "botId": {"type": "string"}, "triggerId": {"type": "string"},
        "youtrackProjectId": {"type": "string"}, "issueIds": {"type": "array", "items": {"type": "string"}}, "wholeProject": {"type": "boolean"},
        "reviewerUserId": {"type": "string"}, "reviewerPerson": {"type": "string"}, "zeroPii": {"type": "boolean"},
        "existingTasks": {"type": "array", "items": {"$ref": "#/$defs/YoutrackExistingTask"}},
        "youtrackProjectKey": {"type": "string"}, "connection": {"type": "string"},
        "webhookPath": {"type": "string"}, "revision": {"type": "integer"}, "applied": {"type": "boolean"}, "pollingTriggerId": {"type": "string"}
      }
    },
    "YoutrackProjectDisconnectRequest": {
      "type": "object", "additionalProperties": false, "required": ["bindingId", "baseRevision"],
      "properties": {"bindingId": {"type": "string"}, "baseRevision": {"type": "integer"}}
    },
    "YoutrackProjectDisconnectReply": {
      "type": "object", "additionalProperties": false, "required": ["revision"],
      "properties": {"revision": {"type": "integer"}}
    },
    "YoutrackCommentSyncRequest": {
      "type": "object", "additionalProperties": false, "required": ["taskId", "milestoneId"],
      "properties": {"taskId": {"type": "string"}, "milestoneId": {"type": "string"}, "recheck": {"type": "boolean"}}
    },
    "YoutrackCommentState": {"type": "string", "enum": ["queued", "unknown", "confirmed", "skipped"]},
    "YoutrackCommentSyncReply": {
      "type": "object", "additionalProperties": false, "required": ["state"],
      "properties": {"state": {"$ref": "#/$defs/YoutrackCommentState"}, "commentId": {"type": "string"}, "lastError": {"type": "string"}}
    },
    "BotSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "purpose",
        "profileId",
        "instructions",
        "soul"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "profileId": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        },
        "soul": {
          "type": "string"
        },
        "duty": {
          "$ref": "#/$defs/BotDuty"
        }
      }
    },
    "BotRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "director",
        "revision",
        "settings",
        "memory",
        "memoryRevision",
        "paused",
        "pausedAt",
        "activeRunId",
        "lastRunAt",
        "lastRunState",
        "needsYou",
        "conversationId"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "director": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "settings": {
          "$ref": "#/$defs/BotSettings"
        },
        "memory": {
          "type": "string"
        },
        "memoryRevision": {
          "type": "integer"
        },
        "paused": {
          "type": "boolean"
        },
        "pausedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "activeRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastRunAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastRunState": {
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "type": [
            "string",
            "null"
          ],
          "$comment": "the bot's D17 code (B-FLT-1); open the bot by it (entity_resolve)"
        },
        "avatar": {
          "$ref": "#/$defs/BotAvatar",
          "$comment": "absent: the bot shows its letter"
        },
        "needsYou": {
          "type": "boolean",
          "$comment": "the active run waits, or an open question waits in one of its conversations"
        },
        "conversationId": {
          "type": [
            "string",
            "null"
          ],
          "$comment": "the bot's newest conversation without a subject: where Talk to it and person messages go"
        },
        "autoColor": {
          "type": "string",
          "$comment": "the stored automatic identity colour (OR-72); '' before one is stored"
        },
        "color": {
          "type": "string",
          "$comment": "the colour set for the bot, overriding autoColor; '' for automatic"
        },
        "pattern": {
          "type": "string",
          "$comment": "solid or hatch; '' for solid"
        }
      }
    },
    "BotListRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "projectId": {
          "type": "string"
        },
        "projectIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludeProjectIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "BotListItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "name",
        "purpose",
        "revision",
        "paused",
        "activeRunId",
        "lastRunState",
        "lastRunAt",
        "needsYou",
        "conversationId"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "paused": {
          "type": "boolean"
        },
        "activeRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastRunState": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastRunAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "type": [
            "string",
            "null"
          ],
          "$comment": "the bot's D17 code (B-FLT-1); open the bot by it (entity_resolve)"
        },
        "avatar": {
          "$ref": "#/$defs/BotAvatar",
          "$comment": "absent: the bot shows its letter"
        },
        "needsYou": {
          "type": "boolean",
          "$comment": "the active run waits, or an open question waits in one of its conversations"
        },
        "conversationId": {
          "type": [
            "string",
            "null"
          ],
          "$comment": "the bot's newest conversation without a subject: where Talk to it and person messages go"
        },
        "autoColor": {
          "type": "string",
          "$comment": "the stored automatic identity colour (OR-72); '' before one is stored"
        },
        "color": {
          "type": "string",
          "$comment": "the colour set for the bot, overriding autoColor; '' for automatic"
        },
        "pattern": {
          "type": "string",
          "$comment": "solid or hatch; '' for solid"
        }
      }
    },
    "BotListReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bots"
      ],
      "properties": {
        "bots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BotListItem"
          }
        }
      }
    },
    "BotGetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "botId"
      ],
      "properties": {
        "botId": {
          "type": "string"
        }
      }
    },
    "BotGetReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bot"
      ],
      "properties": {
        "bot": {
          "$ref": "#/$defs/BotRecord"
        }
      }
    },
    "BotSettingsSaveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "botId",
        "projectId",
        "baseRevision",
        "settings"
      ],
      "properties": {
        "botId": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "baseRevision": {
          "type": "integer"
        },
        "settings": {
          "$ref": "#/$defs/BotSettings"
        }
      }
    },
    "BotSettingsSaveReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bot"
      ],
      "properties": {
