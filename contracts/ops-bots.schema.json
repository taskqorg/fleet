          "type": "string"
        },
        "automationId": {
          "type": "string"
        }
      }
    },
    "BotRunReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bot",
        "sessionId",
        "admitted"
      ],
      "properties": {
        "bot": {
          "$ref": "#/$defs/BotRecord"
        },
        "admitted": {
          "type": "boolean"
        },
        "run": {
          "$ref": "#/$defs/BotRunRecord",
          "$comment": "absent: the conversation was busy and queued the message"
        },
        "sessionId": {
          "type": "string",
          "$comment": "the conversation the wake went to"
        }
      }
    },
    "BotPauseRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "botId",
        "paused"
      ],
      "properties": {
        "botId": {
          "type": "string"
        },
        "paused": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "BotPauseReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bot"
      ],
      "properties": {
        "bot": {
          "$ref": "#/$defs/BotRecord"
        }
      }
    },
    "BotStopRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "botId"
      ],
      "properties": {
        "botId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "BotStopReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "botId",
        "stopped"
      ],
      "properties": {
        "botId": {
          "type": "string"
        },
        "stopped": {
          "type": "boolean"
        },
        "run": {
          "$ref": "#/$defs/BotRunRecord"
        },
        "stop": {
          "$ref": "ops-executions.schema.json#/$defs/StopOutcome"
        }
      }
    },
    "BotRunsRequest": {
      "type": "object",
      "additionalProperties": false,
