          "$ref": "#/$defs/BotRecord"
        }
      }
    },
    "BotMemorySaveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "botId",
        "baseRevision",
        "memory"
      ],
      "properties": {
        "botId": {
          "type": "string"
        },
        "baseRevision": {
          "type": "integer"
        },
        "memory": {
          "type": "string"
        }
      }
    },
    "BotMemorySaveReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bot"
      ],
      "properties": {
        "bot": {
          "$ref": "#/$defs/BotRecord"
        }
      }
    },
    "BotAvatar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "mediaType",
        "stillArtifactId",
        "glow"
      ],
      "$comment": "A bot's avatar; the browser reads each file at /api/results/{artifactId}. null avatar: the bot shows its letter.",
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "stillArtifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "glow": {
          "type": "string",
          "$comment": "#RRGGBB or empty: the bot tone"
        }
      }
    },
    "BotAvatarSetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "botId",
        "artifactId"
      ],
      "properties": {
        "botId": {
          "type": "string"
        },
        "artifactId": {
          "type": "string"
        },
        "stillArtifactId": {
          "type": "string"
        },
        "glow": {
          "type": "string"
        }
      }
    },
    "BotAvatarSetReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bot"
      ],
      "properties": {
        "bot": {
          "$ref": "#/$defs/BotRecord"
        }
      }
    },
    "BotAvatarClearRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "botId"
      ],
      "properties": {
        "botId": {
          "type": "string"
        }
      }
    },
    "BotAvatarClearReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bot"
      ],
      "properties": {
        "bot": {
          "$ref": "#/$defs/BotRecord"
        }
      }
    },
    "BotRunState": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting",
        "succeeded",
        "failed",
        "cancelled",
        "skipped"
      ]
    },
    "BotRunCause": {
      "type": "string",
      "enum": [
        "manual",
        "schedule",
        "needs_you",
        "message"
      ]
    },
    "BotRunObservation": {
      "type": "string",
      "enum": [
        "confirmed",
        "unconfirmed"
      ]
    },
    "BotRunRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "botId",
        "projectId",
        "botRevision",
        "memoryRevision",
        "sessionId",
        "executionId",
        "cause",
        "state",
        "observation",
        "quiet",
        "reason",
        "sentBy",
        "source",
        "hostId",
        "problem",
        "createdAt",
        "startedAt",
        "endedAt",
        "linkedTaskIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "$comment": "the run: the execution of the wake's turn"
        },
        "botId": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "botRevision": {
          "type": "integer"
        },
        "memoryRevision": {
          "type": "integer"
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "executionId": {
          "type": "string",
          "$comment": "the same as id"
        },
        "cause": {
          "$ref": "#/$defs/BotRunCause"
        },
        "state": {
          "$ref": "#/$defs/BotRunState"
        },
        "observation": {
          "$ref": "#/$defs/BotRunObservation"
        },
        "quiet": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "sentBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "hostId": {
          "type": [
            "string",
            "null"
          ]
        },
        "problem": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "endedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "linkedTaskIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "automation": {
          "$ref": "#/$defs/BotAutomationRef",
          "$comment": "the trigger that sent the wake"
        },
        "failure": {
          "$ref": "ops.schema.json#/$defs/Failure"
        }
      }
    },
    "BotRunRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "botId"
      ],
      "properties": {
        "botId": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        },
