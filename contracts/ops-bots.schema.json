{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "operations": {
    "bot_list": {
      "read": true,
      "errors": [
        404
      ],
      "auth": "person",
      "agent": "tool",
      "description": "List bot settings and runtime status visible in granted projects, optionally for one project.",
      "changes": [
        "bot",
        "bot-run",
        "setting-change",
        "question"
      ]
    },
    "bot_get": {
      "read": true,
      "errors": [
        404
      ],
      "auth": "person",
      "agent": "tool",
      "description": "Read the saved settings, scoped memory, Home conversation and runtime status of a bot by id.",
      "changes": [
        "bot",
        "bot-run",
        "setting-change",
        "question"
      ]
    },
    "bot_settings_save": {
      "read": false,
      "errors": [
        400,
        404,
        409
      ],
      "auth": "project:projectId",
      "agent": "no",
      "description": "Save a new settings revision. A caller-generated botId and baseRevision 0 create a bot and its Home conversation."
    },
    "bot_memory_save": {
      "read": false,
      "errors": [
        400,
        404,
        409
      ],
      "auth": "person",
      "agent": "no",
      "description": "Save a new project-scoped bot memory revision."
    },
    "bot_avatar_set": {
      "read": false,
      "errors": [
        400,
        403,
        404
      ],
      "auth": "person",
      "agent": "tool",
      "description": "Set a bot's avatar to a stored image or video artifact of the bot's project: any still or animated picture (PNG, JPEG, WebP, AVIF, GIF, APNG, SVG) or a muted loop (WebM, MP4). stillArtifactId is an optional still frame that lists show in place of an animated file; glow (#RRGGBB) colours the activity light. Make one with the avatar-make pipeline or upload it (artifact_upload_begin)."
    },
    "bot_avatar_clear": {
      "read": false,
      "errors": [
        403,
        404
      ],
      "auth": "person",
      "agent": "tool",
      "description": "Clear a bot's avatar: the bot shows its letter again."
    },
    "bot_run": {
      "read": false,
      "errors": [
        400,
        404,
        409
      ],
      "auth": "person",
      "agent": "no",
      "description": "Run a bot now using the shared wake admission flow, enforcing single active run admission and pinning settings, memory and project."
    },
    "bot_pause": {
      "read": false,
      "errors": [
        400,
        404
      ],
      "auth": "person",
      "agent": "no",
      "description": "Pause or resume a bot's future scheduled and Needs-you wakes."
    },
    "bot_stop": {
      "read": false,
      "errors": [
        400,
        404
      ],
      "auth": "person",
      "agent": "no",
      "description": "Request cancellation of a bot's active execution through the execution lifecycle and report the observed stop outcome."
    },
    "bot_runs": {
      "read": true,
      "errors": [
        400,
        404
      ],
      "auth": "person",
      "agent": "no",
      "description": "List bot runs, including quiet wakes and skipped, queued, failed and unconfirmed work.",
      "changes": [
        "bot-run",
        "execution",
        "session"
      ]
    },
    "bot_tasks": {
      "read": true,
      "errors": [
        400,
        404
      ],
      "auth": "person",
      "agent": "tool",
      "description": "List managed Fleet tasks linked to a bot, keeping each task's own Fleet state and independent history.",
      "changes": [
        "bot",
        "task",
        "execution",
        "question"
      ]
    },
    "bot_task_link": {
      "read": false,
      "errors": [
        400,
        403,
        404,
        409
      ],
      "auth": "person",
      "agent": "tool",
      "description": "Link a Fleet task in the bot's project as a managed task of the bot without attaching the Home conversation."
    },
    "bot_automations": {
      "read": true,
      "errors": [
        404
      ],
      "auth": "person",
      "agent": "no",
      "description": "List a bot's automations (its triggers, docs/designs/fleet-triggers.md) and their next scheduled time and last outcome. Kept for the bot page until it reads trigger_list.",
      "changes": [
        "bot",
        "bot-run",
        "execution",
        "setting-change",
        "trigger"
      ]
    },
    "bot_automation_save": {
      "read": false,
      "errors": [
        400,
        404,
        409
      ],
      "auth": "person",
      "agent": "no",
      "description": "Create or update one bot automation (a bot trigger) with an optimistic revision. Enable and pause are settings changes. Kept for the bot page until it writes trigger_save."
    }
  },
  "$defs": {
    "BotSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "purpose",
        "profileId",
        "instructions",
        "soul"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "profileId": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        },
        "soul": {
          "type": "string"
        }
      }
    },
    "BotRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "director",
        "revision",
        "settings",
        "memory",
        "memoryRevision",
        "homeSessionId",
        "paused",
        "pausedAt",
        "activeRunId",
        "activeExecutionId",
        "lastRunAt",
        "lastRunState",
        "needsYou"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "director": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "settings": {
          "$ref": "#/$defs/BotSettings"
        },
        "memory": {
          "type": "string"
        },
        "memoryRevision": {
          "type": "integer"
        },
        "homeSessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "paused": {
          "type": "boolean"
        },
        "pausedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "activeRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "activeExecutionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastRunAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastRunState": {
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "type": [
            "string",
            "null"
          ],
          "$comment": "the bot's D17 code (B-FLT-1); open the bot by it (entity_resolve)"
        },
        "avatar": {
          "$ref": "#/$defs/BotAvatar",
          "$comment": "absent: the bot shows its letter"
        },
        "needsYou": {
          "type": "boolean",
          "$comment": "the active run waits, or an open question waits in its Home conversation or active run"
        }
      }
    },
    "BotListRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "projectId": {
          "type": "string"
        },
        "projectIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludeProjectIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "BotListItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "name",
        "purpose",
        "revision",
        "paused",
        "homeSessionId",
        "activeRunId",
        "lastRunState",
        "lastRunAt",
        "needsYou"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "paused": {
          "type": "boolean"
        },
        "homeSessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "activeRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastRunState": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastRunAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "type": [
            "string",
            "null"
          ],
          "$comment": "the bot's D17 code (B-FLT-1); open the bot by it (entity_resolve)"
        },
        "avatar": {
          "$ref": "#/$defs/BotAvatar",
          "$comment": "absent: the bot shows its letter"
        },
        "needsYou": {
          "type": "boolean",
          "$comment": "the active run waits, or an open question waits in its Home conversation or active run"
        }
      }
    },
    "BotListReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bots"
      ],
      "properties": {
        "bots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BotListItem"
          }
        }
      }
    },
    "BotGetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "botId"
      ],
      "properties": {
        "botId": {
          "type": "string"
        }
      }
    },
    "BotGetReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bot"
      ],
      "properties": {
        "bot": {
          "$ref": "#/$defs/BotRecord"
        }
      }
    },
    "BotSettingsSaveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "botId",
        "projectId",
        "baseRevision",
        "settings"
      ],
      "properties": {
        "botId": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "baseRevision": {
          "type": "integer"
        },
        "settings": {
          "$ref": "#/$defs/BotSettings"
        }
      }
    },
    "BotSettingsSaveReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bot"
      ],
      "properties": {
        "bot": {
          "$ref": "#/$defs/BotRecord"
        }
      }
    },
    "BotMemorySaveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "botId",
        "baseRevision",
        "memory"
      ],
      "properties": {
        "botId": {
          "type": "string"
        },
        "baseRevision": {
          "type": "integer"
        },
        "memory": {
          "type": "string"
        }
      }
    },
    "BotMemorySaveReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bot"
      ],
      "properties": {
        "bot": {
          "$ref": "#/$defs/BotRecord"
        }
      }
    },
    "BotAvatar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "mediaType",
        "stillArtifactId",
        "glow"
      ],
      "$comment": "A bot's avatar; the browser reads each file at /api/results/{artifactId}. null avatar: the bot shows its letter.",
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "stillArtifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "glow": {
          "type": "string",
          "$comment": "#RRGGBB or empty: the bot tone"
        }
      }
    },
    "BotAvatarSetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "botId",
        "artifactId"
      ],
      "properties": {
        "botId": {
          "type": "string"
        },
        "artifactId": {
          "type": "string"
        },
        "stillArtifactId": {
          "type": "string"
        },
        "glow": {
          "type": "string"
        }
      }
    },
    "BotAvatarSetReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bot"
      ],
      "properties": {
        "bot": {
          "$ref": "#/$defs/BotRecord"
        }
      }
    },
    "BotAvatarClearRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "botId"
      ],
      "properties": {
        "botId": {
          "type": "string"
        }
      }
    },
    "BotAvatarClearReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bot"
      ],
      "properties": {
        "bot": {
          "$ref": "#/$defs/BotRecord"
        }
      }
    },
    "BotRunState": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting",
        "succeeded",
        "failed",
        "cancelled",
        "skipped"
      ]
    },
    "BotRunCause": {
      "type": "string",
      "enum": [
        "manual",
        "schedule",
        "needs_you",
        "message"
      ]
    },
    "BotRunObservation": {
      "type": "string",
      "enum": [
        "confirmed",
        "unconfirmed"
      ]
    },
    "BotRunWakeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "BotRunRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "botId",
        "projectId",
        "botRevision",
        "memoryRevision",
        "sessionId",
        "executionId",
        "queuedMessageId",
        "cause",
        "dedupKey",
        "state",
        "observation",
        "quiet",
        "reason",
        "sentBy",
        "source",
        "hostId",
        "problem",
        "createdAt",
        "startedAt",
        "endedAt",
        "triggers",
        "linkedTaskIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "botId": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "botRevision": {
          "type": "integer"
        },
        "memoryRevision": {
          "type": "integer"
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "executionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "queuedMessageId": {
          "type": [
            "string",
            "null"
          ]
        },
        "cause": {
          "$ref": "#/$defs/BotRunCause"
        },
        "dedupKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/BotRunState"
        },
        "observation": {
          "$ref": "#/$defs/BotRunObservation"
        },
        "quiet": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "sentBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "hostId": {
          "type": [
            "string",
            "null"
          ]
        },
        "problem": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "endedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "triggers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BotRunWakeItem"
          }
        },
        "linkedTaskIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "automation": {
          "$ref": "#/$defs/BotAutomationRef"
        },
        "failure": {
          "$ref": "ops.schema.json#/$defs/Failure"
        }
      }
    },
    "BotRunRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "botId"
      ],
      "properties": {
        "botId": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "automationId": {
          "type": "string"
        }
      }
    },
    "BotRunReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
