        },
        "createdBy": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      }
    },
    "BotTaskRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "botId",
        "botName",
        "taskId",
        "projectId",
        "botRunId",
        "sessionId",
        "executionId",
        "linkKind",
        "createdBy",
        "createdAt",
        "taskCode",
        "title",
        "state",
        "waitReason",
        "pauseReason",
        "priority",
        "acceptedAt",
        "acceptedBy",
        "openQuestions",
        "executionCount",
        "executionsByState",
        "updatedAt"
      ],
      "properties": {
        "botId": {
          "type": "string"
        },
        "botName": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "botRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "executionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "linkKind": {
          "$ref": "#/$defs/BotTaskLinkKind"
        },
        "createdBy": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "taskCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
