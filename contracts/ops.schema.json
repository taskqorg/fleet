{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Coordinator operations (POST /api/ops/<name>), called by the app and, as MCP tools, by agents: the shared part. The operations are in ops-<domain>.schema.json, one file per domain (contracts/README.md). In each, operations lists its registered operations: read (a read snapshot), long (no surrounding transaction), errors (status codes the handler itself returns; every operation can also return 401 signed out, 403 role or grant, and 500). Each operation <name> has $defs <Name>Request and <Name>Reply. A failed call answers OpError. planned lists operations specified contract first and not built yet (docs/designs/fleet-definition-editors.md); building one moves it to operations in the same file. go/coordinator checks at test time that all operations together equal its registry. This file holds OpError, ChangeKind, the types two or more domains share and the types no operation reaches.",
  "$defs": {
    "AssessmentBasis": {"type": "string", "enum": ["lab", "usage", "none"]},
    "CatalogueMethod": {"type": "object", "required": ["id", "name", "scope", "pipeline"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "scope": {"type": "string"}, "pipeline": {"type": "string"}, "agentProfile": {"type": "string"}, "overrides": {"type": "object", "additionalProperties": true}, "configRef": {"type": "string"}, "sourceExperiment": {"type": "string"}}},
    "CatalogueMethodView": {"type": "object","required": ["id","name","scope","pipeline","assessment","recommendedFor"],"properties": {"id": {"type": "string"},"name": {"type": "string"},"scope": {"type": "string"},"pipeline": {"type": "string"},"agentProfile": {"type": "string"},"overrides": {"type": "object","additionalProperties": true},"configRef": {"type": "string"},"sourceExperiment": {"type": "string"},"assessment": {"$ref": "#/$defs/MethodAssessment"},"recommendedFor": {"type": "array","items": {"type": "string"}}}},
    "ChangeKind": {"type": "string","enum": ["api-connection","artifact","command","connection-key","definition","event","execution","experiment","host","managed-account","project-recommendation","question","score","session","setting-change","task"],"$comment": "The kinds the change triggers write (fleet_change and fleet_artifact_change in go/coordinator/schema.sql); a go test checks the triggers against this list."},
    "ConflictReason": {"type": "string", "enum": ["base-moved", "repository-changed", "no-change", "wrong-state", "invalid-draft"]},
    "DefinitionConflict": {"type": "object", "required": ["reason", "head"], "properties": {"reason": {"$ref": "#/$defs/ConflictReason"}, "head": {"type": "integer"}, "repoSha": {"type": ["string", "null"]}}, "$comment": "Body of a 409 from definition_save and definition_create."},
    "DefinitionKind": {"type": "string", "enum": ["agent", "pipeline", "catalogue"]},
    "DefinitionMirrorResetReply": {"type": "object", "required": ["commits"], "properties": {"commits": {"type": "integer"}}},
    "DefinitionMirrorResetRequest": {"type": "object", "required": ["confirm"], "properties": {"confirm": {"type": "string"}}, "$comment": "confirm must be the repository name; owner only. Rebuilds the mirror branch from store history and force-pushes."},
    "DefinitionRef": {"type": "object", "required": ["kind", "id", "revision", "contentSha"], "properties": {"kind": {"$ref": "#/$defs/DefinitionKind"}, "id": {"type": "string"}, "revision": {"type": "integer", "minimum": 0}, "contentSha": {"type": "string"}, "draft": {"type": "boolean"}}, "$comment": "With draft true, revision is the base revision (0 for a new definition) and contentSha is the draft's."},
    "ExecutionRow": {"type": "object", "required": ["id", "kind", "state", "observation", "lastSeenAt", "projectId", "taskId", "experimentId", "variant", "parentExecutionId", "sessionId", "accountId", "hostId", "environmentId", "harness", "harnessVersion", "model", "configRef", "problem", "startedAt", "endedAt", "definitions"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "state": {"$ref": "#/$defs/ExecutionState"}, "observation": {"type": "string"}, "lastSeenAt": {"type": ["string", "null"]}, "projectId": {"type": ["string", "null"]}, "taskId": {"type": ["string", "null"]}, "experimentId": {"type": ["string", "null"]}, "variant": {"type": ["string", "null"]}, "parentExecutionId": {"type": ["string", "null"]}, "sessionId": {"type": ["string", "null"]}, "accountId": {"type": ["string", "null"]}, "hostId": {"type": ["string", "null"]}, "environmentId": {"type": ["string", "null"]}, "harness": {"type": ["string", "null"]}, "harnessVersion": {"type": ["string", "null"]}, "model": {"type": ["string", "null"]}, "configRef": {}, "problem": {"type": ["string", "null"]}, "startedAt": {"type": ["string", "null"]}, "endedAt": {"type": ["string", "null"]}, "definitions": {"type": "array", "items": {"$ref": "#/$defs/DefinitionRef"}}}, "$comment": "One execution row (executionCols in go/coordinator/tasks.go); times are RFC 3339."},
    "ExecutionState": {"type": "string", "enum": ["preparing", "running", "waiting", "succeeded", "failed", "cancelled"], "$comment": "execution_state in go/coordinator/schema.sql."},
    "ExperimentNote": {"type": "object", "required": ["id", "kind", "text", "author", "at"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "field": {"type": ["string", "null"]}, "old": {}, "new": {}, "text": {"type": "string"}, "author": {"type": "string"}, "at": {}}, "$comment": "Append-only (fleet-lab.md, Experiment record): an amendment of a record field, or a note."},
    "ListFilter": {"type": "object", "properties": {"state": {"type": "array", "items": {"type": "string"}}, "search": {"type": "string"}, "projectId": {"type": "array", "items": {"type": ["string", "null"]}}, "archived": {"type": "boolean"}}, "additionalProperties": true, "$comment": "The list filter of packages/view-url toPageParams; a null projectId is work outside projects."},
    "ListGroup": {"type": "object", "required": ["key", "label", "count"], "properties": {"key": {"type": "string"}, "label": {"type": "string"}, "count": {"type": "integer"}}},
    "ListRow": {"type": "object", "required": ["id", "sortKey"], "properties": {"id": {"type": "string"}, "sortKey": {"type": "array", "items": {}}}, "additionalProperties": true, "$comment": "A task or session row of a list page; sortKey positions it (strings and numbers)."},
    "MethodAssessment": {"type": "object","required": ["basis","score","costUsd","costBasis","wallMsMedian"],"properties": {"basis": {"$ref": "#/$defs/AssessmentBasis"},"experimentId": {"type": "string"},"examples": {"type": "integer"},"score": {"type": ["number","null"]},"scoreForm": {"type": "string"},"wallMsMedian": {"type": ["integer","null"]},"costUsd": {"type": ["number","null"]},"costBasis": {"type": "string"},"at": {"type": "string"},"expectedCells": {"type": "integer"},"eligibleCells": {"type": "integer"},"excludedCells": {"type": "integer"},"failedCells": {"type": "integer"},"durationSamples": {"type": "integer"},"reason": {"type": ["string","null"]},"variant": {"type": ["string","null"]},"state": {"type": ["string","null"]},"stopReason": {"type": ["string","null"]},"configRef": {"type": ["string","null"]},"pipelineId": {"type": ["string","null"]},"split": {"type": ["string","null"]},"evaluator": {"type": ["string","null"]},"evaluatorVersion": {"type": ["string","null"]},"exclusions": {"type": ["string","null"]},"ongoingExperimentId": {"type": ["string","null"]},"ongoingState": {"type": ["string","null"]},"sourceExperimentId": {"type": ["string","null"]},"partial": {"type": "boolean"},"usage": {"type": "object","additionalProperties": true}}},
    "OpError": {"type": "object", "required": ["statusCode", "error", "message"], "properties": {"statusCode": {"type": "integer"}, "error": {"type": "string"}, "message": {"type": "string"}}, "$comment": "Body of every failed operation (writeError in go/coordinator/main.go)."},
    "StreamCursor": {"type": "object", "required": ["cursor"], "properties": {"cursor": {"type": "integer"}}, "$comment": "Body of the GET /api/stream events ready (the cursor the stream starts after) and resync (reload everything, then continue after cursor)."},
    "VariantVsBaseline": {"type": "object", "required": ["variant", "examples", "scoreDelta"], "properties": {"variant": {"type": "string"}, "examples": {"type": "integer"}, "scoreDelta": {"type": ["number", "null"]}, "wins": {"type": "integer"}, "losses": {"type": "integer"}, "ties": {"type": "integer"}, "wallMsDelta": {"type": ["integer", "null"]}, "costUsdDelta": {"type": ["number", "null"]}}, "$comment": "Added to lab_experiment_get: one per non-baseline variant, over examples where both have a final score."}
  }
}
