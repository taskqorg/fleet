{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "operations": {
    "telegram_status": {
      "read": true,
      "errors": [],
      "auth": "person",
      "agent": "tool",
      "description": "The Telegram channel: whether the bot token works (bot username), the last poll and its error, the work waiting (intake, replies, outbox), and the caller's own Telegram link and language."
    },
    "telegram_link_code": {
      "read": false,
      "errors": [
        409
      ],
      "auth": "person",
      "agent": "no",
      "description": "Make a one-time code (valid one day) that links the caller's Fleet person to the Telegram user who sends /start <code> to the bot; url opens that chat directly when the bot is known. A person's act: agents cannot call it, so no agent can hand out a link to someone's Fleet identity."
    },
    "telegram_person_set": {
      "read": false,
      "errors": [
        400,
        403,
        404
      ],
      "auth": "person",
      "agent": "tool",
      "description": "Set a person's Telegram language (en, ru, ...; Fleet's own notices use it), or unlink them. Linking a person to a Telegram user id, or changing another person, needs the owner or a full-access person (or an agent acting for one); the bot confirms each link in the user's private chat. Only Telegram users linked to a Fleet person reach Fleet; what they may do comes from their Fleet roles and grants."
    },
    "telegram_people": {
      "read": true,
      "errors": [],
      "auth": "owner",
      "agent": "tool",
      "description": "Linked people (Telegram user id, username, language, home conversation) and the Telegram users who wrote without a link, newest first, to link with telegram_person_set."
    },
    "telegram_rooms": {
      "read": true,
      "errors": [],
      "auth": "owner",
      "agent": "tool",
      "description": "Every Telegram chat and forum topic the bot has seen (a room), its project hint and its open work items (each a Fleet conversation)."
    },
    "telegram_room_set": {
      "read": false,
      "errors": [
        400,
        404
      ],
      "auth": "owner",
      "agent": "tool",
      "description": "Set a room's project hint: new work items of the room start in that project (empty: conversations outside projects). With chatId (and threadId for a forum topic) instead of roomId it creates the room before the bot has seen it, so a room is set up ahead of its first message."
    },
    "telegram_work_close": {
      "read": false,
      "errors": [
        404
      ],
      "auth": "owner",
      "agent": "tool",
      "description": "Close a room's work item: the conductor no longer attaches messages to it; its conversation stays."
    },
    "telegram_history": {
      "read": true,
      "errors": [
        400,
        404
      ],
      "auth": "owner",
      "agent": "tool",
      "description": "A room's newest messages, oldest first: imported history (telegram_history_import), people's delivered messages and Fleet's replies. A new work item of a group room starts with this history as context."
    },
    "telegram_history_import": {
      "read": false,
      "errors": [
        400
      ],
      "auth": "owner",
      "agent": "tool",
      "description": "Import a room's earlier messages, from before Fleet saw it (a Telegram export), so new work items of the room start with them as context. The room is created when Fleet has not seen it yet; a message id imported again replaces its row."
    }
  },
  "$defs": {
    "TelegramMe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "linked": {
          "type": "boolean"
        },
        "telegramUserId": {
          "type": "integer"
        },
        "username": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "homeSessionId": {
          "type": "string"
        }
      },
      "required": [
        "linked"
      ]
    },
    "TelegramPerson": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": {
          "type": "string"
        },
        "telegramUserId": {
          "type": "integer"
        },
        "username": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "homeSessionId": {
          "type": "string"
        },
        "linkedAt": {
          "type": "integer"
        }
      },
      "required": [
        "email",
        "telegramUserId",
        "username",
        "language",
        "linkedAt"
      ]
    },
    "TelegramUnknownSender": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "telegramUserId": {
          "type": "integer"
        },
        "username": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "lastAt": {
          "type": "integer"
        },
        "messages": {
          "type": "integer"
        }
      },
      "required": [
        "telegramUserId",
        "username",
        "name",
        "lastAt",
        "messages"
      ]
    },
    "TelegramWork": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "createdBy": {
          "type": "string"
        },
        "lastAt": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "title",
        "sessionId",
        "createdBy",
        "lastAt"
      ]
    },
    "TelegramRoom": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "chatId": {
          "type": "integer"
        },
        "threadId": {
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "projectHint": {
          "type": "string"
        },
        "seenAt": {
          "type": "integer"
        },
        "works": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TelegramWork"
          }
        }
      },
      "required": [
        "id",
        "chatId",
        "threadId",
        "kind",
        "title",
        "projectHint",
        "seenAt",
        "works"
      ]
    },
    "TelegramStatusRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "TelegramStatusReply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connected": {
          "type": "boolean",
          "$comment": "the telegram connection takes calls (an active key)"
        },
        "botUsername": {
          "type": "string"
        },
        "botId": {
          "type": "integer"
        },
        "polledAt": {
          "type": "integer"
        },
        "pollError": {
          "type": "string"
        },
        "pending": {
          "$ref": "#/$defs/TelegramPending"
        },
        "me": {
          "$ref": "#/$defs/TelegramMe"
        },
        "groupReads": {
          "type": "boolean",
          "$comment": "getMe can_read_all_group_messages: the bot's privacy mode is off, so it reads every group message (an admin bot reads them either way)"
        },
        "conductor": {
          "$ref": "#/$defs/TelegramConductorCall"
        },
        "delivery": {
          "$ref": "#/$defs/TelegramDeliveryHealth"
        },
        "intake": {
          "$ref": "#/$defs/TelegramIntakeHealth"
        }
      },
      "required": [
        "connected",
        "pending",
        "me"
      ]
    },
    "TelegramLinkCodeRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "TelegramLinkCodeReply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "expiresAt": {
          "type": "integer"
        }
      },
      "required": [
        "code",
        "command",
        "expiresAt"
      ]
    },
    "TelegramPersonSetRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": {
          "type": "string"
        },
        "telegramUserId": {
          "type": "integer"
        },
        "username": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "unlink": {
          "type": "boolean"
        }
      }
    },
    "TelegramPersonSetReply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "person": {
          "$ref": "#/$defs/TelegramPerson"
        },
        "unlinked": {
          "type": "boolean"
        }
      }
    },
    "TelegramPeopleRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "TelegramPeopleReply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "people": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TelegramPerson"
          }
        },
        "unknown": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TelegramUnknownSender"
          }
        }
      },
      "required": [
        "people",
        "unknown"
      ]
    },
    "TelegramRoomsRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "TelegramRoomsReply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rooms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TelegramRoom"
          }
        }
      },
      "required": [
        "rooms"
      ]
    },
    "TelegramRoomSetRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roomId": {
          "type": "string"
        },
        "projectHint": {
          "type": "string"
        },
        "chatId": {
          "type": "integer"
        },
        "threadId": {
          "type": "integer"
        },
        "kind": {
          "type": "string",
          "$comment": "private, group or supergroup; default supergroup for a negative chat id, else private"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "projectHint"
      ]
    },
    "TelegramRoomSetReply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "room": {
          "$ref": "#/$defs/TelegramRoom"
        }
      },
      "required": [
        "room"
      ]
    },
    "TelegramWorkCloseRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workId": {
          "type": "string"
        }
      },
      "required": [
        "workId"
      ]
    },
    "TelegramWorkCloseReply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "closed": {
          "type": "boolean"
        }
      },
      "required": [
        "closed"
      ]
    },
    "TelegramPending": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intake": {
          "type": "integer"
        },
        "replies": {
          "type": "integer"
        },
        "outbox": {
          "type": "integer"
        }
      },
      "required": [
        "intake",
        "replies",
        "outbox"
      ]
    },
    "TelegramConductorCall": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "the conductor's last model call since the coordinator started",
      "properties": {
        "connection": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "at": {
          "type": "integer"
        },
        "choice": {
          "type": "string",
          "$comment": "a work item id, new or ask"
        },
        "error": {
          "type": "string",
          "$comment": "why the call gave no usable answer (the message then got the one-tap question)"
        }
      },
      "required": [
        "connection",
        "model",
        "at"
      ]
    },
    "TelegramDeliveryHealth": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "the outbox in the last day: what Telegram took, refused, or left unknown (never resent), and the newest refusal",
      "properties": {
        "sent": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "unknown": {
          "type": "integer"
        },
        "lastError": {
          "type": "string"
        },
        "lastSentAt": {
          "type": "integer"
        }
      },
      "required": [
        "sent",
        "failed",
        "unknown"
      ]
    },
    "TelegramIntakeHealth": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "the intake journal in the last day",
      "properties": {
        "updates": {
          "type": "integer"
        },
        "strangers": {
          "type": "integer",
          "$comment": "updates from Telegram users not linked to a Fleet person, ignored"
        },
        "failed": {
          "type": "integer",
          "$comment": "messages Fleet could not deliver to a session"
        },
        "lastAt": {
          "type": "integer"
        }
      },
      "required": [
        "updates",
        "strangers",
        "failed"
      ]
    },
    "TelegramHistoryMessage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "messageId": {
          "type": "integer",
          "$comment": "the Telegram message id in its chat"
        },
        "at": {
          "type": "integer",
          "$comment": "sent at, ms since the epoch"
        },
        "author": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "messageId",
        "at",
        "author",
        "text"
      ]
    },
    "TelegramHistoryImportRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chatId": {
          "type": "integer"
        },
        "threadId": {
          "type": "integer",
          "$comment": "the forum topic; 0 or absent: the chat itself or General"
        },
        "title": {
          "type": "string",
          "$comment": "the room's title when the import creates the room"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TelegramHistoryMessage"
          },
          "$comment": "at most 2000 per call"
        }
      },
      "required": [
        "chatId",
        "messages"
      ]
    },
    "TelegramHistoryImportReply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roomId": {
          "type": "string"
        },
        "imported": {
          "type": "integer"
        }
      },
      "required": [
        "roomId",
        "imported"
      ]
    },
    "TelegramHistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "integer"
        },
        "author": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/TelegramHistorySource"
        }
      },
      "required": [
        "at",
        "author",
        "text",
        "source"
      ]
    },
    "TelegramHistoryRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roomId": {
          "type": "string"
        },
        "chatId": {
          "type": "integer"
        },
        "threadId": {
          "type": "integer"
        },
        "limit": {
          "type": "integer",
          "$comment": "default 60, at most 500"
        }
      }
    },
    "TelegramHistoryReply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roomId": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TelegramHistoryEntry"
          }
        }
      },
      "required": [
        "roomId",
        "messages"
      ]
    },
    "TelegramHistorySource": {
      "type": "string",
      "enum": [
        "import",
        "person",
        "fleet"
      ]
    }
  }
}
