{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Coordinator operations of the tasks domain; the rules are in ops.schema.json $comment and contracts/README.md.",
  "operations": {
    "project_context": {"read": true, "errors": [404]},
    "project_list": {"read": true, "errors": [404]},
    "project_readiness": {"read": false, "errors": [400, 404, 409]},
    "question_answer": {"read": false, "errors": [400, 403, 409]},
    "question_ask": {"read": false, "errors": [400, 404, 409]},
    "question_history": {"read": true, "errors": [404]},
    "questions": {"read": true, "errors": []},
    "questions_answer": {"read": false, "errors": [400, 403, 409]},
    "questions_list": {"read": true, "errors": []},
    "questions_withdraw": {"read": false, "errors": [400, 403]},
    "task_cancel": {"read": false, "errors": []},
    "entity_resolve": {"read": true, "errors": [400, 404]},
    "entity_resolve_many": {"read": true, "errors": []},
    "project_code_set": {"read": false, "errors": [400, 403, 404, 409]},
    "task_create": {"read": false, "errors": [400]},
    "task_derived_check": {"read": true, "errors": []},
    "task_get": {"read": true, "errors": [400]},
    "task_hold": {"read": false, "errors": []},
    "task_list": {"read": true, "errors": []},
    "task_page": {"read": true, "errors": [400]},
    "task_release": {"read": false, "errors": []},
    "task_request_acceptance": {"read": false, "errors": [400, 409]},
    "task_take": {"read": false, "errors": [400, 403, 409]},
    "task_update": {"read": false, "errors": [400, 409]}
  },
  "$defs": {
    "EntityCode": {"type": "object", "required": ["code", "id", "type", "currentCode", "superseded"], "properties": {"code": {"type": "string"}, "id": {"type": "string"}, "type": {"type": "string"}, "currentCode": {"type": "string"}, "superseded": {"type": "boolean"}}, "$comment": "A human code (D17) and the entity it names; superseded: an alias of currentCode (a moved entity or a renamed project)."},
    "EntityResolveReply": {"$ref": "#/$defs/EntityCode"},
    "EntityResolveRequest": {"type": "object", "required": ["code"], "properties": {"code": {"type": "string"}}, "additionalProperties": true, "$comment": "Case-insensitive; unknown and forbidden codes both answer 404."},
    "EntityResolveManyReply": {"type": "object", "required": ["codes"], "properties": {"codes": {"type": "array", "items": {"$ref": "#/$defs/EntityCode"}}}, "$comment": "Every known code in the text, in order of first appearance; unknown and forbidden codes are left out."},
    "EntityResolveManyRequest": {"type": "object", "required": ["text"], "properties": {"text": {"type": "string"}}, "additionalProperties": true},
    "ProjectCodeSetReply": {"type": "object", "required": ["projectId", "code"], "properties": {"projectId": {"type": "string"}, "code": {"type": "string"}}},
    "ProjectCodeSetRequest": {"type": "object", "required": ["projectId", "code"], "properties": {"projectId": {"type": "string"}, "code": {"type": "string"}}, "additionalProperties": true, "$comment": "2 to 5 characters, a letter first, not hex-only, no I, O, S, Z or B, never used before. The project's tasks and questions get new codes; old codes stay aliases."},
    "ProjectContextReply": {"type": "object", "additionalProperties": true, "$comment": "The project's context (projectContext): settings, roles, connections, rules."},
    "ProjectContextRequest": {"type": "object", "required": ["projectId"], "properties": {"projectId": {"type": "string"}}, "additionalProperties": true},
    "ProjectListReply": {"type": "object", "required": ["projects"], "properties": {"projects": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "A project's context (projectContext): settings, roles, connections, rules."}}}},
    "ProjectListRequest": {"type": "object", "additionalProperties": true},
    "ProjectQuestion": {"type": "object", "required": ["id", "projectId", "requestId", "text", "state", "createdAt", "actor"], "properties": {"id": {"type": "string"}, "projectId": {"type": "string"}, "requestId": {"type": "string"}, "text": {"type": "string"}, "state": {"type": "string"}, "createdAt": {"type": "integer"}, "actor": {"type": "string"}, "answer": {"type": "string"}, "answeredAt": {"type": "integer"}, "answeredBy": {"type": "string"}}, "$comment": "A project question to the operator; state waiting or answered."},
    "ProjectReadinessReply": {"type": "object", "required": ["projectId", "hosts"], "properties": {"projectId": {"type": "string"}, "hosts": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "A host's readiness for the project."}}}},
    "ProjectReadinessRequest": {"type": "object", "additionalProperties": true, "properties": {"callerSessionId": {"type": "string"}, "projectId": {"type": "string"}}},
    "QuestionAnswerReply": {"type": "object", "additionalProperties": true, "$comment": "A project question (ProjectQuestion), or the answered question row for any other question."},
    "QuestionAnswerRequest": {"type": "object", "required": ["questionId", "answer"], "properties": {"questionId": {"type": "string"}, "answer": {"type": "string"}, "artifactIds": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true, "$comment": "Answers a project question, or any other question by id."},
    "QuestionAskReply": {"$ref": "#/$defs/ProjectQuestion"},
    "QuestionAskRequest": {"type": "object", "required": ["projectId", "requestId", "text"], "properties": {"projectId": {"type": "string"}, "requestId": {"type": "string"}, "text": {"type": "string"}}, "additionalProperties": true},
    "QuestionHistoryReply": {"type": "object", "required": ["questions"], "properties": {"questions": {"type": "array", "items": {"$ref": "#/$defs/ProjectQuestion"}}}},
    "QuestionHistoryRequest": {"type": "object", "required": ["projectId"], "properties": {"projectId": {"type": "string"}}, "additionalProperties": true},
    "QuestionKind": {"type": "string", "enum": ["operator_decision", "agent_question", "acceptance", "rating", "secret"]},
    "QuestionRow": {"type": "object", "required": ["id", "code", "kind", "projectId", "taskId", "executionId", "sessionId", "text", "options", "askedBy", "askedAt", "answer", "answeredBy", "answeredAt", "state"], "properties": {"id": {"type": "string"}, "code": {"type": ["string", "null"]}, "kind": {"$ref": "#/$defs/QuestionKind"}, "projectId": {"type": ["string", "null"]}, "taskId": {"type": ["string", "null"]}, "executionId": {"type": ["string", "null"]}, "sessionId": {"type": ["string", "null"]}, "text": {"type": "string"}, "options": {}, "askedBy": {"type": ["string", "null"]}, "askedAt": {"type": "string"}, "answer": {"type": ["string", "null"]}, "answeredBy": {"type": ["string", "null"]}, "answeredAt": {"type": ["string", "null"]}, "state": {"type": "string"}, "artifactIds": {"$comment": "The ids as stored (data.artifactIds)."}, "cause": {}}, "$comment": "One question row (questionCols in go/coordinator/tasks.go); artifactIds and cause only when set."},
    "QuestionsAnswerReply": {"$ref": "#/$defs/QuestionRow"},
    "QuestionsAnswerRequest": {"type": "object", "required": ["questionId", "answer"], "properties": {"questionId": {"type": "string"}, "answer": {"type": "string"}, "artifactIds": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "QuestionsListReply": {"type": "object", "required": ["questions"], "properties": {"questions": {"type": "array", "items": {"$ref": "#/$defs/QuestionRow"}}}},
    "QuestionsWithdrawReply": {"type": "object", "required": ["withdrawn", "skipped"], "properties": {"withdrawn": {"type": "array", "items": {"type": "string"}}, "skipped": {"type": "array", "items": {"$ref": "#/$defs/QuestionSkipped"}}}},
    "QuestionSkipped": {"type": "object", "required": ["id", "state"], "properties": {"id": {"type": "string"}, "state": {"type": "string", "$comment": "The question's state, or unknown."}}},
    "QuestionsWithdrawRequest": {"type": "object", "required": ["ids", "reason"], "properties": {"ids": {"type": "array", "items": {"type": "string"}}, "reason": {"type": "string"}}, "additionalProperties": false, "$comment": "Owner or full access: withdraws open questions that no longer need anyone; one setting-change audit row per question."},
    "QuestionsListRequest": {"type": "object", "properties": {"projectIds": {"$comment": "keep rows of these projects only (the app passes the person's focus, OR-34); '-' is no project", "type": "array", "items": {"type": "string"}}, "taskId": {"type": "string"}, "state": {"type": "string"}, "kind": {"type": "string"}}, "additionalProperties": true},
    "QuestionsReply": {"type": "object", "required": ["questions"], "properties": {"questions": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "An agent question record."}}}},
    "QuestionsRequest": {"type": "object", "properties": {"sessionId": {"type": "string"}, "state": {"type": "string"}}, "additionalProperties": true},
    "TaskCancelReply": {"$ref": "#/$defs/TaskDetail"},
    "TaskCancelRequest": {"type": "object", "required": ["taskId"], "properties": {"taskId": {"type": "string"}}, "additionalProperties": true},
    "TaskCreateReply": {"$ref": "#/$defs/TaskDetail"},
    "TaskCreateRequest": {"type": "object", "required": ["title"], "properties": {"title": {"type": "string"}, "projectId": {"type": ["string", "null"]}, "expectedOutcome": {"type": "string"}, "priority": {"type": "string"}, "completionRequirements": {}, "resultDestination": {"type": "string"}, "dependsOn": {"type": "array", "items": {"type": "string"}}, "held": {"type": "boolean"}}, "additionalProperties": true, "$comment": "held: the task waits for task_release (always for an agent)."},
    "TaskDependency": {"type": "object", "required": ["id", "kind"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "code": {"type": ["string", "null"]}}, "$comment": "kind blocks or revision_of."},
    "TaskDerivedCheckReply": {"type": "object", "required": ["checked", "drifted"], "properties": {"checked": {"type": "integer"}, "drifted": {"type": "array", "items": {"$ref": "#/$defs/TaskDerivedDrift"}}}},
    "TaskDerivedCheckRequest": {"type": "object", "additionalProperties": true},
    "TaskDerivedDrift": {"type": "object", "required": ["taskId", "stored", "expected"], "properties": {"taskId": {"type": "string"}, "stored": {}, "expected": {}}},
    "TaskDetail": {"type": "object", "required": ["id", "code", "projectId", "title", "expectedOutcome", "state", "waitReason", "priority", "completionRequirements", "resultDestination", "deliveryMethod", "acceptedBy", "acceptedAt", "acceptedArtifactIds", "createdBy", "directedBy", "requestedBy", "takenFrom", "createdAt", "updatedAt", "pauseReason", "progress", "cost", "latestResult", "openQuestions", "executions", "dependencies", "questions"], "properties": {"id": {"type": "string"}, "code": {"type": ["string", "null"]}, "projectId": {"type": ["string", "null"]}, "title": {"type": "string"}, "expectedOutcome": {"type": ["string", "null"]}, "state": {"$ref": "#/$defs/TaskState"}, "waitReason": {"type": ["string", "null"]}, "priority": {"type": "string"}, "completionRequirements": {}, "resultDestination": {"type": ["string", "null"]}, "deliveryMethod": {}, "acceptedBy": {"type": ["string", "null"]}, "acceptedAt": {"type": ["string", "null"]}, "acceptedArtifactIds": {"type": ["array", "null"], "items": {"type": "string"}}, "createdBy": {"type": ["string", "null"]}, "directedBy": {"type": ["string", "null"]}, "requestedBy": {"type": ["string", "null"]}, "takenFrom": {"type": ["string", "null"]}, "createdAt": {"type": "string"}, "updatedAt": {"type": "string"}, "pauseReason": {"type": ["string", "null"]}, "progress": {"$ref": "#/$defs/TaskProgress"}, "cost": {}, "latestResult": {}, "openQuestions": {}, "executions": {"type": "array", "items": {"$ref": "ops.schema.json#/$defs/ExecutionRow"}}, "dependencies": {"type": "array", "items": {"$ref": "#/$defs/TaskDependency"}}, "questions": {"type": "array", "items": {"$ref": "#/$defs/QuestionRow"}}}, "$comment": "A task with its progress, totals, executions, dependencies and questions (taskGet)."},
    "TaskGetReply": {"$ref": "#/$defs/TaskDetail"},
    "TaskGetRequest": {"type": "object", "required": ["taskId"], "properties": {"taskId": {"type": "string"}}, "additionalProperties": true},
    "TaskHoldReply": {"$ref": "#/$defs/TaskDetail"},
    "TaskHoldRequest": {"type": "object", "required": ["taskId"], "properties": {"taskId": {"type": "string"}}, "additionalProperties": true},
    "TaskListItem": {"type": "object", "required": ["id", "code", "projectId", "title", "expectedOutcome", "state", "waitReason", "priority", "completionRequirements", "resultDestination", "deliveryMethod", "acceptedBy", "acceptedAt", "acceptedArtifactIds", "createdBy", "directedBy", "requestedBy", "takenFrom", "createdAt", "updatedAt", "pauseReason", "progress", "openQuestions"], "properties": {"id": {"type": "string"}, "code": {"type": ["string", "null"]}, "projectId": {"type": ["string", "null"]}, "title": {"type": "string"}, "expectedOutcome": {"type": ["string", "null"]}, "state": {"$ref": "#/$defs/TaskState"}, "waitReason": {"type": ["string", "null"]}, "priority": {"type": "string"}, "completionRequirements": {}, "resultDestination": {"type": ["string", "null"]}, "deliveryMethod": {}, "acceptedBy": {"type": ["string", "null"]}, "acceptedAt": {"type": ["string", "null"]}, "acceptedArtifactIds": {"type": ["array", "null"], "items": {"type": "string"}}, "createdBy": {"type": ["string", "null"]}, "directedBy": {"type": ["string", "null"]}, "requestedBy": {"type": ["string", "null"]}, "takenFrom": {"type": ["string", "null"]}, "createdAt": {"type": "string"}, "updatedAt": {"type": "string"}, "pauseReason": {"type": ["string", "null"]}, "progress": {"$ref": "#/$defs/TaskProgress"}, "openQuestions": {}}},
    "TaskListReply": {"type": "object", "required": ["tasks"], "properties": {"tasks": {"type": "array", "items": {"$ref": "#/$defs/TaskListItem"}}}},
    "TaskListRequest": {"type": "object", "properties": {"projectId": {"type": "string"}, "state": {"type": "string"}}, "additionalProperties": true},
    "TaskPageReply": {"type": "object", "required": ["tasks", "nextAfter", "counts", "total", "groups"], "properties": {"tasks": {"type": "array", "items": {"$ref": "ops.schema.json#/$defs/ListRow"}}, "nextAfter": {}, "counts": {"type": "object", "additionalProperties": {"type": "integer"}}, "total": {"type": "integer"}, "groups": {"type": "array", "items": {"$ref": "ops.schema.json#/$defs/ListGroup"}}}},
    "TaskPageRequest": {"type": "object", "properties": {"filter": {"$ref": "ops.schema.json#/$defs/ListFilter"}, "group": {"type": "string"}, "groupCounts": {"type": "boolean"}, "limit": {"type": "integer", "minimum": 1}, "after": {"type": "array", "items": {}}}, "additionalProperties": true},
    "TaskProgress": {"type": "object", "required": ["executions", "byState"], "properties": {"executions": {}, "byState": {}}, "$comment": "executions: the count; byState: counts by execution state."},
    "TaskReleaseReply": {"$ref": "#/$defs/TaskDetail"},
    "TaskReleaseRequest": {"type": "object", "required": ["taskId"], "properties": {"taskId": {"type": "string"}}, "additionalProperties": true},
    "TaskRequestAcceptanceReply": {"$ref": "#/$defs/QuestionRow"},
    "TaskRequestAcceptanceRequest": {"type": "object", "required": ["taskId"], "properties": {"taskId": {"type": "string"}, "artifactIds": {"type": "array", "items": {"type": "string"}}, "text": {"type": "string"}}, "additionalProperties": true, "$comment": "No artifactIds: the task's stored originals."},
    "TaskState": {"type": "string", "enum": ["queued", "in_progress", "waiting", "paused", "completed", "failed", "cancelled"], "$comment": "task_state in go/coordinator/schema.sql."},
    "TaskTakeReply": {"$ref": "#/$defs/TaskDetail"},
    "TaskTakeRequest": {"type": "object", "required": ["taskId"], "properties": {"taskId": {"type": "string"}}, "additionalProperties": true},
    "TaskUpdateReply": {"$ref": "#/$defs/TaskDetail"},
    "TaskUpdateRequest": {"type": "object", "required": ["taskId"], "properties": {"taskId": {"type": "string"}, "action": {"type": "string"}, "title": {"type": "string"}, "expectedOutcome": {"type": "string"}, "priority": {"type": "string"}, "resultDestination": {"type": "string"}}, "additionalProperties": true, "$comment": "action pause, resume, cancel or fail (people only); the other fields replace the stored value when present."}
  }
}
