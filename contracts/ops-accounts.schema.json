{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Coordinator operations of the accounts domain; the rules are in ops.schema.json $comment and contracts/README.md.",
  "operations": {
    "access_grant_ask": {"read": false, "errors": [400,403,404,409], "auth": "person", "agent": "tool", "description": "Asks for access to one resource of a project on an access server (docs/designs/fleet-project-access.md): projectId, requestId (the same id reads the grant), server, kind (mysql: scope {database, tables}; files: scope {paths}), level (read; write only when the work needs it), reason. Creates an approval card for the owner that states the exact recipe; once approved Fleet provisions it and probes that read works and, for read, that write fails. Read the state with access_grants; the grant is usable when it is ready."},
    "access_grant_check": {"read": false, "errors": [400,403,404,409], "auth": "person", "agent": "tool", "description": "Probes a ready or failed grant again (grant: its id): read must work, write must fail for a read grant. The probe runs in the background; read the result with access_grants."},
    "access_grant_revoke": {"read": false, "errors": [400,403,404,409], "auth": "owner", "agent": "tool", "description": "Revokes a grant (grant: its id): an asked grant is withdrawn with its card; a provisioned one has its database user, OS user and keys removed on the server and on PDS18, then is revoked."},
    "access_grants": {"read": true, "errors": [400,404], "auth": "person", "agent": "tool", "description": "Access servers and the project resource grants the caller sees (projectId optional): state (asked, provisioning, ready, failed, declined, withdrawn, revoking, revoked), level, scope, the recipe it runs, the last probe and error. Never a credential value."},
    "access_server_add": {"read": false, "long": true, "errors": [400,403,404,409], "auth": "owner", "agent": "tool", "description": "Records a project server Fleet's provisioner may reach (docs/designs/fleet-project-access.md): id (a name such as pds9), address (host or host:port), via (the id of an enrolled jump server, optional). Learns and pins the server's SSH host key (a different key for a known id is 409) and answers enroll: the one command the owner runs as root on that server to install fleet-provision. Grants nothing."},
    "access_server_check": {"read": false, "long": true, "errors": [400,403,404,409], "auth": "person", "agent": "tool", "description": "Checks an access server now: the provisioner logs in and runs fleet-provision version, and lists the server's MySQL database names (names only) for a grant's scope. The first success marks it enrolled. The reply is the server with its check."},
    "access_check": {"read": false, "long": true, "errors": [400,403,404,409], "auth": "person", "agent": "tool", "description": "Checks one access item now, read-only, never starting a login: a connection with one cheap provider call (its reply's reason on failure), a subscription by re-inspecting each host login. id: an access_status item id. The reply is the item as access_status shows it after the check."},
    "access_onboard": {"read": false, "errors": [400,403,404,409], "auth": "person", "agent": "tool", "description": "Starts adding access. kind key: provider (and connection, default the provider's name); creates the connection when missing (owner) and answers where the key comes from; with projectId and requestId it asks the owner for the key under Needs you (the agent path). kind login: accountId, hostId, binding; answers the host login steps and, with projectId and requestId, asks the owner to sign in under Needs you. kind limit: connection and limit {amount, unit, period}: the monthly limit Fleet counts the connection's spend against (a warn budget). Never takes a key value or a login code."},
    "access_status": {"read": true, "errors": [], "auth": "person", "agent": "tool", "changes": ["api-connection", "connection-key", "managed-account", "host", "setting-change"], "description": "Every subscription, model API key and service key Fleet has or offers, one item each: kind, state in plain words (works, failing, needs login on a host, needs a key, not added), limit or credits where known, hosts and users, the last check and the next step with its link. Never key values."},
    "account_connect": {"read": false, "errors": [400,404,409], "auth": "holder:account", "agent": "tool", "description": "Inspects one native login. hostId: default the caller's host; binding: the native login name."},
    "account_create": {"read": false, "errors": [400,403,409], "auth": "person", "agent": "tool", "description": "harness codex, claude, antigravity or acp; holder: the owner may create one for another person."},
    "account_delete": {"read": false, "errors": [403,404,409], "auth": "owner", "agent": "tool", "description": "Owner only. Deletes a subscription account that nothing uses: refused (409, with the reason) while it has a host binding, an inspection, a check or a run that names it. Its own setting history goes with it; an audit row stays. preview true changes nothing and answers whether it would be deleted."},
    "account_discover": {"read": false, "errors": [400,404,409], "auth": "holder:account", "agent": "tool", "description": "Reads the host's native account catalogue. hostId: default the caller's host."},
    "account_hosts": {"read": true, "errors": [], "auth": "holder:account", "agent": "tool", "description": "harness default codex; accountId takes the account's harness."},
    "account_list": {"read": true, "errors": [], "auth": "person", "agent": "tool", "changes": ["host", "managed-account"], "description": "Managed subscription accounts with their inspections, checks and setting history, and each host's native account catalogue"},
    "account_login_handoff": {"read": true, "errors": [409], "auth": "holder:account", "agent": "tool", "description": "What a person runs on a host to log a binding of an account in (accountId, hostId, binding); Fleet changes no authentication itself"},
    "account_update": {"read": false, "errors": [400,403,409], "auth": "holder:account", "agent": "tool", "description": "Holder or owner; switchPct null clears it; take {projects}; holder: owner only."},
    "budget_ask": {"read": false, "errors": [400,404,409], "auth": "person", "agent": "tool", "description": "Asks the owner to raise a budget above its current limit."},
    "budget_delete": {"read": false, "errors": [403,404], "auth": "owner", "agent": "tool", "description": "Owner only."},
    "budget_set": {"read": false, "errors": [400,403], "auth": "owner", "agent": "tool", "description": "Owner only. No id: a new budget. action defaults to warn."},
    "budgets_list": {"read": true, "errors": [], "auth": "person", "agent": "tool", "description": "Budgets with their current spend"},
    "connections_create": {"read": false, "errors": [400,403,409], "auth": "architect", "agent": "tool", "description": "holder: the owner may create a key for another person."},
    "connections_delete": {"read": false, "errors": [400,403,404,409], "auth": "owner", "agent": "tool", "description": "Owner or full-access person (an agent acts with its director's rights). Deletes a connection whose keys are all retired: the connection, its key rows, history and value directory; run tokens drop its name; open key requests for it are withdrawn."},
    "connections_key_add": {"read": false, "errors": [400,403,404,409], "auth": "owner", "agent": "no", "description": "Owner only. The value goes to the secret file; the reply has its fingerprint only. questionId: the open key request (connections_key_request) this value answers with {connection, fingerprint, state}."},
    "connections_key_request": {"read": false, "errors": [400,403,404,409], "auth": "architect", "agent": "tool", "description": "Ask the owner to add an API key: projectId, requestId, connection, reason. Never pass a key value; the owner pastes it into Fleet and the answer (question_history) is only {connection, fingerprint, state} or decline"},
    "connections_key_state": {"read": false, "errors": [400,403,404,409], "auth": "holder:connection", "agent": "tool", "description": "state active, draining or retired."},
    "connections_list": {"read": true, "errors": [], "auth": "architect", "agent": "tool", "changes": ["api-connection", "connection-key", "setting-change"], "description": "Connections visible to the caller: provider, tools, access, intake, limits and key state, never key values"},
    "connections_set_access": {"read": false, "errors": [400,403,404,409], "auth": "holder:connection", "agent": "tool", "description": "access: {people, projects, experiments}, each a list of ids."},
    "connections_set_intake": {"read": false, "errors": [400,403,404,409], "auth": "holder:connection", "agent": "tool", "description": "intake all or paused."},
    "connections_set_key_policy": {"read": false, "errors": [400,403,404,409], "auth": "holder:connection", "agent": "tool", "description": "Holder or owner. keyPolicy replaces the stored key balancing and failover policy as a whole; an omitted field returns to its default."},
    "connections_set_limits": {"read": false, "errors": [400,403,404,409], "auth": "holder:connection", "agent": "tool", "description": "Holder or owner. limits replaces the stored file tool limits as a whole; an omitted field returns to its default; each given value is a positive integer."},
    "connections_set_tools": {"read": false, "errors": [400,403,404], "auth": "owner", "agent": "tool", "description": "Owner-only explicit recognized provider tool grant; does not change people/project/experiment access."},
    "connections_token_create": {"read": false, "errors": [400,403,409], "auth": "owner", "agent": "no", "description": "The owner only (not an agent). The token value is answered once."},
    "connections_token_list": {"read": true, "errors": [], "auth": "architect", "agent": "tool", "description": "Gateway tokens of connections: id, connection, created and revoked, never the token value"},
    "connections_token_revoke": {"read": false, "errors": [400,403,404,409], "auth": "owner", "agent": "tool", "description": "Owner only."},
    "price_add": {"read": false, "errors": [400], "auth": "architect", "agent": "tool", "description": "Record a price observation for a subject and unit (price, currency, source, optional sourceRef, observedAt, effectiveFrom)"},
    "price_refresh": {"read": false, "long": true, "errors": [400,403,409], "auth": "architect", "agent": "tool", "description": "Preview official standard provider API rate changes without writes. Apply a verified preview with its planId. Report provider gaps, proposed changes and appended IDs for prices_list and setting_changes readback."},
    "prices_list": {"read": true, "errors": [], "auth": "person", "agent": "tool", "description": "Recorded prices, optionally of one subject"},
    "subscription_limits": {"read": true, "errors": [], "auth": "person", "agent": "tool", "changes": ["managed-account", "setting-change"], "description": "Subscription limit windows and usage per account: windowHours or from/to, paceMargin"},
    "subscription_limits_refresh": {"read": false, "errors": [403,404], "auth": "person", "agent": "tool", "description": "Read subscription limits now, without a run: one subscription (subscriptionId), or every one the caller holds (the owner: all)"},
    "transport_authorize": {"read": false, "errors": [400,409], "auth": "architect", "agent": "tool", "description": "Exactly these four keys (the request signature is their hash)."},
    "transport_inspect": {"read": true, "errors": [], "auth": "architect", "agent": "tool", "description": "Transport state of an execution's PM conversation (executionId)"}
  },
  "$defs": {
    "AccessServerAddRequest": {"type": "object", "additionalProperties": false, "required": ["id", "address"], "properties": {"id": {"type": "string"}, "address": {"type": "string"}, "via": {"type": "string"}}},
    "AccessServerAddReply": {"$ref": "#/$defs/AccessServerView"},
    "AccessServerCheckRequest": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"type": "string"}}},
    "AccessServerCheckReply": {"$ref": "#/$defs/AccessServerView"},
    "AccessGrantsRequest": {"type": "object", "additionalProperties": false, "properties": {"projectId": {"type": "string"}}},
    "AccessGrantsReply": {"type": "object", "additionalProperties": false, "required": ["servers", "grants"], "properties": {"servers": {"type": "array", "items": {"$ref": "#/$defs/AccessServerView"}}, "grants": {"type": "array", "items": {"$ref": "#/$defs/AccessGrantView"}}}},
    "AccessGrantAskRequest": {"type": "object", "additionalProperties": false, "required": ["projectId", "requestId", "server", "kind", "level", "scope", "reason"], "properties": {"projectId": {"type": "string"}, "requestId": {"type": "string"}, "server": {"type": "string"}, "kind": {"$ref": "#/$defs/AccessKind"}, "level": {"$ref": "#/$defs/AccessLevel"}, "scope": {"$ref": "#/$defs/AccessScope"}, "reason": {"type": "string"}}},
    "AccessGrantAskReply": {"$ref": "#/$defs/AccessGrantView"},
    "AccessGrantCheckRequest": {"type": "object", "additionalProperties": false, "required": ["grant"], "properties": {"grant": {"type": "string"}}},
    "AccessGrantCheckReply": {"$ref": "#/$defs/AccessGrantView"},
    "AccessGrantRevokeRequest": {"type": "object", "additionalProperties": false, "required": ["grant"], "properties": {"grant": {"type": "string"}}},
    "AccessGrantRevokeReply": {"$ref": "#/$defs/AccessGrantView"},
    "AccessKind": {"type": "string", "enum": ["mysql", "files"]},
    "AccessLevel": {"type": "string", "enum": ["read", "write"]},
    "AccessGrantState": {"type": "string", "enum": ["asked", "provisioning", "ready", "failed", "declined", "withdrawn", "revoking", "revoked"]},
    "AccessScope": {"type": "object", "additionalProperties": false, "properties": {"database": {"type": "string"}, "tables": {"type": "array", "items": {"type": "string"}}, "paths": {"type": "array", "items": {"type": "string"}}}, "$comment": "mysql: database and tables; files: absolute paths on the server."},
    "AccessCheckResult": {"type": "object", "additionalProperties": false, "required": ["at", "ok"], "properties": {"at": {"type": "integer"}, "ok": {"type": "boolean"}, "version": {"type": "string"}, "error": {"type": "string"}, "steps": {"type": "array", "items": {"type": "string"}}, "databases": {"type": "array", "items": {"type": "string"}, "$comment": "A server check: the MySQL database names on the server (fleet-provision 2), for a grant's scope."}}},
    "AccessServerView": {"type": "object", "additionalProperties": false, "required": ["id", "address"], "properties": {"id": {"type": "string"}, "address": {"type": "string"}, "via": {"type": "string"}, "hostKey": {"type": "string"}, "enrolledAt": {"type": "integer"}, "checked": {"$ref": "#/$defs/AccessCheckResult"}, "enroll": {"type": "string", "$comment": "The command the owner runs as root on the server (access_server_add only)."}}},
    "AccessGrantView": {"type": "object", "additionalProperties": false, "required": ["id", "projectId", "server", "kind", "level", "state", "requestId", "askedBy", "scope", "reason", "recipe", "user", "createdAt"], "properties": {"id": {"type": "string"}, "projectId": {"type": "string"}, "server": {"type": "string"}, "kind": {"$ref": "#/$defs/AccessKind"}, "level": {"$ref": "#/$defs/AccessLevel"}, "state": {"$ref": "#/$defs/AccessGrantState"}, "requestId": {"type": "string"}, "askedBy": {"type": "string"}, "questionId": {"type": "string"}, "credential": {"type": "string", "$comment": "Fingerprint only."}, "expiresAt": {"type": "integer"}, "scope": {"$ref": "#/$defs/AccessScope"}, "reason": {"type": "string"}, "recipe": {"type": "array", "items": {"type": "string"}, "$comment": "What the provisioner runs on the server, as the card shows it."}, "user": {"type": "string", "$comment": "The OS user agents log in as on the server."}, "connection": {"type": "string", "$comment": "The connection that serves a ready grant (<project>-mysql or <project>-files): its tools reach the resource through fleet-gateway."}, "probe": {"$ref": "#/$defs/AccessCheckResult"}, "error": {"type": "string"}, "createdAt": {"type": "integer"}}},
    "AccountConnectReply": {"$ref": "#/$defs/AccountInspection"},
    "AccountConnectRequest": {"unevaluatedProperties": false, "type": "object", "required": ["accountId", "binding"], "properties": {"accountId": {"type": "string"}, "hostId": {"type": "string"}, "binding": {"type": "string"}}, "additionalProperties": false, "$comment": "Inspects one native login. hostId: default the caller's host; binding: the native login name."},
    "AccountCreateReply": {"type": "object", "additionalProperties": true, "$comment": "A managed-account record: id, name, harness, holder, kind, plan, intake, take, switchPct, comment, bindings and times."},
    "AccountCreateRequest": {"unevaluatedProperties": false, "type": "object", "required": ["name", "harness"], "properties": {"name": {"type": "string"}, "harness": {"type": "string"}, "holder": {"type": "string"}, "plan": {"type": "string"}, "comment": {"type": "string"}}, "additionalProperties": false, "$comment": "harness codex, claude, antigravity or acp; holder: the owner may create one for another person."},
    "AccountDiscoverReply": {"$ref": "#/$defs/AccountInspection"},
    "AccountDiscoverRequest": {"unevaluatedProperties": false, "type": "object", "required": ["accountId"], "properties": {"accountId": {"type": "string"}, "hostId": {"type": "string"}}, "additionalProperties": false, "$comment": "Reads the host's native account catalogue. hostId: default the caller's host."},
    "AccountHostsReply": {"type": "object", "required": ["hosts"], "properties": {"hosts": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "A host that can run the harness."}}}},
    "AccountHostsRequest": {"type": "object", "properties": {"harness": {"type": "string"}, "accountId": {"type": "string"}}, "additionalProperties": true, "$comment": "harness default codex; accountId takes the account's harness."},
    "AccountInspection": {"type": "object", "required": ["id", "accountId", "hostId", "binding", "executionId", "createdAt"], "properties": {"id": {"type": "string"}, "accountId": {"type": "string"}, "hostId": {"type": "string"}, "binding": {"type": ["string", "null"]}, "executionId": {"type": "string"}, "createdAt": {"type": "number"}, "loginAction": {"type": "string"}}, "$comment": "A read-only native inspection queued on a host; an identical one still pending is answered instead of a new one."},
    "ManagedAccount": {"type": "object", "additionalProperties": true, "required": ["id", "name"], "$comment": "A managed-account record with its inspections, checks and setting history.", "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "harness": {"type": "string"}, "intake": {"type": "string"}}},
    "AccountListReply": {"type": "object", "required": ["catalogues", "accounts"], "properties": {"catalogues": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "A host's native account catalogue."}}, "accounts": {"type": "array", "items": {"$ref": "#/$defs/ManagedAccount"}}}},
    "AccountListRequest": {"type": "object", "additionalProperties": true},
    "AccountLoginHandoffReply": {"type": "object", "required": ["observedAt", "basedOnCheckAt", "hostId", "binding", "environment", "executable", "command", "requiredUserInteraction", "warning", "quota", "authChanged"], "properties": {"observedAt": {"type": "integer"}, "basedOnCheckAt": {}, "hostId": {"type": "string"}, "binding": {}, "environment": {}, "executable": {}, "command": {}, "requiredUserInteraction": {}, "warning": {}, "quota": {"type": "string"}, "authChanged": {"type": "boolean"}}, "$comment": "What a person runs to log the binding in; Fleet changes no authentication itself."},
    "AccountLoginHandoffRequest": {"type": "object", "required": ["accountId", "hostId"], "properties": {"accountId": {"type": "string"}, "hostId": {"type": "string"}, "binding": {"type": "string"}}, "additionalProperties": true},
    "AccountUpdateReply": {"type": "object", "additionalProperties": true, "$comment": "A managed-account record: id, name, harness, holder, kind, plan, intake, take, switchPct, comment, bindings and times."},
    "AccountUpdateRequest": {"type": "object", "required": ["accountId"], "properties": {"accountId": {"type": "string"}, "intake": {"$ref": "#/$defs/Intake"}, "switchPct": {"type": ["number", "null"]}, "take": {}, "holder": {"type": "string"}, "plan": {"type": "string"}, "comment": {"type": "string"}, "planWeight": {"$comment": "plan size relative to a base plan (default 1)", "type": "number"}, "lowPct": {"$comment": "warn when left falls below this percent in any period; null is off (default)", "type": ["number", "null"]}}, "additionalProperties": true, "$comment": "Holder or owner; switchPct null clears it; take {projects}; holder: owner only."},
    "Budget": {"type": "object", "required": ["id", "scope", "scopeId", "unit", "limit", "period", "action", "setBy", "setAt"], "properties": {"id": {"type": "string"}, "scope": {"type": "string"}, "scopeId": {"type": "string"}, "unit": {"type": "string"}, "limit": {"type": "number"}, "period": {"type": ["string", "null"]}, "action": {"type": "string"}, "setBy": {"type": "string"}, "setAt": {"type": "string"}, "spend": {"$ref": "#/$defs/BudgetSpend"}}, "$comment": "scope person, project, experiment or connection; action warn, pause or stop; period day, week, month or null (all time). spend only in budgets_list."},
    "BudgetAskReply": {"type": "object", "required": ["questionId"], "properties": {"questionId": {"type": "string"}}},
    "BudgetAskRequest": {"type": "object", "required": ["budgetId", "limit"], "properties": {"budgetId": {"type": "string"}, "limit": {"type": "number"}, "reason": {"type": "string"}}, "additionalProperties": true, "$comment": "Asks the owner to raise a budget above its current limit."},
    "BudgetDeleteReply": {"type": "object", "required": ["id", "deleted"], "properties": {"id": {"type": "string"}, "deleted": {"type": "boolean"}}},
    "BudgetDeleteRequest": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}, "additionalProperties": true, "$comment": "Owner only."},
    "BudgetSetReply": {"$ref": "#/$defs/Budget"},
    "BudgetSetRequest": {"type": "object", "required": ["scope", "scopeId", "unit", "limit"], "properties": {"id": {"type": "string"}, "scope": {"type": "string"}, "scopeId": {"type": "string"}, "unit": {"type": "string"}, "limit": {"type": "number"}, "period": {"type": ["string", "null"]}, "action": {"type": "string"}}, "additionalProperties": true, "$comment": "Owner only. No id: a new budget. action defaults to warn."},
    "BudgetSpend": {"type": "object", "required": ["value", "basis"], "properties": {"value": {"type": ["number", "null"]}, "basis": {"type": "string"}}, "$comment": "basis measured (value is the spend in the budget's unit and period) or unverifiable (value null)."},
    "BudgetsListReply": {"type": "object", "required": ["budgets"], "properties": {"budgets": {"type": "array", "items": {"$ref": "#/$defs/Budget"}}}},
    "BudgetsListRequest": {"type": "object", "additionalProperties": true},
    "CommandRef": {"type": "object", "required": ["id", "kind", "status"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "status": {"type": "string"}}},
    "ConnectionAccess": {"unevaluatedProperties": false, "type": "object", "properties": {"people": {"type": "array", "items": {"type": "string"}}, "projects": {"type": "array", "items": {"type": "string"}}, "experiments": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false, "$comment": "Who besides the holder may use the API key: people (emails), projects and experiments."},
    "ConnectionKey": {"type": "object", "required": ["id", "fingerprint", "state", "addedAt"], "properties": {"id": {"type": "string"}, "connectionId": {"type": "string"}, "fingerprint": {"type": "string"}, "state": {"type": "string", "$comment": "active, draining, disabled or retired"}, "addedAt": {"type": "number"}, "addedBy": {"type": "string"}, "disabledReason": {"type": "string"}, "disabledAt": {"type": "number"}, "problem": {"$ref": "#/$defs/ConnectionKeyProblem"}, "reconcile": {"$ref": "#/$defs/ConnectionKeyReconcile"}}, "additionalProperties": true, "$comment": "A key row: fingerprint, state and times; never the value."},
    "ConnectionKeyProblem": {"type": "object", "required": ["status", "message"], "properties": {"status": {"type": "number"}, "message": {"type": "string"}, "at": {}}, "additionalProperties": true, "$comment": "The provider's last refusal of this key."},
    "ConnectionKeyReconcile": {"type": "object", "properties": {"at": {}, "providerDelta": {"type": "number"}, "recorded": {"type": "number"}, "difference": {"type": "number"}, "unknown": {"type": "string"}}, "additionalProperties": true, "$comment": "Provider usage since the first check against credits Fleet recorded; unknown: why the provider reported no usage."},
    "ConnectionSpend": {"type": "object", "required": ["basis"], "properties": {"basis": {"type": "string"}}, "additionalProperties": true},
    "ConnectionView": {"type": "object", "required": ["id", "name", "provider", "holder", "access", "intake", "comment", "createdAt"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "provider": {"type": "string"}, "holder": {"type": "string"}, "access": {"$ref": "#/$defs/ConnectionAccess"}, "intake": {"type": "string"}, "limits": {"$ref": "gateway.schema.json#/$defs/GatewayLimits"}, "keyPolicy": {"$ref": "gateway.schema.json#/$defs/GatewayKeyPolicy"}, "tools": {"type": "array", "items": {"type": "string"}}, "comment": {"type": "string"}, "createdAt": {"type": "number"}, "updatedAt": {"type": "number"}, "keys": {"type": "array", "items": {"$ref": "#/$defs/ConnectionKey"}}, "spend": {"$ref": "#/$defs/ConnectionSpend"}, "history": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "A setting change of this connection."}}}, "$comment": "An API connection; keys, spend and history only in connections_list."},
    "ConnectionsCreateReply": {"$ref": "#/$defs/ConnectionView"},
    "ConnectionsCreateRequest": {"unevaluatedProperties": false, "type": "object", "required": ["name", "provider"], "properties": {"name": {"type": "string"}, "provider": {"type": "string"}, "holder": {"type": "string"}, "comment": {"type": "string"}}, "additionalProperties": false, "$comment": "holder: the owner may create a key for another person."},
    "ConnectionsDeleteReply": {"type": "object", "required": ["name", "deleted"], "properties": {"name": {"type": "string"}, "deleted": {"type": "boolean"}}},
    "ConnectionsDeleteRequest": {"type": "object", "required": ["connection"], "properties": {"connection": {"type": "string"}}, "additionalProperties": false, "$comment": "Owner or full-access person (not agents). Deletes a connection whose keys are all retired: the connection, its key rows, history and value directory; run tokens drop its name; open key requests for it are withdrawn."},
    "ConnectionsKeyAddReply": {"type": "object", "additionalProperties": true, "$comment": "The new key row (fingerprint, state, addedAt, addedBy); never the value."},
    "ConnectionsKeyAddRequest": {"type": "object", "required": ["connection", "value"], "properties": {"connection": {"type": "string"}, "value": {"type": "string"}, "questionId": {"type": "string"}}, "additionalProperties": true, "$comment": "Owner only. The value goes to the secret file; the reply has its fingerprint only. questionId: the open key request (connections_key_request) this value answers with {connection, fingerprint, state}."},
    "ConnectionsKeyRequestReply": {"$ref": "ops-tasks.schema.json#/$defs/ProjectQuestion", "$comment": "The key request question; once answered, answer is the JSON text {connection, fingerprint, state}."},
    "ConnectionsKeyRequestRequest": {"unevaluatedProperties": false, "type": "object", "required": ["projectId", "requestId", "connection"], "properties": {"projectId": {"type": "string"}, "requestId": {"type": "string"}, "connection": {"type": "string"}, "reason": {"type": "string"}}, "additionalProperties": false, "$comment": "An agent asks the owner for a key value of connection. No argument carries a value; the owner answers through connections_key_add with questionId."},
