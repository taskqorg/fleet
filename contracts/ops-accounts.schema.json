{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Coordinator operations of the accounts domain; the rules are in ops.schema.json $comment and contracts/README.md.",
  "operations": {
    "account_connect": {"read": false, "errors": [400, 404, 409]},
    "account_create": {"read": false, "errors": [400, 403, 409]},
    "account_discover": {"read": false, "errors": [400, 404, 409]},
    "account_hosts": {"read": true, "errors": []},
    "account_list": {"read": true, "errors": []},
    "account_login_handoff": {"read": true, "errors": [409]},
    "account_update": {"read": false, "errors": [400, 403, 409]},
    "budget_ask": {"read": false, "errors": [400, 404, 409]},
    "budget_delete": {"read": false, "errors": [403, 404]},
    "budget_set": {"read": false, "errors": [400, 403]},
    "budgets_list": {"read": true, "errors": []},
    "connections_create": {"read": false, "errors": [400, 403, 409]},
    "connections_key_add": {"read": false, "errors": [400, 403, 404, 409]},
    "connections_key_state": {"read": false, "errors": [400, 403, 404, 409]},
    "connections_list": {"read": true, "errors": []},
    "connections_set_access": {"read": false, "errors": [400, 403, 404, 409]},
    "connections_set_intake": {"read": false, "errors": [400, 403, 404, 409]},
    "connections_token_create": {"read": false, "errors": [400, 403, 409]},
    "connections_token_list": {"read": true, "errors": []},
    "connections_token_revoke": {"read": false, "errors": [400, 403, 404, 409]},
    "price_add": {"read": false, "errors": [400]},
    "prices_list": {"read": true, "errors": []},
    "subscription_limits": {"read": true, "errors": []},
    "subscription_limits_refresh": {"read": false, "errors": [403, 404]},
    "transport_authorize": {"read": false, "errors": [400, 409]},
    "transport_inspect": {"read": true, "errors": []}
  },
  "$defs": {
    "AccountConnectReply": {"$ref": "#/$defs/AccountInspection"},
    "AccountConnectRequest": {"type": "object", "required": ["accountId", "binding"], "properties": {"accountId": {"type": "string"}, "hostId": {"type": "string"}, "binding": {"type": "string"}}, "additionalProperties": true, "$comment": "Inspects one native login. hostId: default the caller's host; binding: the native login name."},
    "AccountCreateReply": {"type": "object", "additionalProperties": true, "$comment": "A managed-account record: id, name, harness, holder, kind, plan, intake, take, switchPct, comment, bindings and times."},
    "AccountCreateRequest": {"type": "object", "required": ["name", "harness"], "properties": {"name": {"type": "string"}, "harness": {"type": "string"}, "holder": {"type": "string"}, "plan": {"type": "string"}, "comment": {"type": "string"}}, "additionalProperties": true, "$comment": "harness codex, claude, antigravity or acp; holder: the owner may create one for another person."},
    "AccountDiscoverReply": {"$ref": "#/$defs/AccountInspection"},
    "AccountDiscoverRequest": {"type": "object", "required": ["accountId"], "properties": {"accountId": {"type": "string"}, "hostId": {"type": "string"}}, "additionalProperties": true, "$comment": "Reads the host's native account catalogue. hostId: default the caller's host."},
    "AccountHostsReply": {"type": "object", "required": ["hosts"], "properties": {"hosts": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "A host that can run the harness."}}}},
    "AccountHostsRequest": {"type": "object", "properties": {"harness": {"type": "string"}, "accountId": {"type": "string"}}, "additionalProperties": true, "$comment": "harness default codex; accountId takes the account's harness."},
    "AccountInspection": {"type": "object", "required": ["id", "accountId", "hostId", "binding", "executionId", "createdAt"], "properties": {"id": {"type": "string"}, "accountId": {"type": "string"}, "hostId": {"type": "string"}, "binding": {"type": ["string", "null"]}, "executionId": {"type": "string"}, "createdAt": {"type": "number"}, "loginAction": {"type": "string"}}, "$comment": "A read-only native inspection queued on a host; an identical one still pending is answered instead of a new one."},
    "AccountListReply": {"type": "object", "required": ["catalogues", "accounts"], "properties": {"catalogues": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "A host's native account catalogue."}}, "accounts": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "A managed-account record with its inspections, checks and setting history."}}}},
    "AccountListRequest": {"type": "object", "additionalProperties": true},
    "AccountLoginHandoffReply": {"type": "object", "required": ["observedAt", "basedOnCheckAt", "hostId", "binding", "environment", "executable", "command", "requiredUserInteraction", "warning", "quota", "authChanged"], "properties": {"observedAt": {"type": "integer"}, "basedOnCheckAt": {}, "hostId": {"type": "string"}, "binding": {}, "environment": {}, "executable": {}, "command": {}, "requiredUserInteraction": {}, "warning": {}, "quota": {"type": "string"}, "authChanged": {"type": "boolean"}}, "$comment": "What a person runs to log the binding in; Fleet changes no authentication itself."},
    "AccountLoginHandoffRequest": {"type": "object", "required": ["accountId", "hostId"], "properties": {"accountId": {"type": "string"}, "hostId": {"type": "string"}, "binding": {"type": "string"}}, "additionalProperties": true},
    "AccountUpdateReply": {"type": "object", "additionalProperties": true, "$comment": "A managed-account record: id, name, harness, holder, kind, plan, intake, take, switchPct, comment, bindings and times."},
    "AccountUpdateRequest": {"type": "object", "required": ["accountId"], "properties": {"accountId": {"type": "string"}, "intake": {"type": "string"}, "switchPct": {"type": ["number", "null"]}, "take": {}, "holder": {"type": "string"}, "plan": {"type": "string"}, "comment": {"type": "string"}, "planWeight": {"$comment": "plan size relative to a base plan (default 1)", "type": "number"}, "lowPct": {"$comment": "warn when left falls below this percent in any period; null is off (default)", "type": ["number", "null"]}}, "additionalProperties": true, "$comment": "Holder or owner; switchPct null clears it; take {projects}; holder: owner only."},
    "Budget": {"type": "object", "required": ["id", "scope", "scopeId", "unit", "limit", "period", "action", "setBy", "setAt"], "properties": {"id": {"type": "string"}, "scope": {"type": "string"}, "scopeId": {"type": "string"}, "unit": {"type": "string"}, "limit": {"type": "number"}, "period": {"type": ["string", "null"]}, "action": {"type": "string"}, "setBy": {"type": "string"}, "setAt": {"type": "string"}, "spend": {"$ref": "#/$defs/BudgetSpend"}}, "$comment": "scope person, project, experiment or connection; action warn, pause or stop; period day, week, month or null (all time). spend only in budgets_list."},
    "BudgetAskReply": {"type": "object", "required": ["questionId"], "properties": {"questionId": {"type": "string"}}},
    "BudgetAskRequest": {"type": "object", "required": ["budgetId", "limit"], "properties": {"budgetId": {"type": "string"}, "limit": {"type": "number"}, "reason": {"type": "string"}}, "additionalProperties": true, "$comment": "Asks the owner to raise a budget above its current limit."},
    "BudgetDeleteReply": {"type": "object", "required": ["id", "deleted"], "properties": {"id": {"type": "string"}, "deleted": {"type": "boolean"}}},
    "BudgetDeleteRequest": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}, "additionalProperties": true, "$comment": "Owner only."},
    "BudgetSetReply": {"$ref": "#/$defs/Budget"},
    "BudgetSetRequest": {"type": "object", "required": ["scope", "scopeId", "unit", "limit"], "properties": {"id": {"type": "string"}, "scope": {"type": "string"}, "scopeId": {"type": "string"}, "unit": {"type": "string"}, "limit": {"type": "number"}, "period": {"type": ["string", "null"]}, "action": {"type": "string"}}, "additionalProperties": true, "$comment": "Owner only. No id: a new budget. action defaults to warn."},
    "BudgetSpend": {"type": "object", "required": ["value", "basis"], "properties": {"value": {"type": ["number", "null"]}, "basis": {"type": "string"}}, "$comment": "basis measured (value is the spend in the budget's unit and period) or unverifiable (value null)."},
    "BudgetsListReply": {"type": "object", "required": ["budgets"], "properties": {"budgets": {"type": "array", "items": {"$ref": "#/$defs/Budget"}}}},
    "BudgetsListRequest": {"type": "object", "additionalProperties": true},
    "CommandRef": {"type": "object", "required": ["id", "kind", "status"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "status": {"type": "string"}}},
    "ConnectionAccess": {"type": "object", "properties": {"people": {"type": "array", "items": {"type": "string"}}, "projects": {"type": "array", "items": {"type": "string"}}, "experiments": {"type": "array", "items": {"type": "string"}}}, "$comment": "Who besides the holder may use the API key: people (emails), projects and experiments."},
    "ConnectionView": {"type": "object", "required": ["id", "name", "provider", "holder", "access", "intake", "comment", "createdAt"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "provider": {"type": "string"}, "holder": {"type": "string"}, "access": {"$ref": "#/$defs/ConnectionAccess"}, "intake": {"type": "string"}, "tools": {"type": "array", "items": {"type": "string"}}, "comment": {"type": "string"}, "createdAt": {"type": "number"}, "updatedAt": {"type": "number"}, "keys": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "A key row: fingerprint, state (active, draining, disabled, retired) and times; never the value."}}, "spend": {"type": "object", "additionalProperties": true}, "history": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "A setting change of this connection."}}}, "$comment": "An API connection; keys, spend and history only in connections_list."},
    "ConnectionsCreateReply": {"$ref": "#/$defs/ConnectionView"},
    "ConnectionsCreateRequest": {"type": "object", "required": ["name", "provider"], "properties": {"name": {"type": "string"}, "provider": {"type": "string"}, "holder": {"type": "string"}, "comment": {"type": "string"}}, "additionalProperties": true, "$comment": "holder: the owner may create a key for another person."},
    "ConnectionsKeyAddReply": {"type": "object", "additionalProperties": true, "$comment": "The new key row (fingerprint, state, addedAt, addedBy); never the value."},
    "ConnectionsKeyAddRequest": {"type": "object", "required": ["connection", "value"], "properties": {"connection": {"type": "string"}, "value": {"type": "string"}}, "additionalProperties": true, "$comment": "Owner only. The value goes to the secret file; the reply has its fingerprint only."},
    "ConnectionsKeyStateReply": {"type": "object", "additionalProperties": true, "$comment": "The key row after the change."},
    "ConnectionsKeyStateRequest": {"type": "object", "required": ["keyId", "state"], "properties": {"keyId": {"type": "string"}, "state": {"type": "string"}}, "additionalProperties": true, "$comment": "state active, draining or retired."},
    "ConnectionsListReply": {"type": "object", "required": ["providers", "connections"], "properties": {"providers": {"type": "object", "additionalProperties": true, "$comment": "The provider catalogue by provider id."}, "connections": {"type": "array", "items": {"$ref": "#/$defs/ConnectionView"}}}},
    "ConnectionsListRequest": {"type": "object", "additionalProperties": true},
    "ConnectionsSetAccessReply": {"$ref": "#/$defs/ConnectionView"},
    "ConnectionsSetAccessRequest": {"type": "object", "required": ["connection", "access"], "properties": {"connection": {"type": "string"}, "access": {}}, "additionalProperties": true, "$comment": "access: {people, projects, experiments}, each a list of ids."},
    "ConnectionsSetIntakeReply": {"$ref": "#/$defs/ConnectionView"},
    "ConnectionsSetIntakeRequest": {"type": "object", "required": ["connection", "intake"], "properties": {"connection": {"type": "string"}, "intake": {"type": "string"}}, "additionalProperties": true, "$comment": "intake all or paused."},
    "ConnectionsTokenCreateReply": {"type": "object", "required": ["name", "token"], "properties": {"name": {"type": "string"}, "token": {"type": ["string", "null"]}, "refused": {"type": "array", "items": {"type": "string"}}, "connections": {"type": "array", "items": {"type": "object", "additionalProperties": true}}}, "$comment": "token: the bearer value, shown once; refused: requested connections the owner cannot use."},
    "ConnectionsTokenCreateRequest": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "connections": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true, "$comment": "The owner only (not an agent). The token value is answered once."},
    "ConnectionsTokenListReply": {"type": "object", "required": ["tokens"], "properties": {"tokens": {"type": "array", "items": {"$ref": "#/$defs/TokenInfo"}}}},
    "ConnectionsTokenListRequest": {"type": "object", "additionalProperties": true},
    "ConnectionsTokenRevokeReply": {"type": "object", "required": ["name", "revoked"], "properties": {"name": {"type": "string"}, "revoked": {"type": "boolean"}}},
    "ConnectionsTokenRevokeRequest": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}}, "additionalProperties": true, "$comment": "Owner only."},
    "LimitEmpty": {"type": "object", "additionalProperties": false, "required": ["state", "at"], "properties": {"state": {"$ref": "#/$defs/LimitEmptyState"}, "at": {"type": ["integer", "null"]}}, "$comment": "when a line reaches 0: at a time, not before the line ends, or unknown"},
    "LimitEmptyState": {"type": "string", "enum": ["at", "not-before-end", "unknown"]},
    "LimitPace": {"type": "string", "enum": ["ahead", "on", "under", "unknown"]},
    "LimitPeriod": {"type": "object", "additionalProperties": false, "required": ["period", "pct", "left", "status", "resetsAt", "readingAt", "source", "burn", "pace", "low", "firstEmpty", "history", "projection"], "properties": {"period": {"type": "string"}, "pct": {"type": ["number", "null"]}, "left": {"type": ["number", "null"]}, "status": {"type": ["string", "null"]}, "resetsAt": {"type": ["integer", "null"]}, "readingAt": {"type": ["integer", "null"]}, "source": {"type": "string"}, "burn": {"$comment": "points per hour over the window; null with fewer than two readings", "type": ["number", "null"]}, "pace": {"$ref": "#/$defs/LimitPace"}, "low": {"type": "boolean"}, "firstEmpty": {"$ref": "#/$defs/LimitEmpty"}, "history": {"type": "array", "items": {"$ref": "#/$defs/LimitPoint"}}, "projection": {"type": "array", "items": {"$ref": "#/$defs/LimitPoint"}}}, "$comment": "one (subscription, period): the latest reading, its history and its projection (fleet-people-access.md section 8)"},
    "LimitPoint": {"type": "object", "additionalProperties": false, "required": ["at", "left"], "properties": {"at": {"type": "integer"}, "left": {"type": "number"}}, "$comment": "left in percent of the member (or weighted points for a pool) at a time"},
    "LimitPool": {"type": "object", "additionalProperties": false, "required": ["harness", "period", "capacity", "left", "leftPct", "burn", "members", "unknown", "projection", "firstEmpty", "poolEmpty", "nextReset"], "properties": {"harness": {"type": "string"}, "period": {"type": "string"}, "capacity": {"type": "number"}, "left": {"type": "number"}, "leftPct": {"type": ["number", "null"]}, "burn": {"type": ["number", "null"]}, "members": {"type": "array", "items": {"type": "string"}}, "unknown": {"$comment": "members without a known, unexpired percent, listed beside the pool", "type": "array", "items": {"type": "string"}}, "projection": {"type": "array", "items": {"$ref": "#/$defs/LimitPoint"}}, "firstEmpty": {"$ref": "#/$defs/LimitEmpty"}, "poolEmpty": {"$ref": "#/$defs/LimitEmpty"}, "nextReset": {"$ref": "#/$defs/LimitReset"}}, "$comment": "per harness and period over members with a known percent, weighted by planWeight"},
    "LimitRefreshSent": {"type": "object", "additionalProperties": false, "required": ["subscriptionId", "hostId", "binding", "executionId"], "properties": {"subscriptionId": {"type": "string"}, "hostId": {"type": "string"}, "binding": {"type": "string"}, "executionId": {"type": "string"}}},
    "LimitRefreshSkipped": {"type": "object", "additionalProperties": false, "required": ["subscriptionId", "reason"], "properties": {"subscriptionId": {"type": "string"}, "reason": {"type": "string"}}},
    "LimitReset": {"type": "object", "additionalProperties": false, "required": ["at", "restore"], "properties": {"at": {"type": ["integer", "null"]}, "restore": {"type": ["number", "null"]}}, "$comment": "earliest member reset and the weighted points it adds back"},
    "LimitSubscription": {"type": "object", "additionalProperties": false, "required": ["id", "name", "harness", "holder", "intake", "switchPct", "planWeight", "lowPct", "readings", "periods"], "properties": {"id": {"type": "string"}, "name": {}, "harness": {"type": "string"}, "holder": {}, "intake": {}, "switchPct": {"type": ["number", "null"]}, "planWeight": {"type": "number"}, "lowPct": {"type": ["number", "null"]}, "readings": {"$comment": "the latest reading per period (dispatch's view)", "type": "array", "items": {"$ref": "#/$defs/SubscriptionReading"}}, "periods": {"type": "array", "items": {"$ref": "#/$defs/LimitPeriod"}}}},
    "PriceAddReply": {"$ref": "#/$defs/PriceEntry"},
    "PriceAddRequest": {"type": "object", "required": ["subject", "unit", "price", "currency", "source"], "properties": {"subject": {"type": "string", "$comment": "A resolved model ID or <connection>/<tool>."}, "unit": {"type": "string"}, "price": {"type": "number", "$comment": "Per one unit."}, "currency": {"type": "string"}, "source": {"type": "string", "$comment": "vendor | snapshot | owner"}, "sourceRef": {"type": "string"}, "observedAt": {"type": "integer"}, "effectiveFrom": {"type": "integer"}}},
    "PriceEntry": {"type": "object", "required": ["id", "subject", "unit", "price", "currency", "source", "observedAt", "effectiveFrom"], "properties": {"id": {"type": "string"}, "subject": {"type": "string"}, "unit": {"type": "string"}, "price": {"type": "number"}, "currency": {"type": "string"}, "source": {"type": "string"}, "sourceRef": {"type": ["string", "null"]}, "observedAt": {"type": "integer"}, "effectiveFrom": {"type": "integer"}, "createdBy": {"type": ["string", "null"]}}, "$comment": "docs/designs/fleet-analytics.md, Price table. Append-only."},
    "PricesListReply": {"type": "object", "required": ["prices"], "properties": {"prices": {"type": "array", "items": {"$ref": "#/$defs/PriceEntry"}}}},
    "PricesListRequest": {"type": "object", "properties": {"subject": {"type": "string"}}},
    "SubscriptionLimitsRefreshReply": {"type": "object", "additionalProperties": false, "required": ["sent", "skipped"], "properties": {"sent": {"type": "array", "items": {"$ref": "#/$defs/LimitRefreshSent"}}, "skipped": {"type": "array", "items": {"$ref": "#/$defs/LimitRefreshSkipped"}}}},
    "SubscriptionLimitsRefreshRequest": {"$comment": "fleet-people-access.md section 8 \"Read without a run\": one subscription, or every one the caller holds (the owner: all)", "type": "object", "additionalProperties": false, "required": [], "properties": {"subscriptionId": {"type": "string"}}},
    "SubscriptionLimitsReply": {"type": "object", "additionalProperties": false, "required": ["serverNow", "windowHours", "from", "to", "subscriptions", "pools"], "properties": {"serverNow": {"type": "integer"}, "windowHours": {"type": "number"}, "from": {"type": "integer"}, "to": {"type": "integer"}, "subscriptions": {"type": "array", "items": {"$ref": "#/$defs/LimitSubscription"}}, "pools": {"type": "array", "items": {"$ref": "#/$defs/LimitPool"}}}},
    "SubscriptionLimitsRequest": {"type": "object", "additionalProperties": false, "required": [], "properties": {"windowHours": {"$comment": "burn window, hours (screen: 1, 3 or 6; default 3)", "type": "number"}, "from": {"$comment": "history start, ms (default 7 days back)", "type": "integer"}, "to": {"$comment": "projection end, ms (default 7 days ahead)", "type": "integer"}, "paceMargin": {"$comment": "pace margin in points (default 5)", "type": "number"}}},
    "SubscriptionReading": {"type": "object", "required": ["period", "pct", "status", "resetsAt", "at", "hostId", "state"], "properties": {"period": {"type": "string"}, "pct": {"type": ["number", "null"]}, "status": {"type": ["string", "null"]}, "resetsAt": {"type": ["number", "null"]}, "at": {"type": "integer"}, "hostId": {"type": ["string", "null"]}, "state": {"type": "string"}}},
    "TokenInfo": {"type": "object", "required": ["name", "connections", "createdAt", "revokedAt", "directedBy"], "properties": {"name": {"type": "string"}, "connections": {}, "createdAt": {}, "revokedAt": {}, "directedBy": {}}},
    "TransportAuthorizeReply": {"$ref": "#/$defs/TransportInspectReply", "$comment": "The transport after the authorization."},
    "TransportAuthorizeRequest": {"type": "object", "required": ["conflictId", "executionId", "frameSha256", "requestId"], "properties": {"conflictId": {"type": "string"}, "executionId": {"type": "string"}, "frameSha256": {"type": "string"}, "requestId": {"type": "string"}}, "$comment": "Exactly these four keys (the request signature is their hash)."},
    "TransportInspectReply": {"type": "object", "required": ["executionId", "hostId", "state", "error", "hostJournal", "nativeOutcome", "commands", "eventCount", "results", "conflicts", "audit", "resend"], "properties": {"executionId": {"type": "string"}, "hostId": {"type": ["string", "null"]}, "state": {"type": "string"}, "error": {}, "hostJournal": {"type": "string"}, "nativeOutcome": {"type": "string"}, "commands": {"type": "array", "items": {"$ref": "#/$defs/CommandRef"}}, "eventCount": {"type": "integer"}, "results": {"type": "array", "items": {"type": "object", "additionalProperties": true}}, "conflicts": {"type": "array", "items": {"type": "object", "additionalProperties": true}}, "audit": {"type": "array", "items": {"type": "object", "additionalProperties": true}}, "resend": {"type": "string"}}, "$comment": "Retained transport of one execution; never reruns native work."},
    "TransportInspectRequest": {"type": "object", "additionalProperties": true, "properties": {"executionId": {"type": "string"}}}
  }
}
