{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Coordinator operations of the executions domain; the rules are in ops.schema.json $comment and contracts/README.md.",
  "operations": {
    "execution_differences": {"read": true, "errors": [403, 409, 503]},
    "execution_events": {"read": true, "errors": []},
    "execution_status": {"read": true, "errors": [400]},
    "execution_stop": {"read": false, "errors": [409]},
    "executions_list": {"read": true, "errors": []},
    "hosts_list": {"read": true, "errors": []},
    "hosts_register": {"read": false, "errors": [400, 403, 409]},
    "hosts_rotate_secret": {"read": false, "errors": [400, 403, 404, 409]},
    "hosts_update": {"read": false, "errors": [400, 403, 404, 409]},
    "pipeline_get": {"read": true, "errors": [400, 403]},
    "pipeline_history": {"read": true, "errors": [404]},
    "pipeline_rerun": {"read": false, "errors": [400, 403, 404, 409], "long": true},
    "pipeline_run": {"read": false, "long": true, "errors": []},
    "pipeline_run_create": {"read": false, "errors": [400, 403, 404, 409], "long": true},
    "queue_list": {"read": true, "errors": []},
    "route_decisions": {"read": true, "errors": [400]}
  },
  "planned": {

  },
  "$defs": {
    "DiffFile": {"type": "object", "required": ["path", "state"], "properties": {"path": {"type": "string"}, "state": {"type": "string"}, "textChange": {"$ref": "#/$defs/TextChange"}, "previous": {"$ref": "#/$defs/FileRef"}, "current": {"$ref": "#/$defs/FileRef"}}, "$comment": "state added, removed, unchanged or modified; textChange only for small html and css files."},
    "ExecutionDifferencesReply": {"type": "object", "required": ["sessionId", "previousExecutionId", "executionId", "files"], "properties": {"sessionId": {"type": ["string", "null"]}, "previousExecutionId": {"type": ["string", "null"]}, "executionId": {"type": "string"}, "files": {"type": "array", "items": {"$ref": "#/$defs/DiffFile"}}}},
    "ExecutionDifferencesRequest": {"type": "object", "required": ["executionId", "previous"], "properties": {"executionId": {"type": "string"}, "previous": {"type": "string"}}, "additionalProperties": true, "$comment": "previous: the earlier execution of the same session."},
    "ExecutionEventsReply": {"type": "object", "required": ["events"], "properties": {"events": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "A stored host event (native data stays raw)."}}}},
    "ExecutionEventsRequest": {"type": "object", "required": ["executionId"], "properties": {"executionId": {"type": "string"}}, "additionalProperties": true},
    "ExecutionStatusReply": {"type": "object", "required": ["executionId", "sessionId", "state", "report", "next", "resume"], "properties": {"executionId": {"type": "string"}, "sessionId": {"type": ["string", "null"]}, "state": {"type": "string"}, "report": {}, "stop": {"$ref": "#/$defs/StopOutcome"}, "next": {"type": "string"}, "resume": {"type": "object", "additionalProperties": true, "$comment": "session_resume's reply for the execution's session."}, "readiness": {"type": "array", "items": {}}}, "$comment": "next: the suggested operation (message, session_fork, execution_status or wait_or_steer). stop only after a stop request."},
    "ExecutionStatusRequest": {"type": "object", "required": ["executionId"], "properties": {"executionId": {"type": "string"}}, "additionalProperties": true},
    "ExecutionStopReply": {"type": "object", "required": ["id", "executionId", "sessionId", "hostId", "kind", "payload", "status", "stop"], "properties": {"id": {"type": "string"}, "executionId": {"type": "string"}, "sessionId": {"type": ["string", "null"]}, "hostId": {"type": ["string", "null"]}, "kind": {"type": "string"}, "payload": {"type": "object", "additionalProperties": true}, "status": {"type": "string"}, "stop": {"$ref": "#/$defs/StopOutcome"}}, "$comment": "The stop command and the stop outcome."},
    "ExecutionStopRequest": {"type": "object", "required": ["executionId"], "properties": {"executionId": {"type": "string"}}, "additionalProperties": true},
    "ExecutionsListReply": {"type": "object", "required": ["executions"], "properties": {"executions": {"type": "array", "items": {"$ref": "ops.schema.json#/$defs/ExecutionRow"}}}},
    "ExecutionsListRequest": {"type": "object", "properties": {"taskId": {"type": "string"}, "projectId": {"type": "string"}, "parentExecutionId": {"type": "string"}, "sessionId": {"type": "string"}, "problem": {"type": "boolean"}}, "additionalProperties": true, "$comment": "Filters; problem true keeps executions with a problem."},
    "FileRef": {"type": "object", "required": ["id", "sha256"], "properties": {"id": {"type": "string"}, "sha256": {"type": ["string", "null"]}}},
    "HostRecord": {"type": "object", "required": ["id", "intake", "harnesses", "createdAt"], "properties": {"id": {"type": "string"}, "hostId": {"type": "string"}, "name": {"type": ["string", "null"]}, "holder": {"type": ["string", "null"]}, "platform": {"type": ["string", "null"]}, "roles": {"type": "array", "items": {"type": "string"}}, "intake": {"type": "string"}, "harnesses": {}, "autoUpdate": {}, "createdAt": {"type": "number"}}, "$comment": "A registered host (without its secret hash). harnesses: per harness name whether it is allowed; autoUpdate on, off or an RFC 3339 time."},
    "HostRow": {"type": "object", "required": ["id", "configured", "platform", "lastSeenAt", "capabilities", "problems", "runningByHarness", "running", "slots", "queued", "stores", "version", "autoUpdate", "update"], "properties": {"id": {"type": "string"}, "configured": {"type": "boolean"}, "platform": {"type": ["string", "null"]}, "lastSeenAt": {"type": ["number", "null"]}, "capabilities": {}, "problems": {}, "runningByHarness": {"type": "object", "additionalProperties": {"type": "integer"}}, "running": {"type": "integer"}, "slots": {}, "queued": {"type": "integer"}, "stores": {"type": "string"}, "version": {"type": ["string", "null"]}, "autoUpdate": {}, "update": {}}, "$comment": "One host as the Hosts screen shows it: configured, observed, or both; problems only while it polls."},
    "HostWriteReply": {"type": "object", "required": ["host"], "properties": {"host": {"$ref": "#/$defs/HostRecord"}, "secret": {"type": "string"}}, "$comment": "secret: only when Fleet minted it (no secretSha256 given); shown once."},
    "HostsListReply": {"type": "object", "required": ["hosts", "serverNow", "staleAfterMs"], "properties": {"hosts": {"type": "array", "items": {"$ref": "#/$defs/HostRow"}}, "serverNow": {"type": "integer"}, "staleAfterMs": {"type": "integer"}}},
    "HostsListRequest": {"type": "object", "additionalProperties": true},
    "HostsRegisterReply": {"$ref": "#/$defs/HostWriteReply"},
    "HostsRegisterRequest": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "holder": {"type": "string"}, "platform": {"type": "string"}, "roles": {"type": "array", "items": {"type": "string"}}, "harnesses": {}, "secretSha256": {"type": ["string", "null"]}}, "additionalProperties": true, "$comment": "Owner only. secretSha256: the sha256 of a secret the host already holds; absent: Fleet mints one."},
    "HostsRotateSecretReply": {"$ref": "#/$defs/HostWriteReply"},
    "HostsRotateSecretRequest": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "secretSha256": {"type": ["string", "null"]}}, "additionalProperties": true, "$comment": "Owner only."},
    "HostsUpdateReply": {"type": "object", "required": ["host"], "properties": {"host": {"$ref": "#/$defs/HostRecord"}}},
    "HostsUpdateRequest": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "intake": {"type": "string"}, "autoUpdate": {}, "harnesses": {}}, "additionalProperties": true, "$comment": "Owner, or the holder for their own host."},
    "PipelineGetReply": {"type": "object", "additionalProperties": true, "$comment": "A pipeline run with its steps, state and results (pipelineRun)."},
    "PipelineGetRequest": {"type": "object", "required": ["runId"], "properties": {"runId": {"type": "string"}, "projectId": {"type": "string"}}, "additionalProperties": true},
    "PipelineHistoryReply": {"type": "object", "required": ["runs"], "properties": {"runs": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "A pipeline run with its steps, state and results (pipelineRun)."}}}},
    "PipelineHistoryRequest": {"type": "object", "required": ["projectId"], "properties": {"projectId": {"type": "string"}}, "additionalProperties": true},
    "PipelineRerunReply": {"type": "object", "required": ["runId", "reused", "definitions"], "properties": {"runId": {"type": "string"}, "reused": {"type": "array", "items": {"type": "string"}}, "definitions": {"type": "array", "items": {"$ref": "ops.schema.json#/$defs/DefinitionRef"}}}},
    "PipelineRerunRequest": {"type": "object", "required": ["runId", "mode"], "properties": {"runId": {"type": "string"}, "mode": {"$ref": "#/$defs/RerunMode"}, "draft": {"type": "boolean"}, "requestId": {"type": "string"}}},
    "PipelineRunCreateReply": {"type": "object", "required": ["runId", "definitions"], "properties": {"runId": {"type": "string"}, "definitions": {"type": "array", "items": {"$ref": "ops.schema.json#/$defs/DefinitionRef"}}}},
    "PipelineRunCreateRequest": {"type": "object", "required": ["pipelineId", "requestId"], "properties": {"pipelineId": {"type": "string"}, "projectId": {"type": "string"}, "requestId": {"type": "string"}, "draft": {"type": "boolean"}, "exampleArtifactId": {"type": "string"}, "example": {"type": "object", "additionalProperties": true}, "overrides": {"type": "object", "additionalProperties": true}}, "$comment": "Body of POST /api/pipelines/{id}/runs (pipelineRunCreate) as an operation pipeline_run_create; pipelineId was the URL segment. draft true runs the caller's draft. The request signature includes draft and the content sha."},
    "PipelineRunReply": {"type": "object", "additionalProperties": true, "$comment": "A pipeline run with its steps, state and results (pipelineRun)."},
    "PipelineRunRequest": {"type": "object", "required": ["projectId", "requestId", "query"], "properties": {"projectId": {"type": "string"}, "requestId": {"type": "string"}, "methodId": {"type": "string"}, "query": {"type": "string"}}, "additionalProperties": true, "$comment": "Runs the project's method for a capability (pipeline_run) or a direct search; idempotent by requestId."},
    "QueueListReply": {"type": "object", "required": ["queued"], "properties": {"queued": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "A queued message with queued: true and its position (1 is next)."}}}},
    "QueueListRequest": {"type": "object", "properties": {"sessionId": {"type": "string"}}, "additionalProperties": true},
    "RerunMode": {"type": "string", "enum": ["failed", "all"]},
    "RouteDecision": {"type": "object", "required": ["executionId", "at", "hostId", "candidates", "winner"], "properties": {"executionId": {"type": "string"}, "at": {"type": "string"}, "hostId": {"type": ["string", "null"]}, "candidates": {}, "winner": {}}},
    "RouteDecisionsReply": {"type": "object", "required": ["decisions"], "properties": {"decisions": {"type": "array", "items": {"$ref": "#/$defs/RouteDecision"}}}},
    "RouteDecisionsRequest": {"type": "object", "required": ["executionId"], "properties": {"executionId": {"type": "string"}}, "additionalProperties": true},
    "StopCommandRef": {"type": "object", "required": ["id", "status"], "properties": {"id": {"type": "string"}, "status": {"type": "string"}}},
    "StopOutcome": {"type": "object", "required": ["outcome", "detail", "state"], "properties": {"outcome": {"type": "string"}, "detail": {"type": "string"}, "state": {"type": "string"}, "stopCommand": {"$ref": "#/$defs/StopCommandRef"}}, "$comment": "outcome proven (detail stopped or already_finished) or unknown (detail unconfirmed, with the stop command when one exists)."},
    "TextChange": {"type": "object", "required": ["firstLine", "removed", "added"], "properties": {"firstLine": {"type": "integer"}, "removed": {"type": "array", "items": {"type": "string"}}, "added": {"type": "array", "items": {"type": "string"}}}}
  }
}
