{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Coordinator operations of the executions domain; the rules are in ops.schema.json $comment and contracts/README.md.",
  "operations": {
    "delivery_status": {"read": true, "errors": []},
    "delivery_history": {"read": true, "errors": [404]},
    "delivery_baseline": {"read": true, "errors": [404]},
    "delivery_baseline_set": {"read": false, "errors": [400, 403, 404]},
    "delivery_regressions": {"read": true, "errors": [404]},
    "execution_differences": {"read": true, "errors": [403, 409, 503]},
    "execution_events": {"read": true, "errors": []},
    "execution_status": {"read": true, "errors": [400]},
    "executions_abandon": {"read": false, "errors": [400, 403]},
    "executions_dismiss": {"read": false, "errors": [400, 403]},
    "execution_stop": {"read": false, "errors": [409]},
    "executions_list": {"read": true, "errors": []},
    "executions_runners": {"read": true, "errors": []},
    "executions_ci": {"read": true, "errors": []},
    "hosts_remove": {"read": false, "errors": [400, 403, 404, 409]},
    "system_purge": {"read": false, "errors": [400, 403]},
    "hosts_list": {"read": true, "errors": []},
    "hosts_register": {"read": false, "errors": [400, 403, 409]},
    "hosts_rotate_secret": {"read": false, "errors": [400, 403, 404, 409]},
    "hosts_update": {"read": false, "errors": [400, 403, 404, 409]},
    "pipeline_get": {"read": true, "errors": [400, 403]},
    "pipeline_history": {"read": true, "errors": [404]},
    "pipeline_rerun": {"read": false, "errors": [400, 403, 404, 409], "long": true},
    "pipeline_run": {"read": false, "long": true, "errors": []},
    "pipeline_run_create": {"read": false, "errors": [400, 403, 404, 409], "long": true},
    "queue_list": {"read": true, "errors": []},
    "route_decisions": {"read": true, "errors": [400]}
  },
  "planned": {},
  "$defs": {
    "DeliveryHistoryRequest": {"type": "object", "properties": {"since": {"$comment": "RFC 3339 time or YYYY-MM-DD; default 7 days ago. Pull requests by merge time, runs by creation, releases by publication", "type": "string"}, "until": {"type": "string"}, "number": {"$comment": "one pull request and its merge-queue runs", "type": "integer"}}, "additionalProperties": true},
    "DeliveryHistoryReply": {"type": "object", "required": ["repo", "prs", "runs", "releases"], "properties": {"repo": {"type": "string"}, "backfilledFrom": {"type": "string"}, "refreshedAt": {"type": "string"}, "installsFrom": {"$comment": "host installs and UI on site are recorded from this time on; GitHub keeps no record of them", "type": "string"}, "problem": {"type": "string"}, "prs": {"type": "array", "items": {"$ref": "#/$defs/DeliveryPr"}}, "runs": {"type": "array", "items": {"$ref": "#/$defs/DeliveryRun"}}, "releases": {"type": "array", "items": {"$ref": "#/$defs/DeliveryRelease"}}}, "$comment": "The recorded delivery history of the fleet repository (go/coordinator/delivery_history.go), oldest first."},
    "DeliveryPr": {"type": "object", "required": ["number", "title", "url", "headSha", "mergeSha", "opened", "merged", "installed", "durations", "queueRuns", "queueRemovals", "flakes"], "properties": {"number": {"type": "integer"}, "title": {"type": "string"}, "url": {"type": "string"}, "author": {"type": "string"}, "headSha": {"type": "string"}, "mergeSha": {"type": "string"}, "release": {"type": "string"}, "opened": {"type": "string"}, "prCiDone": {"type": "string"}, "enqueued": {"type": "string"}, "mqCiDone": {"type": "string"}, "merged": {"type": "string"}, "released": {"type": "string"}, "installed": {"$comment": "host id (or coordinator, the PDS18 coordinator part) to when it first ran this release or newer", "type": "object", "additionalProperties": {"type": "string"}}, "uiOnSite": {"type": "string"}, "durations": {"$comment": "ms per stage: pr_ci opened..PR CI done, enqueue ..enqueued, queue ..merge-queue CI done, merge ..merged, release ..published, install ..on the coordinator, ui ..UI on site, lead opened..merged, total opened..on the coordinator", "type": "object", "additionalProperties": {"type": "integer"}}, "queueRuns": {"type": "integer"}, "queueRemovals": {"$comment": "merge-queue runs that did not succeed", "type": "integer"}, "flakes": {"$comment": "removals the pull request landed after without a new commit", "type": "integer"}}},
    "DeliveryRun": {"type": "object", "required": ["id", "attempt", "url", "sha", "created", "conclusion", "jobs"], "properties": {"id": {"type": "integer"}, "attempt": {"type": "integer"}, "pr": {"type": "integer"}, "url": {"type": "string"}, "sha": {"type": "string"}, "created": {"type": "string"}, "started": {"type": "string"}, "completed": {"type": "string"}, "conclusion": {"type": "string"}, "wallMs": {"type": "integer"}, "jobs": {"type": "array", "items": {"$ref": "#/$defs/DeliveryJob"}}}, "$comment": "One merge_group run of the ci workflow; skipped jobs are left out."},
    "DeliveryJob": {"type": "object", "required": ["name", "conclusion", "durationMs", "waitMs", "runner", "hosted"], "properties": {"name": {"type": "string"}, "conclusion": {"type": "string"}, "durationMs": {"type": "integer"}, "waitMs": {"$comment": "created to started: waiting for a runner", "type": "integer"}, "runner": {"type": "string"}, "hosted": {"type": "boolean"}}},
    "DeliveryRelease": {"type": "object", "required": ["tag", "published", "target", "installed"], "properties": {"tag": {"type": "string"}, "published": {"type": "string"}, "target": {"type": "string"}, "installed": {"type": "object", "additionalProperties": {"type": "string"}}, "uiOnSite": {"type": "string"}}},
    "DeliveryStat": {"type": "object", "required": ["key", "n", "p50Ms", "p90Ms"], "properties": {"key": {"$comment": "a stage (DeliveryPr durations), run (merge-queue run wall time), job:<name> (job duration) or wait:<name> (runner wait)", "type": "string"}, "n": {"type": "integer"}, "p50Ms": {"type": "integer"}, "p90Ms": {"type": "integer"}}},
    "DeliveryCounts": {"type": "object", "required": ["prs", "runs", "removals", "flakes"], "properties": {"prs": {"type": "integer"}, "runs": {"type": "integer"}, "removals": {"type": "integer"}, "flakes": {"type": "integer"}}},
    "DeliveryBaseline": {"type": "object", "required": ["from", "until", "stats", "counts"], "properties": {"name": {"type": "string"}, "at": {"type": "string"}, "from": {"type": "string"}, "until": {"type": "string"}, "stats": {"type": "array", "items": {"$ref": "#/$defs/DeliveryStat"}}, "counts": {"$ref": "#/$defs/DeliveryCounts"}}, "$comment": "P50/P90 over a window (nearest rank); a named one is a stored snapshot."},
    "DeliveryTrendDay": {"type": "object", "required": ["day", "stats"], "properties": {"day": {"type": "string"}, "stats": {"type": "array", "items": {"$ref": "#/$defs/DeliveryStat"}}}},
    "DeliverySettings": {"type": "object", "required": ["ratio", "minSamples", "minDeltaMs", "baseline"], "properties": {"ratio": {"$comment": "a P50 or P90 of the last 24 h this many times the baseline's is a regression (default 1.5)", "type": "number"}, "minSamples": {"$comment": "both windows need this many values (default 5)", "type": "integer"}, "minDeltaMs": {"$comment": "and the difference at least this (default 60000)", "type": "integer"}, "baseline": {"$comment": "the snapshot name compared with; empty: the 7 days before the last 24 h", "type": "string"}}},
    "DeliveryBaselineRequest": {"type": "object", "properties": {"days": {"$comment": "trend length in days, default 7, at most 60; the rolling baseline is always 7 days", "type": "integer"}}, "additionalProperties": true},
    "DeliveryBaselineReply": {"type": "object", "required": ["rolling", "snapshots", "trend", "settings"], "properties": {"rolling": {"$ref": "#/$defs/DeliveryBaseline"}, "snapshots": {"type": "array", "items": {"$ref": "#/$defs/DeliveryBaseline"}}, "trend": {"$comment": "stages per UTC day, oldest first", "type": "array", "items": {"$ref": "#/$defs/DeliveryTrendDay"}}, "settings": {"$ref": "#/$defs/DeliverySettings"}}},
    "DeliveryBaselineSetRequest": {"type": "object", "properties": {"snapshot": {"$comment": "store the rolling 7-day baseline now under this name (replaces one of the same name)", "type": "string"}, "remove": {"$comment": "delete the snapshot of this name", "type": "string"}, "settings": {"$ref": "#/$defs/DeliverySettings"}}, "additionalProperties": true, "$comment": "Owner or full access."},
    "DeliveryBaselineSetReply": {"$ref": "#/$defs/DeliveryBaselineReply"},
    "DeliveryRegressionsRequest": {"type": "object", "properties": {"check": {"$comment": "run the check now (full access) instead of returning the last one", "type": "boolean"}}, "additionalProperties": true},
    "DeliveryRegressionsReply": {"type": "object", "required": ["regressions", "settings"], "properties": {"checkedAt": {"type": "string"}, "baseline": {"$ref": "#/$defs/DeliveryBaseline"}, "current": {"$ref": "#/$defs/DeliveryBaseline"}, "regressions": {"type": "array", "items": {"$ref": "#/$defs/DeliveryRegression"}}, "settings": {"$ref": "#/$defs/DeliverySettings"}}, "$comment": "The last regression check (daily and after each release): the last 24 h against the baseline. Each regression holds one needs-you question (cause problem:delivery:<key>:<metric>) that withdraws itself when the value is back."},
    "DeliveryMetric": {"type": "string", "enum": ["p50", "p90"]},
    "DeliveryRegression": {"type": "object", "required": ["key", "metric", "baselineMs", "currentMs", "n", "ratio", "links"], "properties": {"key": {"type": "string"}, "metric": {"$ref": "#/$defs/DeliveryMetric"}, "baselineMs": {"type": "integer"}, "currentMs": {"type": "integer"}, "n": {"type": "integer"}, "ratio": {"type": "number"}, "firstPr": {"$comment": "the first pull request of the last 24 h over the threshold", "type": "integer"}, "lastGoodPr": {"$comment": "the pull request merged just before it", "type": "integer"}, "compareUrl": {"type": "string"}, "links": {"type": "array", "items": {"type": "string"}}}},
    "ExecutionsAbandonReply": {"type": "object", "required": ["abandoned", "skipped"], "properties": {"abandoned": {"type": "array", "items": {"type": "string"}}, "skipped": {"type": "array", "items": {"$ref": "#/$defs/ExecutionSkipped"}}}},
    "ExecutionsDismissReply": {"type": "object", "required": ["dismissed", "skipped"], "properties": {"dismissed": {"type": "array", "items": {"type": "string"}}, "skipped": {"type": "array", "items": {"$ref": "#/$defs/ExecutionSkipped"}}}},
    "ExecutionsDismissRequest": {"type": "object", "required": ["ids", "reason"], "properties": {"ids": {"type": "array", "items": {"type": "string"}}, "reason": {"type": "string"}}, "additionalProperties": false, "$comment": "Owner or full access: takes execution problems off Needs you (a problem-dismissal record); the problem stays on the record; one setting-change audit row each. An open execution is skipped: abandon it instead."},
    "ExecutionsAbandonRequest": {"type": "object", "required": ["ids", "reason"], "properties": {"ids": {"type": "array", "items": {"type": "string"}}, "reason": {"type": "string"}}, "additionalProperties": false, "$comment": "Owner or full access: ends unfinished agent runs and host jobs that no host will finish (failed, problem unknown:abandoned); one setting-change audit row each."},
    "ExecutionSkipped": {"type": "object", "required": ["id", "state"], "properties": {"id": {"type": "string"}, "state": {"type": "string", "$comment": "The execution's state, or unknown (no agent run or host job)."}}},
    "ExecutionsCiReply": {"type": "object", "required": ["serverNow", "keyed", "jobs", "minutesToday", "runsUncounted", "runners", "problems"], "properties": {"serverNow": {"type": "integer"}, "keyed": {"type": "boolean"}, "jobs": {"type": "array", "items": {"$ref": "#/$defs/CiJob"}}, "minutesToday": {"type": "array", "items": {"$ref": "#/$defs/CiMinutes"}}, "runsUncounted": {"type": "integer"}, "runners": {"type": ["array", "null"], "items": {"$ref": "#/$defs/CiRunner"}}, "problems": {"type": "array", "items": {"type": "string"}}}, "$comment": "The Runners screen's CI half for taskqorg/fleet, the last background pass (every FLEET_RUNNERS_CI_TICK_MS, default 1 min, first at start) read through githubRead (cached; keyed through the github connection, else unauthenticated). jobs: in progress and queued. minutesToday: job wall minutes since 00:00 UTC per runner type; runsUncounted: today's runs whose jobs are not read yet (minutes are a lower bound while above 0). runners: self-hosted runners, null without a key (state unknown)."},
    "ExecutionsCiRequest": {"type": "object", "properties": {}, "additionalProperties": true},
    "CiJob": {"type": "object", "required": ["id", "runId", "workflow", "name", "status", "url", "runner", "hosted", "runnerName", "createdAt", "startedAt"], "properties": {"id": {"type": "integer"}, "runId": {"type": "integer"}, "workflow": {"type": "string"}, "name": {"type": "string"}, "status": {"type": "string"}, "url": {"type": "string"}, "runner": {"type": "string"}, "hosted": {"type": "boolean"}, "runnerName": {"type": ["string", "null"]}, "createdAt": {"type": ["number", "null"]}, "startedAt": {"type": ["number", "null"]}}, "$comment": "runner: the self-hosted runner's name, else the hosted label (ubuntu-latest). Times in ms."},
    "CiMinutes": {"type": "object", "required": ["runner", "hosted", "minutes", "jobs"], "properties": {"runner": {"type": "string"}, "hosted": {"type": "boolean"}, "minutes": {"type": "number"}, "jobs": {"type": "integer"}}},
    "CiRunner": {"type": "object", "required": ["name", "status", "busy", "labels"], "properties": {"name": {"type": "string"}, "status": {"type": "string"}, "busy": {"type": "boolean"}, "labels": {"type": "array", "items": {"type": "string"}}}},
    "DiffFile": {"type": "object", "required": ["path", "state"], "properties": {"path": {"type": "string"}, "state": {"type": "string"}, "textChange": {"$ref": "#/$defs/TextChange"}, "previous": {"$ref": "#/$defs/FileRef"}, "current": {"$ref": "#/$defs/FileRef"}}, "$comment": "state added, removed, unchanged or modified; textChange only for small html and css files."},
    "ExecutionDifferencesReply": {"type": "object", "required": ["sessionId", "previousExecutionId", "executionId", "files"], "properties": {"sessionId": {"type": ["string", "null"]}, "previousExecutionId": {"type": ["string", "null"]}, "executionId": {"type": "string"}, "files": {"type": "array", "items": {"$ref": "#/$defs/DiffFile"}}}},
    "ExecutionDifferencesRequest": {"type": "object", "required": ["executionId", "previous"], "properties": {"executionId": {"type": "string"}, "previous": {"type": "string"}}, "additionalProperties": true, "$comment": "previous: the earlier execution of the same session."},
    "ExecutionEventsReply": {"type": "object", "required": ["events"], "properties": {"events": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "A stored host event (native data stays raw)."}}}},
    "ExecutionEventsRequest": {"type": "object", "required": ["executionId"], "properties": {"executionId": {"type": "string"}}, "additionalProperties": true},
    "ExecutionStatusReply": {"type": "object", "required": ["executionId", "sessionId", "state", "observation", "reason", "report", "next", "resume"], "properties": {"executionId": {"type": "string"}, "sessionId": {"type": ["string", "null"]}, "state": {"type": "string"}, "observation": {"type": "string", "$comment": "confirmed or unconfirmed; independent of lifecycle state."}, "reason": {"type": ["string", "null"], "$comment": "Why observation is unconfirmed; null when confirmed. Lifecycle state is independent of observation."}, "report": {}, "stop": {"$ref": "#/$defs/StopOutcome"}, "next": {"type": "string"}, "resume": {"type": "object", "additionalProperties": true, "$comment": "session_resume's reply for the execution's session."}, "readiness": {"type": "array", "items": {}}}, "$comment": "next: the suggested operation (message, session_fork, execution_status or wait_or_steer). stop only after a stop request."},
    "ExecutionStatusRequest": {"type": "object", "required": ["executionId"], "properties": {"executionId": {"type": "string"}}, "additionalProperties": true},
    "ExecutionStopReply": {"type": "object", "required": ["id", "executionId", "sessionId", "hostId", "kind", "payload", "status", "stop"], "properties": {"id": {"type": "string"}, "executionId": {"type": "string"}, "sessionId": {"type": ["string", "null"]}, "hostId": {"type": ["string", "null"]}, "kind": {"type": "string"}, "payload": {"type": "object", "additionalProperties": true}, "status": {"type": "string"}, "stop": {"$ref": "#/$defs/StopOutcome"}}, "$comment": "The stop command and the stop outcome."},
    "ExecutionStopRequest": {"type": "object", "required": ["executionId"], "properties": {"executionId": {"type": "string"}}, "additionalProperties": true},
    "ExecutionsListReply": {"type": "object", "required": ["executions"], "properties": {"executions": {"type": "array", "items": {"$ref": "ops.schema.json#/$defs/ExecutionRow"}}}},
    "ExecutionsListRequest": {"type": "object", "properties": {"projectIds": {"$comment": "keep rows of these projects only (the app passes the person's focus, OR-34); '-' is no project", "type": "array", "items": {"type": "string"}}, "taskId": {"type": "string"}, "projectId": {"type": "string"}, "parentExecutionId": {"type": "string"}, "sessionId": {"type": "string"}, "problem": {"type": "boolean"}, "needsYou": {"type": "boolean"}}, "additionalProperties": true, "$comment": "Filters; problem true keeps executions with a problem; needsYou true keeps the problems that still need someone (Needs you): not dismissed, not abandoned or cancelled, no tool calls or steps of a listed run, project still defined."},
    "ExecutionsRunnersReply": {"type": "object", "required": ["serverNow", "runs", "spend"], "properties": {"serverNow": {"type": "integer"}, "runs": {"type": "array", "items": {"$ref": "#/$defs/RunnerRun"}}, "spend": {"type": "array", "items": {"$ref": "#/$defs/RunnerSpend"}}}, "$comment": "The Runners screen: executions active or ended in the last 24 hours (newest first, at most 500; pipeline runs and steps left out, their agent and tool runs are listed), and spend since the start of the UTC day and month."},
    "ExecutionsRunnersRequest": {"type": "object", "properties": {}, "additionalProperties": true},
    "RunnerRun": {"type": "object", "required": ["id", "kind", "state", "hostId", "harness", "model", "taskId", "taskTitle", "sessionId", "problem", "startedAt", "endedAt", "lastSeenAt", "wallMs", "cpuMs", "peakMemoryBytes", "tokens", "cost"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "state": {"$ref": "ops.schema.json#/$defs/ExecutionState"}, "hostId": {"type": ["string", "null"]}, "harness": {"type": ["string", "null"]}, "model": {"type": ["string", "null"]}, "taskId": {"type": ["string", "null"]}, "taskTitle": {"type": ["string", "null"]}, "sessionId": {"type": ["string", "null"]}, "problem": {"type": ["string", "null"]}, "startedAt": {"type": ["number", "null"]}, "endedAt": {"type": ["number", "null"]}, "lastSeenAt": {"type": ["number", "null"]}, "wallMs": {"type": ["number", "null"]}, "cpuMs": {"type": ["number", "null"]}, "peakMemoryBytes": {"type": ["number", "null"]}, "tokens": {"type": ["number", "null"]}, "calls": {"type": ["integer", "null"]}, "failedCalls": {"type": ["integer", "null"]}, "parentExecutionId": {"type": ["string", "null"]}, "cost": {"type": "array", "items": {"$ref": "ops.schema.json#/$defs/CostFigure"}}}, "$comment": "Tool calls come as one row per caller (id calls:<parent, session or host:id>) with calls and failedCalls; other runs have them null. Times in ms since epoch; resource fields null when not measured. tokens: input + output + cache. cost: CostFigure figures (prices table), empty when nothing was used."},
    "RunnerSpend": {"type": "object", "required": ["hostId", "kind", "period", "runs", "measured", "wallMs", "cpuMs", "tokens", "cost"], "properties": {"hostId": {"type": ["string", "null"]}, "kind": {"type": "string"}, "period": {"type": "string"}, "runs": {"type": "integer"}, "measured": {"type": "integer"}, "wallMs": {"type": ["number", "null"]}, "cpuMs": {"type": ["number", "null"]}, "tokens": {"type": ["number", "null"]}, "cost": {"type": "array", "items": {"$ref": "ops.schema.json#/$defs/CostFigure"}}}, "$comment": "One host and execution kind over a UTC period: today or month (month includes today), by when each run ran (end, else start). measured: runs with recorded totals; sums cover only those."},
    "FileRef": {"type": "object", "required": ["id", "sha256"], "properties": {"id": {"type": "string"}, "sha256": {"type": ["string", "null"]}}},
    "HostRecord": {"type": "object", "required": ["id", "intake", "harnesses", "createdAt"], "properties": {"id": {"type": "string"}, "hostId": {"type": "string"}, "name": {"type": ["string", "null"]}, "holder": {"type": ["string", "null"]}, "platform": {"type": ["string", "null"]}, "roles": {"type": "array", "items": {"type": "string"}}, "intake": {"type": "string"}, "harnesses": {}, "autoUpdate": {}, "createdAt": {"type": "number"}}, "$comment": "A registered host (without its secret hash). harnesses: per harness name whether it is allowed; autoUpdate on, off or an RFC 3339 time."},
    "HostRow": {"type": "object", "required": ["id", "configured", "platform", "lastSeenAt", "capabilities", "problems", "runningByHarness", "running", "slots", "queued", "stores", "version", "autoUpdate", "update"], "properties": {"id": {"type": "string"}, "configured": {"type": "boolean"}, "platform": {"type": ["string", "null"]}, "lastSeenAt": {"type": ["number", "null"]}, "capabilities": {}, "problems": {}, "runningByHarness": {"type": "object", "additionalProperties": {"type": "integer"}}, "running": {"type": "integer"}, "slots": {}, "queued": {"type": "integer"}, "stores": {"type": "string"}, "version": {"type": ["string", "null"]}, "removedAt": {"type": ["number", "null"]}, "autoUpdate": {}, "update": {}}, "$comment": "One host as the Hosts screen shows it: configured, observed, or both; problems only while it polls."},
    "HostWriteReply": {"type": "object", "required": ["host"], "properties": {"host": {"$ref": "#/$defs/HostRecord"}, "secret": {"type": "string"}}, "$comment": "secret: only when Fleet minted it (no secretSha256 given); shown once."},
    "HostsListReply": {"type": "object", "required": ["hosts", "serverNow", "staleAfterMs"], "properties": {"hosts": {"type": "array", "items": {"$ref": "#/$defs/HostRow"}}, "serverNow": {"type": "integer"}, "staleAfterMs": {"type": "integer"}}},
    "HostsListRequest": {"type": "object", "properties": {"includeRemoved": {"type": "boolean"}}, "additionalProperties": true, "$comment": "includeRemoved: also hosts removed by hosts_remove (state removed)."},
    "HostsRemoveRequest": {"type": "object", "required": ["id", "preview"], "properties": {"id": {"type": "string"}, "preview": {"type": "boolean"}}, "$comment": "Owner, or the holder for their own host (fleet-system-management.md, Hosts). preview true changes nothing and returns the counts; false removes: running work is cancelled, the secret and settings are dropped, the host record stays as a tombstone (state removed) for history."},
    "PurgeKind": {"type": "string", "enum": ["host"], "$comment": "Kinds system_purge removes; the other object kinds of fleet-system-management.md join with their delete operations."},
    "PurgeCount": {"type": "object", "required": ["kind", "count", "ids"], "properties": {"kind": {"$ref": "#/$defs/PurgeKind"}, "count": {"type": "integer"}, "ids": {"type": "array", "items": {"type": "string"}}}},
    "SystemPurgeRequest": {"type": "object", "required": ["preview"], "properties": {"preview": {"type": "boolean"}, "kinds": {"type": "array", "items": {"$ref": "#/$defs/PurgeKind"}}}, "$comment": "Owner only. Removes tombstoned rows no live or tombstoned row references (a removed host with no execution, session, command, store or artifact copy naming it). preview true counts them and changes nothing; the confirm recomputes with the same query."},
    "SystemPurgeReply": {"type": "object", "required": ["removed", "purged"], "properties": {"removed": {"type": "array", "items": {"$ref": "#/$defs/PurgeCount"}}, "purged": {"type": "boolean"}, "kept": {"type": "array", "items": {"$ref": "#/$defs/PurgeCount"}}}, "$comment": "kept: tombstoned rows still referenced by history; they stay."},
    "HostsRemoveReply": {"type": "object", "required": ["id", "runningExecutions", "openSessions", "unreplicatedArtifacts", "removed"], "properties": {"id": {"type": "string"}, "runningExecutions": {"type": "integer"}, "openSessions": {"type": "integer"}, "unreplicatedArtifacts": {"type": "integer"}, "removed": {"type": "boolean"}}, "$comment": "unreplicatedArtifacts: artifacts whose only verified copy is in a store on this host; they become lost on remove."},
    "HostsRegisterReply": {"$ref": "#/$defs/HostWriteReply"},
    "HostsRegisterRequest": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "holder": {"type": "string"}, "platform": {"type": "string"}, "roles": {"type": "array", "items": {"type": "string"}}, "harnesses": {}, "secretSha256": {"type": ["string", "null"]}}, "additionalProperties": true, "$comment": "Owner only. secretSha256: the sha256 of a secret the host already holds; absent: Fleet mints one."},
    "HostsRotateSecretReply": {"$ref": "#/$defs/HostWriteReply"},
    "HostsRotateSecretRequest": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "secretSha256": {"type": ["string", "null"]}}, "additionalProperties": true, "$comment": "Owner only."},
    "HostsUpdateReply": {"type": "object", "required": ["host"], "properties": {"host": {"$ref": "#/$defs/HostRecord"}}},
    "HostsUpdateRequest": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "intake": {"type": "string"}, "autoUpdate": {}, "harnesses": {}}, "additionalProperties": true, "$comment": "Owner, or the holder for their own host."},
    "PipelineGetReply": {"type": "object", "additionalProperties": true, "$comment": "A pipeline run with its steps, state and results (pipelineRun)."},
    "PipelineGetRequest": {"type": "object", "required": ["runId"], "properties": {"runId": {"type": "string"}, "projectId": {"type": "string"}}, "additionalProperties": true},
    "PipelineHistoryReply": {"type": "object", "required": ["runs"], "properties": {"runs": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "A pipeline run with its steps, state and results (pipelineRun)."}}}},
    "PipelineHistoryRequest": {"type": "object", "required": ["projectId"], "properties": {"projectId": {"type": "string"}}, "additionalProperties": true},
