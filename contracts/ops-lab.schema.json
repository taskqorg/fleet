{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Coordinator operations of the lab domain; the rules are in ops.schema.json $comment and contracts/README.md.",
  "operations": {
    "lab_compare_methods": {"read": false, "errors": [400,403,404,409], "auth": "architect", "agent": "tool", "description": "Create an unlaunched Lab experiment comparing catalogue methods of a project capability (projectId, capability, methods, useCase, baseline)"},
    "lab_cell_action": {"read": false, "long": true, "errors": [400,404,409], "auth": "architect", "agent": "tool", "description": "action cancel, retry or retry_suffix. retry_suffix requires non-whitespace experimentId/cell/sourceRunId/requestId; accepted strings retain exact bytes. Other actions and unknown-field policy unchanged."},
    "lab_example_get": {"read": true, "errors": [400,404,409,503], "auth": "architect", "agent": "tool", "description": "A Lab example (artifactId)"},
    "lab_examples_add": {"read": false, "errors": [400,403,409], "auth": "architect", "agent": "tool", "description": "Add Lab examples, optionally of a project and approved"},
    "lab_examples_list": {"read": true, "errors": [400], "auth": "architect", "agent": "tool", "description": "Lab examples, optionally by state"},
    "lab_experiment_action": {"read": false, "long": true, "errors": [400,404,409], "auth": "architect", "agent": "tool", "description": "action launch, stop or resume."},
    "lab_experiment_create": {"read": false, "errors": [400,403,404,409], "auth": "architect", "agent": "tool", "description": "See fleet-lab.md, Experiment record."},
    "lab_experiment_decide": {"read": false, "errors": [400,404,409], "auth": "architect", "agent": "tool", "description": "Decide a Lab experiment (experimentId, decision, reason)"},
    "lab_experiment_get": {"read": true, "errors": [400,404], "auth": "architect", "agent": "tool", "description": "A Lab experiment (experimentId) with its variants, trials and scores"},
    "lab_experiment_note": {"read": false, "errors": [400,404], "auth": "architect", "agent": "tool", "description": "Add a note to a Lab experiment (experimentId, kind, text, optional field and value)"},
    "lab_experiments_list": {"read": true, "errors": [], "auth": "architect", "agent": "tool", "description": "Lab experiments"},
    "lab_promote": {"read": false, "errors": [400,404], "auth": "architect", "agent": "tool", "description": "Promote a variant of a Lab experiment (experimentId, variant) to the catalogue recommendation"},
    "lab_rating_create": {"read": false, "errors": [400,404,409], "auth": "architect", "agent": "tool", "description": "Ask for a human rating of Lab trials (experimentId, form, trialIds)"},
    "lab_rating_withdraw": {"read": false, "errors": [400,403,404,409], "auth": "owner", "agent": "tool", "description": "Withdraw an open Lab rating question (questionId, reason)"},
    "lab_rating_get": {"read": true, "errors": [400,404], "auth": "architect", "agent": "tool", "description": "A Lab rating question with its answers (questionId)"},
    "lab_ratings_list": {"read": true, "errors": [404], "auth": "architect", "agent": "tool", "description": "Lab rating questions, optionally of one experiment or state"},
    "lab_registry": {"read": true, "errors": [], "auth": "architect", "agent": "tool", "description": "The Lab use-case registry"},
    "lab_score_correct": {"read": false, "errors": [400,404,409], "auth": "architect", "agent": "tool", "description": "Correct a Lab score (scoreId, value, rationale)"}
  },
  "planned": {
    "lab_experiment_promote": {"read": false, "errors": [400, 403, 404, 409]}
  },
  "$defs": {
    "LabTrialRecord": {"type": "object", "additionalProperties": false, "required": ["id", "cell", "state", "observation", "problem", "comparable", "startedAt", "finishedAt", "durationMs", "spend", "cost", "confounders", "scores", "planSummary"], "properties": {"id": {"type": "string"}, "cell": {}, "state": {"$ref": "ops.schema.json#/$defs/ExecutionState"}, "observation": {"$ref": "ops-executions.schema.json#/$defs/PipelineObservation"}, "problem": {}, "comparable": {"type": "boolean"}, "startedAt": {}, "finishedAt": {}, "durationMs": {}, "spend": {}, "cost": {"type": "array", "items": {"$ref": "ops.schema.json#/$defs/CostFigure"}}, "confounders": {}, "scores": {"type": "array", "items": {}}, "planSummary": {"$ref": "ops-executions.schema.json#/$defs/PipelinePlanSummary"}, "canonicalResult": {"$ref": "ops-executions.schema.json#/$defs/PipelineCanonicalResult"}, "projectAssessments": {"type": "array", "items": {"$ref": "#/$defs/ProjectAssessmentRef"}}, "recovery": {}}},
    "ProjectAssessmentRef": {"type": "object", "required": ["checkId", "schemaId", "artifactId", "sha256", "evaluatorSha256", "inputSha256"], "properties": {"checkId": {"type": "string"}, "schemaId": {"type": "string"}, "artifactId": {"type": "string"}, "sha256": {"type": "string"}, "evaluatorSha256": {"type": "string"}, "inputSha256": {"type": "string"}}, "additionalProperties": false},
    "LabCellActionReply": {"type": "object", "additionalProperties": true, "$comment": "An experiment view. Successful retry_suffix adds recovery:{sourceRunId:string,runId:string}, stable on replay. Recovered trials add recovery:{sourceRunId:string,reusedStepIds:string[]}; ordinary trials/actions omit it. See fleet-lab.md Local-suffix retry for identity/audit and provenance."},
    "LabCellActionRequest": {"type": "object", "required": ["experimentId", "cell", "action"], "properties": {"experimentId": {"type": "string"}, "cell": {"type": "string"}, "action": {"$ref": "#/$defs/LabCellAction"}, "sourceRunId": {"type": "string"}, "requestId": {"type": "string"}}, "additionalProperties": true, "$comment": "retry_suffix requires non-whitespace experimentId/cell/sourceRunId/requestId; accepted strings retain exact bytes."},
    "LabCellAction": {"type": "string", "enum": ["cancel", "retry", "retry_suffix"]},
    "LabCompareMethodsReply": {"type": "object", "required": ["experimentId"], "properties": {"experimentId": {"type": "string"}}},
    "LabCompareMethodsRequest": {"type": "object", "required": ["projectId", "capability", "methods"], "properties": {"projectId": {"type": "string"}, "capability": {"type": "string"}, "methods": {"type": "array", "items": {"type": "string"}}, "useCase": {"type": "string"}, "baseline": {"type": "string"}}},
    "LabExampleGetReply": {"type": "object", "required": ["artifactId", "example", "state", "hash"], "properties": {"artifactId": {"type": "string"}, "example": {}, "state": {}, "hash": {"type": "string"}, "projectId": {"type": "string"}}},
    "LabExampleGetRequest": {"type": "object", "required": ["artifactId"], "properties": {"artifactId": {"type": "string"}}, "additionalProperties": true},
    "LabExamplesAddReply": {"type": "object", "required": ["examples"], "properties": {"examples": {"type": "array", "items": {"type": "object", "additionalProperties": true}}}},
    "LabExamplesAddRequest": {"type": "object", "required": ["examples"], "properties": {"projectId": {"type": "string"}, "examples": {}, "approved": {"type": "boolean"}}, "additionalProperties": true},
    "LabExamplesListReply": {"type": "object", "required": ["examples"], "properties": {"examples": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "A Lab example (an artifact with its state)."}}}},
    "LabExamplesListRequest": {"type": "object", "properties": {"state": {"$ref": "#/$defs/LabExampleState"}}, "additionalProperties": true},
    "LabExampleState": {"type": "string", "enum": ["approved", "proposed"]},
    "LabExperimentActionReply": {"type": "object", "additionalProperties": true, "$comment": "An experiment view (expView): record fields, state, variants, cells, trials, scores, spend and comparability."},
    "LabExperimentActionRequest": {"type": "object", "required": ["experimentId", "action"], "properties": {"experimentId": {"type": "string"}, "action": {"$ref": "#/$defs/LabExperimentAction"}}, "additionalProperties": true},
    "LabExperimentAction": {"type": "string", "enum": ["launch", "stop", "resume"]},
    "LabExperimentCreateReply": {"type": "object", "additionalProperties": true, "$comment": "An experiment view (expView): record fields, state, variants, cells, trials, scores, spend and comparability."},
    "LabExperimentCreateRequest": {"unevaluatedProperties": false, "type": "object", "properties": {"projectId": {"type": "string"}, "pipelineId": {"type": "string"}, "kind": {"type": "string"}, "variants": {}, "examples": {}, "evaluators": {}, "primaryEvaluator": {}, "repeats": {}, "strategy": {"$ref": "#/$defs/LabLoopStrategy"}, "budgets": {}, "goal": {"type": "string"}, "hypothesis": {"type": "string"}, "decisionRule": {}, "labGroup": {}}, "additionalProperties": false, "$comment": "See fleet-lab.md, Experiment record."},
    "LabExperimentDecideReply": {"type": "object", "additionalProperties": true, "$comment": "An experiment view (expView): record fields, state, variants, cells, trials, scores, spend and comparability."},
    "LabExperimentDecideRequest": {"unevaluatedProperties": false, "type": "object", "required": ["experimentId", "decision"], "properties": {"experimentId": {"type": "string"}, "decision": {"type": "string", "$comment": "adopt <variant> | keep baseline | inconclusive (pending is the coordinator's, never a person's)"}, "reason": {"type": "string", "$comment": "Required to override a decision already made; the override is an amendment."}}, "additionalProperties": false},
    "LabLoopGeneratorKind": {"type":"string","enum":["list","grid","propose"]},
    "LabLoopAllocatorKind": {"type":"string","enum":["full"]},
    "LabLoopStrategy": {"type": "object", "required": ["generator", "allocator"], "properties": {"generator": {"$ref": "#/$defs/LabLoopGenerator"}, "allocator": {"$ref": "#/$defs/LabLoopAllocator"}, "max_iterations": {"type": "integer", "minimum": 1}, "no_gain": {"$ref": "#/$defs/LabLoopNoGain"}}, "additionalProperties": false, "$comment": "Explicit loop configuration; no default k or iteration ceiling. Internal owner override authority is resolved by the server, never supplied here."},
    "LabLoopGenerator": {"type": "object", "required": ["kind", "params"], "properties": {"kind": {"$ref": "#/$defs/LabLoopGeneratorKind"}, "params": {"type": "object", "additionalProperties": true}}, "additionalProperties": false},
    "LabLoopAllocator": {"type": "object", "required": ["kind"], "properties": {"kind": {"$ref": "#/$defs/LabLoopAllocatorKind"}, "params": {"type": "object", "additionalProperties": true}}, "additionalProperties": false},
    "LabLoopNoGain": {"type": "object", "required": ["k"], "properties": {"k": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "LabExperimentGetReply": {"type": "object", "additionalProperties": true, "$comment": "An experiment view (expView). Planned with the definition editors: baseline and vsBaseline. comparison: each non-baseline variant vs the first on the primary evaluator, {variant, baseline, evaluator, split, result: {n, mean, low, high, tooFew, examples}} (fleet-lab.md, Statistics). typed: per variant {variant, split, stats: [{tag, n, confident, correct, coverage, selectiveAccuracy, escalation}]}, the aggregate last with tag all.", "required": ["id", "projectId", "kind", "pipelineId", "examples", "variants", "repeats", "evaluators", "primaryEvaluator", "strategy", "budgets", "state", "stopReason", "createdAt", "goal", "hypothesis", "decisionRule", "labGroup", "decision", "decisionReason", "decidedBy", "decidedAt", "launchedAt", "requestedBy", "requesterRemovedAt", "notes", "spend", "trials", "cells", "scores", "agreement", "judges", "pairwise", "strategies", "comparison", "typed", "priority"], "properties": {"id": {}, "projectId": {}, "kind": {}, "pipelineId": {}, "examples": {}, "variants": {}, "repeats": {}, "evaluators": {}, "primaryEvaluator": {}, "strategy": {}, "budgets": {}, "state": {}, "stopReason": {}, "createdAt": {}, "goal": {}, "hypothesis": {}, "decisionRule": {}, "labGroup": {}, "decision": {}, "decisionReason": {}, "decidedBy": {}, "decidedAt": {}, "launchedAt": {}, "requestedBy": {}, "requesterRemovedAt": {}, "notes": {}, "spend": {}, "trials": {"type": "array", "items": {"$ref": "#/$defs/LabTrialRecord"}}, "cells": {}, "scores": {}, "agreement": {}, "judges": {}, "pairwise": {}, "strategies": {}, "comparison": {}, "typed": {}, "priority": {}}},
    "LabExperimentGetRequest": {"type": "object", "required": ["experimentId"], "properties": {"experimentId": {"type": "string"}}, "additionalProperties": true},
    "LabExperimentNoteReply": {"type": "object", "additionalProperties": true, "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "text": {"type": "string"}}},
    "LabExperimentNoteRequest": {"unevaluatedProperties": false, "type": "object", "required": ["experimentId", "kind", "text"], "properties": {"experimentId": {"type": "string"}, "kind": {"$ref": "#/$defs/LabNoteKind"}, "field": {"type": "string", "$comment": "Amendment only: goal, hypothesis, decisionRule, labGroup or primaryEvaluator."}, "value": {"type": ["string", "null"]}, "text": {"type": "string"}}, "additionalProperties": false},
    "LabNoteKind": {"type": "string", "enum": ["amendment", "note"]},
    "LabExperimentPromoteReply": {"type": "object", "required": ["method", "catalogue", "recommendation"], "properties": {"method": {"$ref": "ops.schema.json#/$defs/CatalogueMethod"}, "catalogue": {"$ref": "ops.schema.json#/$defs/DefinitionRef"}, "recommendation": {"type": ["string", "null"]}}},
    "LabExperimentPromoteRequest": {"type": "object", "required": ["experimentId", "variant"], "properties": {"experimentId": {"type": "string"}, "variant": {"type": "string"}}, "$comment": "Replaces lab_promote's request when lab_experiment_promote is built."},
    "LabExperimentsListReply": {"type": "object", "required": ["experiments"], "properties": {"experiments": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "An experiment view (expView): record fields, state, variants, cells, trials, scores, spend and comparability."}}}},
    "LabExperimentsListRequest": {"type": "object", "additionalProperties": true},
    "LabPromoteReply": {"type": "object", "required": ["method", "cataloguePatch", "recommendation"], "properties": {"method": {}, "cataloguePatch": {}, "recommendation": {}, "catalogue": {"$ref": "ops.schema.json#/$defs/DefinitionRef"}, "note": {"type": ["string", "null"]}}, "$comment": "method: the promoted (or matching) catalogue method; catalogue: the catalogue revision a new method was saved as (source lab); cataloguePatch: null (a promote saves a revision); recommendation: the project's recommendation set to the method."},
    "LabPromoteRequest": {"type": "object", "required": ["experimentId", "variant"], "properties": {"experimentId": {"type": "string"}, "variant": {"type": "string"}}, "additionalProperties": true},
    "LabRatingCreateReply": {"type": "object", "additionalProperties": true, "$comment": "A rating question for a person."},
    "LabRatingForm": {"type": "string", "enum": ["pass_fail", "pick_best", "scale"]},
    "LabRatingCreateRequest": {"type": "object", "required": ["experimentId", "form", "trialIds"], "properties": {"experimentId": {"type": "string"}, "form": {"$ref": "#/$defs/LabRatingForm"}, "trialIds": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "LabRatingWithdrawRequest": {"type":"object","required":["questionId","reason"],"properties":{"questionId":{"type":"string"},"reason":{"type":"string"}},"additionalProperties":false},
    "LabRatingWithdrawReply": {"type":"object","additionalProperties":true,"$comment":"Withdrawn Lab rating, with original trial references and no answer/score."},
    "LabRatingGetReply": {"type": "object", "additionalProperties": true, "$comment": "A rating question for a person."},
    "LabRatingGetRequest": {"type": "object", "required": ["questionId"], "properties": {"questionId": {"type": "string"}}, "additionalProperties": true},
    "LabRatingsListReply": {"type": "object", "required": ["ratings"], "properties": {"ratings": {"type": "array", "items": {"type": "object", "additionalProperties": true}}}},
    "LabRatingsListRequest": {"type": "object", "properties": {"experimentId": {"type": "string"}, "state": {"type": "string"}}, "additionalProperties": true},
    "LabRegistryReply": {"type": "object", "required": ["useCases"], "properties": {"useCases": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "A Lab use case."}}}},
    "LabRegistryRequest": {"type": "object", "additionalProperties": true},
    "LabScoreCorrectReply": {"type": "object", "additionalProperties": true, "$comment": "The correcting score row."},
    "LabScoreCorrectRequest": {"type": "object", "required": ["scoreId", "value"], "properties": {"scoreId": {"type": "string"}, "value": {}, "rationale": {"type": "string"}}, "additionalProperties": true}
  }
}
