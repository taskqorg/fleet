{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Coordinator operations of the lab domain; the rules are in ops.schema.json $comment and contracts/README.md.",
  "operations": {
    "lab_cell_action": {"read": false, "long": true, "errors": [400, 404, 409]},
    "lab_example_get": {"read": true, "errors": [400, 404, 409, 503]},
    "lab_examples_add": {"read": false, "errors": [400, 403, 409]},
    "lab_examples_list": {"read": true, "errors": [400]},
    "lab_experiment_action": {"read": false, "long": true, "errors": [400, 404, 409]},
    "lab_experiment_create": {"read": false, "errors": [400, 403, 404, 409]},
    "lab_experiment_decide": {"read": false, "errors": [400, 404, 409]},
    "lab_experiment_get": {"read": true, "errors": [400, 404]},
    "lab_experiment_note": {"read": false, "errors": [400, 404]},
    "lab_experiments_list": {"read": true, "errors": []},
    "lab_promote": {"read": false, "errors": [400, 404]},
    "lab_rating_create": {"read": false, "errors": [400, 404, 409]},
    "lab_rating_get": {"read": true, "errors": [400, 404]},
    "lab_ratings_list": {"read": true, "errors": [404]},
    "lab_registry": {"read": true, "errors": []},
    "lab_score_correct": {"read": false, "errors": [400, 404, 409]}
  },
  "planned": {
    "lab_compare_methods": {"read": false, "errors": [400, 403, 404, 409]},
    "lab_experiment_promote": {"read": false, "errors": [400, 403, 404, 409]}
  },
  "$defs": {
    "LabCellActionReply": {"type": "object", "additionalProperties": true, "$comment": "An experiment view. Successful retry_suffix adds recovery:{sourceRunId:string,runId:string}, stable on replay. Recovered trials add recovery:{sourceRunId:string,reusedStepIds:string[]}; ordinary trials/actions omit it. See fleet-lab.md Local-suffix retry for identity/audit and provenance."},
    "LabCellActionRequest": {"type": "object", "required": ["experimentId", "cell", "action"], "properties": {"experimentId": {"type": "string"}, "cell": {"type": "string"}, "action": {"type": "string"}, "sourceRunId": {"type": "string"}, "requestId": {"type": "string"}}, "additionalProperties": true, "$comment": "action cancel, retry or retry_suffix. retry_suffix requires non-whitespace experimentId/cell/sourceRunId/requestId; accepted strings retain exact bytes. Other actions and unknown-field policy unchanged."},
    "LabCompareMethodsReply": {"type": "object", "required": ["experimentId"], "properties": {"experimentId": {"type": "string"}}},
    "LabCompareMethodsRequest": {"type": "object", "required": ["projectId", "capability", "methods"], "properties": {"projectId": {"type": "string"}, "capability": {"type": "string"}, "methods": {"type": "array", "items": {"type": "string"}}, "useCase": {"type": "string"}, "baseline": {"type": "string"}}},
    "LabExampleGetReply": {"type": "object", "required": ["artifactId", "example", "state"], "properties": {"artifactId": {"type": "string"}, "example": {}, "state": {}}},
    "LabExampleGetRequest": {"type": "object", "required": ["artifactId"], "properties": {"artifactId": {"type": "string"}}, "additionalProperties": true},
    "LabExamplesAddReply": {"type": "object", "required": ["examples"], "properties": {"examples": {"type": "array", "items": {"type": "object", "additionalProperties": true}}}},
    "LabExamplesAddRequest": {"type": "object", "required": ["examples"], "properties": {"projectId": {"type": "string"}, "examples": {}, "approved": {"type": "boolean"}}, "additionalProperties": true},
    "LabExamplesListReply": {"type": "object", "required": ["examples"], "properties": {"examples": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "A Lab example (an artifact with its state)."}}}},
    "LabExamplesListRequest": {"type": "object", "properties": {"state": {"type": "string"}}, "additionalProperties": true},
    "LabExperimentActionReply": {"type": "object", "additionalProperties": true, "$comment": "An experiment view (expView): record fields, state, variants, cells, trials, scores, spend and comparability."},
    "LabExperimentActionRequest": {"type": "object", "required": ["experimentId", "action"], "properties": {"experimentId": {"type": "string"}, "action": {"type": "string"}}, "additionalProperties": true, "$comment": "action launch, stop or resume."},
    "LabExperimentCreateReply": {"type": "object", "additionalProperties": true, "$comment": "An experiment view (expView): record fields, state, variants, cells, trials, scores, spend and comparability."},
    "LabExperimentCreateRequest": {"type": "object", "properties": {"projectId": {"type": "string"}, "pipelineId": {"type": "string"}, "kind": {"type": "string"}, "variants": {}, "examples": {}, "evaluators": {}, "primaryEvaluator": {}, "repeats": {}, "strategy": {}, "budgets": {}, "goal": {"type": "string"}, "hypothesis": {"type": "string"}, "decisionRule": {}, "labGroup": {}}, "additionalProperties": true, "$comment": "See fleet-lab.md, Experiment record."},
    "LabExperimentDecideReply": {"type": "object", "additionalProperties": true, "$comment": "An experiment view (expView): record fields, state, variants, cells, trials, scores, spend and comparability."},
    "LabExperimentDecideRequest": {"type": "object", "required": ["experimentId", "decision"], "properties": {"experimentId": {"type": "string"}, "decision": {"type": "string", "$comment": "adopt <variant> | keep baseline | inconclusive (pending is the coordinator's, never a person's)"}, "reason": {"type": "string", "$comment": "Required to override a decision already made; the override is an amendment."}}},
    "LabExperimentGetReply": {"type": "object", "additionalProperties": true, "$comment": "An experiment view (expView). Planned with the definition editors: baseline and vsBaseline. comparison: each non-baseline variant vs the first on the primary evaluator, {variant, baseline, evaluator, split, result: {n, mean, low, high, tooFew, examples}} (fleet-lab.md, Statistics). typed: per variant {variant, split, stats: [{tag, n, confident, correct, coverage, selectiveAccuracy, escalation}]}, the aggregate last with tag all."},
    "LabExperimentGetRequest": {"type": "object", "required": ["experimentId"], "properties": {"experimentId": {"type": "string"}}, "additionalProperties": true},
    "LabExperimentNoteReply": {"type": "object", "additionalProperties": true, "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "text": {"type": "string"}}},
    "LabExperimentNoteRequest": {"type": "object", "required": ["experimentId", "kind", "text"], "properties": {"experimentId": {"type": "string"}, "kind": {"type": "string", "$comment": "amendment | note"}, "field": {"type": "string", "$comment": "Amendment only: goal, hypothesis, decisionRule, labGroup or primaryEvaluator."}, "value": {"type": ["string", "null"]}, "text": {"type": "string"}}},
    "LabExperimentPromoteReply": {"type": "object", "required": ["method", "catalogue", "recommendation"], "properties": {"method": {"$ref": "ops.schema.json#/$defs/CatalogueMethod"}, "catalogue": {"$ref": "ops.schema.json#/$defs/DefinitionRef"}, "recommendation": {"type": ["string", "null"]}}},
    "LabExperimentPromoteRequest": {"type": "object", "required": ["experimentId", "variant"], "properties": {"experimentId": {"type": "string"}, "variant": {"type": "string"}}, "$comment": "Replaces lab_promote's request when lab_experiment_promote is built."},
    "LabExperimentsListReply": {"type": "object", "required": ["experiments"], "properties": {"experiments": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "An experiment view (expView): record fields, state, variants, cells, trials, scores, spend and comparability."}}}},
    "LabExperimentsListRequest": {"type": "object", "additionalProperties": true},
    "LabPromoteReply": {"type": "object", "required": ["method", "cataloguePatch", "recommendation"], "properties": {"method": {}, "cataloguePatch": {}, "recommendation": {}, "catalogue": {"$ref": "ops.schema.json#/$defs/DefinitionRef"}, "note": {"type": ["string", "null"]}}, "$comment": "method: the promoted (or matching) catalogue method; catalogue: the catalogue revision a new method was saved as (source lab); cataloguePatch: null (a promote saves a revision); recommendation: the project's recommendation set to the method."},
    "LabPromoteRequest": {"type": "object", "required": ["experimentId", "variant"], "properties": {"experimentId": {"type": "string"}, "variant": {"type": "string"}}, "additionalProperties": true},
    "LabRatingCreateReply": {"type": "object", "additionalProperties": true, "$comment": "A rating question for a person."},
    "LabRatingCreateRequest": {"type": "object", "required": ["experimentId", "form", "trialIds"], "properties": {"experimentId": {"type": "string"}, "form": {"type": "string"}, "trialIds": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "LabRatingGetReply": {"type": "object", "additionalProperties": true, "$comment": "A rating question for a person."},
    "LabRatingGetRequest": {"type": "object", "required": ["questionId"], "properties": {"questionId": {"type": "string"}}, "additionalProperties": true},
    "LabRatingsListReply": {"type": "object", "required": ["ratings"], "properties": {"ratings": {"type": "array", "items": {"type": "object", "additionalProperties": true}}}},
    "LabRatingsListRequest": {"type": "object", "properties": {"experimentId": {"type": "string"}, "state": {"type": "string"}}, "additionalProperties": true},
    "LabRegistryReply": {"type": "object", "required": ["useCases"], "properties": {"useCases": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "A Lab use case."}}}},
    "LabRegistryRequest": {"type": "object", "additionalProperties": true},
    "LabScoreCorrectReply": {"type": "object", "additionalProperties": true, "$comment": "The correcting score row."},
    "LabScoreCorrectRequest": {"type": "object", "required": ["scoreId", "value"], "properties": {"scoreId": {"type": "string"}, "value": {}, "rationale": {"type": "string"}}, "additionalProperties": true}
  }
}
