{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Coordinator operations of the definitions domain; the rules are in ops.schema.json $comment and contracts/README.md.",
  "operations": {
    "agent_compatibility": {"read": true, "errors": [400, 403, 404]},
    "agent_effective": {"read": true, "errors": [400, 403, 404]},
    "catalogue": {"read": true, "errors": [404]},
    "definition_create": {"read": false, "errors": [400, 403, 404, 409]},
    "definition_diff": {"read": true, "errors": [400, 403, 404]},
    "definition_draft_discard": {"read": false, "errors": [400, 403, 404, 409]},
    "definition_draft_get": {"read": true, "errors": [400, 403, 404]},
    "definition_draft_put": {"read": false, "errors": [400, 403, 404, 409]},
    "definition_export": {"read": true, "errors": [400, 403, 404]},
    "definition_get": {"read": true, "errors": [400, 403, 404]},
    "definition_history": {"read": true, "errors": [400, 403, 404]},
    "definition_list": {"read": true, "errors": [400, 403, 404]},
    "definition_save": {"read": false, "errors": [400, 403, 404, 409]},
    "definition_usage": {"read": true, "errors": [400, 403, 404]},
    "harness_models": {"read": true, "errors": [400, 403, 404]},
    "profiles_list": {"read": true, "errors": [400]},
    "reconcile": {"read": false, "errors": [400, 409]},
    "setting_changes": {"read": true, "errors": []}
  },
  "planned": {
    "agent_test": {"read": false, "errors": [400, 403, 404, 409]}
  },
  "$defs": {
    "Actor": {"type": "object", "required": ["kind"], "properties": {"kind": {"$ref": "#/$defs/ActorKind"}, "person": {"$ref": "#/$defs/Person"}, "executionId": {"type": "string"}, "directedBy": {"$ref": "#/$defs/Person"}}, "$comment": "person: the person (kind person); executionId: the agent execution (kind agent); system: reconcile. directedBy is set for person and agent."},
    "ActorKind": {"type": "string", "enum": ["person", "agent", "system"]},
    "AgentCompatibilityReply": {"type": "object", "required": ["rows"], "properties": {"rows": {"type": "array", "items": {"$ref": "#/$defs/CompatibilityRow"}}}},
    "AgentCompatibilityRequest": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}},
    "AgentDefinition": {"$ref": "profile.schema.json#/$defs/Profile", "$comment": "The agent profile (contracts/profile.schema.json); go/contract.ParseProfile is its validator."},
    "AgentEffectiveReply": {"type": "object", "required": ["layers", "result"], "properties": {"layers": {"type": "array", "items": {"$ref": "#/$defs/EffectiveLayer"}}, "result": {"$ref": "#/$defs/AgentDefinition"}}},
    "AgentEffectiveRequest": {"type": "object", "required": ["id", "projectId"], "properties": {"id": {"type": "string"}, "projectId": {"type": "string"}, "draft": {"type": "boolean"}}},
    "AgentListFacts": {"type": "object", "required": ["harness", "model", "roles"], "properties": {"harness": {"type": "string"}, "model": {"type": "string"}, "effort": {"type": ["string", "null"]}, "roles": {"type": "array", "items": {"type": "string"}}}, "$comment": "harness defaults as at session start; roles: the project roles (project.json roles) that name this profile."},
    "AgentTestReply": {"type": "object", "required": ["sessionId", "executionId", "definition"], "properties": {"sessionId": {"type": "string"}, "executionId": {"type": "string"}, "definition": {"$ref": "ops.schema.json#/$defs/DefinitionRef"}}},
    "AgentTestRequest": {"type": "object", "required": ["id", "projectId", "prompt"], "properties": {"id": {"type": "string"}, "projectId": {"type": "string"}, "prompt": {"type": "string"}, "draft": {"type": "boolean"}, "hostId": {"type": "string"}}, "$comment": "draft true uses the caller's draft; false the head revision."},
    "CatalogueDefinition": {"type": "object", "required": ["capability", "methods"], "$comment": "The whole config/catalogue.json as it is today (one capability).", "properties": {"capability": {"type": "string"}, "sharedDefault": {"type": "string"}, "methods": {"type": "array", "items": {"$ref": "ops.schema.json#/$defs/CatalogueMethod"}}}},
    "CatalogueReply": {"type": "object", "required": ["projectId", "capability", "sharedDefault", "recommendedMethod", "recommendationSource", "methods"], "properties": {"projectId": {"type": "string"}, "capability": {}, "sharedDefault": {}, "recommendedMethod": {}, "recommendationSource": {}, "methods": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "A catalogue method."}}}, "$comment": "The definition editors change methods to CatalogueMethodView items (docs/designs/fleet-definition-editors.md)."},
    "CatalogueRequest": {"type": "object", "required": ["projectId"], "properties": {"projectId": {"type": "string"}}, "additionalProperties": true},
    "CompatibilityRow": {"type": "object", "required": ["harness", "harnessVersion", "model", "state"], "properties": {"harness": {"type": "string"}, "harnessVersion": {"type": ["string", "null"]}, "model": {"type": "string"}, "effort": {"type": ["string", "null"]}, "state": {"$ref": "#/$defs/CompatibilityState"}, "revision": {"type": ["integer", "null"]}, "evidence": {"$ref": "#/$defs/RunSummary"}, "error": {"type": "string"}}},
    "CompatibilityState": {"type": "string", "enum": ["checked", "failed", "unchecked"]},
    "DefinitionContent": {"type": "object", "properties": {"agent": {"$ref": "#/$defs/AgentDefinition"}, "pipeline": {"$ref": "#/$defs/PipelineDefinition"}, "catalogue": {"$ref": "#/$defs/CatalogueDefinition"}}, "$comment": "Exactly one property, matching the kind."},
    "DefinitionCreateReply": {"type": "object", "required": ["revision"], "properties": {"revision": {"$ref": "#/$defs/Revision"}}},
    "DefinitionCreateRequest": {"type": "object", "required": ["kind", "id", "content", "message"], "properties": {"kind": {"$ref": "ops.schema.json#/$defs/DefinitionKind"}, "id": {"type": "string"}, "content": {"$ref": "#/$defs/DefinitionContent"}, "message": {"type": "string"}}},
    "DefinitionDiffReply": {"type": "object", "required": ["unified", "fields"], "properties": {"unified": {"type": "string"}, "fields": {"type": "array", "items": {"$ref": "#/$defs/FieldChange"}}}},
    "DefinitionDiffRequest": {"type": "object", "required": ["kind", "id", "from", "to"], "properties": {"kind": {"$ref": "ops.schema.json#/$defs/DefinitionKind"}, "id": {"type": "string"}, "from": {"$ref": "#/$defs/DiffSide"}, "to": {"$ref": "#/$defs/DiffSide"}}},
    "DefinitionDraftDiscardReply": {"type": "object", "required": ["discarded"], "properties": {"discarded": {"type": "boolean"}}},
    "DefinitionDraftDiscardRequest": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"$ref": "ops.schema.json#/$defs/DefinitionKind"}, "id": {"type": "string"}}},
    "DefinitionDraftGetReply": {"type": "object", "required": ["draft", "text"], "properties": {"draft": {"$ref": "#/$defs/DraftInfo"}, "content": {"$ref": "#/$defs/DefinitionContent"}, "problems": {"type": "array", "items": {"$ref": "#/$defs/Problem"}}, "text": {"type": "string"}}, "$comment": "No draft: 404. text: the draft as stored (canonical text), byte for byte."},
    "DefinitionDraftGetRequest": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"$ref": "ops.schema.json#/$defs/DefinitionKind"}, "id": {"type": "string"}}},
    "DefinitionDraftPutReply": {"type": "object", "required": ["draft", "problems"], "properties": {"draft": {"$ref": "#/$defs/DraftInfo"}, "problems": {"type": "array", "items": {"$ref": "#/$defs/Problem"}}}},
    "DefinitionDraftPutRequest": {"type": "object", "required": ["kind", "id", "baseRevision", "content"], "properties": {"kind": {"$ref": "ops.schema.json#/$defs/DefinitionKind"}, "id": {"type": "string"}, "baseRevision": {"type": "integer", "minimum": 0}, "content": {"$ref": "#/$defs/DefinitionContent"}}},
    "DefinitionExportReply": {"type": "object", "required": ["patch", "files", "covers"], "properties": {"patch": {"type": "string"}, "files": {"type": "array", "items": {"$ref": "#/$defs/ExportFile"}}, "covers": {"type": "array", "items": {"$ref": "ops.schema.json#/$defs/DefinitionRef"}}}},
    "DefinitionExportRequest": {"type": "object", "properties": {"keys": {"type": "array", "items": {"$ref": "#/$defs/DefinitionKey"}}}, "$comment": "No keys: every definition in state ahead or store-only. repository-changed and repository-deleted are never exported (named keys in those states: 409 repository-changed) until a save resolves them, so an export cannot revert a release."},
    "DefinitionGetReply": {"type": "object", "required": ["kind", "id", "path", "scope", "revision", "head", "state", "text", "content", "meta"], "properties": {"kind": {"$ref": "ops.schema.json#/$defs/DefinitionKind"}, "id": {"type": "string"}, "path": {"type": "string"}, "scope": {"type": "string"}, "revision": {"type": "integer"}, "head": {"type": "integer"}, "state": {"$ref": "#/$defs/DefinitionState"}, "repoSha": {"type": ["string", "null"]}, "text": {"type": "string"}, "content": {"$ref": "#/$defs/DefinitionContent"}, "meta": {"$ref": "#/$defs/Revision"}, "draft": {"$ref": "#/$defs/DraftInfo"}, "mirror": {"$ref": "#/$defs/MirrorState"}}},
    "DefinitionGetRequest": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"$ref": "ops.schema.json#/$defs/DefinitionKind"}, "id": {"type": "string"}, "revision": {"type": "integer", "minimum": 1}}},
    "DefinitionHistoryReply": {"type": "object", "required": ["revisions", "repoSha"], "properties": {"revisions": {"type": "array", "items": {"$ref": "#/$defs/Revision"}}, "repoSha": {"type": ["string", "null"]}}},
    "DefinitionHistoryRequest": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"$ref": "ops.schema.json#/$defs/DefinitionKind"}, "id": {"type": "string"}, "before": {"type": "integer"}, "limit": {"type": "integer", "minimum": 1}}},
    "DefinitionKey": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"$ref": "ops.schema.json#/$defs/DefinitionKind"}, "id": {"type": "string"}}},
    "DefinitionListItem": {"type": "object", "required": ["kind", "id", "name", "scope", "path", "revision", "state", "last30"], "properties": {"kind": {"$ref": "ops.schema.json#/$defs/DefinitionKind"}, "id": {"type": "string"}, "name": {"type": "string"}, "scope": {"type": "string"}, "path": {"type": "string"}, "revision": {"type": "integer"}, "state": {"$ref": "#/$defs/DefinitionState"}, "draft": {"$ref": "#/$defs/DraftInfo"}, "mirror": {"$ref": "#/$defs/MirrorState"}, "lastRun": {"$ref": "#/$defs/RunSummary"}, "last30": {"$ref": "#/$defs/Window"}, "agent": {"$ref": "#/$defs/AgentListFacts"}, "compatibility": {"$ref": "#/$defs/CompatibilityState"}}},
    "DefinitionListReply": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "#/$defs/DefinitionListItem"}}}},
    "DefinitionListRequest": {"type": "object", "required": ["kind"], "properties": {"kind": {"$ref": "ops.schema.json#/$defs/DefinitionKind"}, "projectId": {"type": "string"}, "includeRetired": {"type": "boolean"}}},
    "DefinitionSaveReply": {"type": "object", "required": ["revision", "state"], "properties": {"revision": {"$ref": "#/$defs/Revision"}, "state": {"$ref": "#/$defs/DefinitionState"}}},
    "DefinitionSaveRequest": {"type": "object", "required": ["kind", "id", "baseRevision", "content", "message"], "properties": {"kind": {"$ref": "ops.schema.json#/$defs/DefinitionKind"}, "id": {"type": "string"}, "baseRevision": {"type": "integer", "minimum": 1}, "content": {"$ref": "#/$defs/DefinitionContent"}, "message": {"type": "string"}, "repoSha": {"type": "string"}}},
    "DefinitionState": {"type": "string", "enum": ["synced", "ahead", "repository-changed", "store-only", "repository-deleted"]},
    "DefinitionUsageReply": {"type": "object", "required": ["usedBy", "total", "byRevision"], "properties": {"usedBy": {"type": "array", "items": {"$ref": "#/$defs/DefinitionKey"}}, "total": {"$ref": "#/$defs/Window"}, "byRevision": {"type": "array", "items": {"$ref": "#/$defs/RevisionWindow"}}}},
    "DefinitionUsageRequest": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"$ref": "ops.schema.json#/$defs/DefinitionKind"}, "id": {"type": "string"}, "days": {"type": "integer", "minimum": 1}}},
    "DiffSide": {"type": "object", "properties": {"revision": {"type": "integer", "minimum": 1}, "draft": {"type": "boolean"}, "repository": {"type": "boolean"}}, "$comment": "Exactly one of revision, draft (the caller's draft) or repository (the shipped file)."},
    "DraftInfo": {"type": "object", "required": ["baseRevision", "changes", "stale", "updatedAt"], "properties": {"baseRevision": {"type": "integer"}, "changes": {"type": "integer", "minimum": 0}, "stale": {"type": "boolean"}, "updatedAt": {"type": "string"}}},
    "EffectiveLayer": {"type": "object", "required": ["name", "source", "fields"], "properties": {"name": {"$ref": "#/$defs/EffectiveLayerName"}, "source": {"type": "string"}, "revision": {"type": ["string", "null"]}, "text": {"type": "string"}, "fields": {"type": "array", "items": {"type": "string"}}}, "$comment": "source is a path or a URL; revision is the store revision, the specq commit or the project file sha; fields lists the setting paths this layer decides."},
    "EffectiveLayerName": {"type": "string", "enum": ["shared-rules", "role", "definition", "project"]},
    "ExportFile": {"type": "object", "required": ["path", "text", "baseSha"], "properties": {"path": {"type": "string"}, "text": {"type": "string"}, "baseSha": {"type": ["string", "null"]}}},
    "FieldChange": {"type": "object", "required": ["path", "op"], "properties": {"path": {"type": "string"}, "op": {"$ref": "#/$defs/FieldOp"}, "fromText": {"type": "string"}, "toText": {"type": "string"}}, "$comment": "fromText and toText are the canonical JSON text of the old and new values; the editor uses path to place the attention tick."},
    "FieldOp": {"type": "string", "enum": ["add", "remove", "replace"]},
    "HarnessModel": {"type": "object", "required": ["id", "efforts", "source"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "efforts": {"type": "array", "items": {"type": "string"}}, "source": {"$ref": "#/$defs/ModelSource"}, "hosts": {"type": "array", "items": {"type": "string"}}}},
    "HarnessModelsReply": {"type": "object", "required": ["models"], "properties": {"models": {"type": "array", "items": {"$ref": "#/$defs/HarnessModel"}}}},
    "HarnessModelsRequest": {"type": "object", "required": ["harness"], "properties": {"harness": {"type": "string"}}},
    "MirrorState": {"type": "string", "enum": ["mirrored", "pending", "failed", "off"], "$comment": "Stage 2 only; the mirror and definition_mirror_reset fields and operation are added with it."},
    "ModelSource": {"type": "string", "enum": ["shipped", "reported"]},
    "Person": {"type": "object", "required": ["email", "name"], "properties": {"email": {"type": "string"}, "name": {"type": "string"}}},
    "PipelineDefinition": {"type": "object", "required": ["version", "id", "steps"], "properties": {"version": {"type": "integer"}, "id": {"type": "string"}, "steps": {"type": "array", "items": {"$ref": "#/$defs/PipelineStep"}}}, "$comment": "A pipeline file (config/pipelines/<id>.json); validatePipeline is its full check."},
    "PipelineStep": {"type": "object", "required": ["id", "kind"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "connection": {"type": "string"}, "tool": {"type": "string"}, "arguments": {}, "mode": {"type": "string"}, "output": {}, "profile": {"type": "string"}, "prompt": {"type": "string"}, "command": {"type": "string"}, "timeout_ms": {"type": "integer"}, "host": {"type": "string"}}, "$comment": "kind api (connection, tool, arguments, mode, output), agent (profile, prompt) or script (command, timeout_ms, host); validatePipeline is the full check."},
    "Problem": {"type": "object", "required": ["path", "message"], "properties": {"path": {"type": "string"}, "message": {"type": "string"}}, "$comment": "Validation finding; path is a JSON pointer into the content. A draft is stored even when invalid; save refuses it."},
    "ProfilesListReply": {"type": "object", "required": ["profiles"], "properties": {"profiles": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "An agent profile (contracts/profile.schema.json) as listed."}}}},
    "ProfilesListRequest": {"type": "object", "additionalProperties": true},
    "ReconcileReply": {"type": "object", "additionalProperties": true, "$comment": "What reconcile settled: queue and handoff state, and the executions it could not prove."},
    "ReconcileRequest": {"type": "object", "additionalProperties": true},
    "Revision": {"type": "object", "required": ["revision", "contentSha", "source", "actor", "message", "at"], "properties": {"revision": {"type": "integer", "minimum": 1}, "parent": {"type": ["integer", "null"]}, "contentSha": {"type": "string"}, "repoBase": {"type": ["string", "null"]}, "source": {"$ref": "#/$defs/RevisionSource"}, "actor": {"$ref": "#/$defs/Actor"}, "message": {"type": "string"}, "at": {"type": "string"}, "mirrorCommit": {"type": ["string", "null"]}}, "$comment": "mirrorCommit: stage 2 only."},
    "RevisionSource": {"type": "string", "enum": ["repo", "editor", "lab", "agent"]},
    "RevisionWindow": {"type": "object", "required": ["revision", "window"], "properties": {"revision": {"type": "integer"}, "window": {"$ref": "#/$defs/Window"}}},
    "RunSummary": {"type": "object", "required": ["state", "at"], "properties": {"executionId": {"type": "string"}, "state": {"type": "string"}, "at": {"type": "string"}}},
    "SettingChangesReply": {"type": "object", "required": ["changes", "nextBefore"], "properties": {"changes": {"type": "array", "items": {"type": "object", "additionalProperties": true, "$comment": "A setting-change record: target, field, previous, value, actor, at."}}, "nextBefore": {"type": ["integer", "null"]}}},
    "SettingChangesRequest": {"type": "object", "properties": {"target": {"type": "string"}, "limit": {"type": ["integer", "null"]}, "before": {"type": ["integer", "null"]}}, "additionalProperties": true, "$comment": "target: one setting target (host:<id>, connection:<name>, people, ...); before: the nextBefore of the previous page."},
    "Window": {"type": "object", "required": ["runs", "succeeded", "wallMsMedian", "tokens"], "properties": {"runs": {"type": "integer"}, "succeeded": {"type": "integer"}, "wallMsMedian": {"type": ["integer", "null"]}, "tokens": {"type": "integer"}, "costUsd": {"type": ["number", "null"]}, "costBasis": {"type": "string"}}}
  }
}
