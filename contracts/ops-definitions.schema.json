{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Coordinator operations of the definitions domain; the rules are in ops.schema.json $comment and contracts/README.md.",
  "operations": {
    "library_view": {"read": true, "view": true, "errors": [400], "auth": "person", "agent": "tool", "changes": ["definition", "project-recommendation", "bot", "execution", "setting-change", "question"], "description": "The Library tree in one read (an architect's; another person's holds the bots and empty lists): the agents, pipelines and methods (last30 with runs, successes, tokens and median wall time, without the resource rollup: definition_usage has it), the skills, the bots of the focus (projectIds or excludeProjectIds), the drift Changes shows (system_changes; host observations do not reread it, so hosts behind show on the next read) and the recommendations projects chose in the last 7 days."},
    "definition_delete": {"read": false, "errors": [400,403,404,409], "auth": "owner", "agent": "tool", "description": "Owner only: delete an agent or pipeline definition nothing uses (kind, id, preview). Preview first: refused says why not (shipped by the repository, used by a definition, unfinished executions, live Lab experiments); the id stays reserved and a revision an execution pinned stays readable (definition_get with revision); a deleted one whose file the repository ships again comes back"},
    "agent_compatibility": {"read": true, "errors": [400,403,404], "auth": "architect", "agent": "tool", "changes": ["definition"], "description": "Hosts and harnesses an agent definition (id) can run on, with the reason for each host that cannot"},
    "agent_gaps": {"read": true, "view": true, "errors": [400], "auth": "person", "agent": "tool", "changes": ["execution", "question"], "description": "What agents lack: failed agent tool calls and gateway calls of the last days (default 7, at most 30) grouped by gap class (config/agent-gaps.json), each with its daily counts, the previous window's count, counts by host, harness, profile, tool and project, the newest examples (execution, its conversation or task, the decisive line) and the setting that controls the class. class narrows to one class or family; hostId, profileId and projectId narrow the failures counted."},
    "agent_gaps_reclassify": {"read": false, "long": true, "errors": [400], "auth": "owner", "agent": "tool", "description": "Owner or full access: classify the failures of the last days (default 30, at most 90) again with the current rules of config/agent-gaps.json; answers how many executions and failures it read and the gaps it recorded"},
    "agent_gaps_link": {"read": false, "errors": [400, 404, 409], "auth": "person", "agent": "tool", "description": "Link the pull request (pr, a taskqorg/fleet number) that changes the setting of an agent gap finding (class); the finding then watches its class: when that release runs on every host it compares the class's rate per agent run before and after over the same window, and closes as fixed or asks again as still failing"},
    "agent_effective": {"read": true, "errors": [400,403,404], "auth": "architect", "agent": "tool", "changes": ["definition"], "description": "The effective configuration of an agent definition (id) in a project (projectId), optionally of its draft"},
    "catalogue": {"read": true, "errors": [404], "auth": "project:projectId", "agent": "tool", "changes": ["definition", "experiment", "score", "execution", "project-recommendation"], "description": "The method catalogue of a project's capability (projectId): methods, the recommended one and its source"},
    "recommendation_changes": {"read": true, "errors": [400,404], "auth": "architect", "agent": "tool", "changes": ["project-recommendation", "definition"], "description": "Recommended methods that projects selected in the last days (days, default 7, at most 90), newest first: project, method id and name, the Lab experiment it was promoted from, when and by whom"},
    "definition_create": {"read": false, "errors": [400,403,404,409], "auth": "architect", "agent": "tool", "description": "Create a definition (kind, id, content, message) as its first revision"},
    "definition_diff": {"read": true, "errors": [400,403,404], "auth": "architect", "agent": "tool", "changes": ["definition"], "description": "The difference between two revisions of a definition (kind, id, from, to)"},
    "definition_draft_discard": {"read": false, "errors": [400,403,404,409], "auth": "architect", "agent": "tool", "description": "Discard your draft of a definition (kind, id)"},
    "definition_draft_get": {"read": true, "errors": [400,403,404], "auth": "architect", "agent": "tool", "changes": ["definition"], "description": "Your draft of a definition (kind, id)"},
    "definition_draft_put": {"read": false, "errors": [400,403,404,409], "auth": "architect", "agent": "tool", "description": "Store your draft of a definition (kind, id, baseRevision, content)"},
    "definition_export": {"read": true, "errors": [400,403,404], "auth": "architect", "agent": "tool", "description": "No keys: every definition in state ahead or store-only. repository-changed and repository-deleted are never exported (named keys in those states: 409 repository-changed) until a save resolves them, so an export cannot revert a release."},
    "definition_get": {"read": true, "errors": [400,403,404], "auth": "architect", "agent": "tool", "changes": ["definition"], "description": "A definition (kind, id) at its head or at revision"},
    "definition_history": {"read": true, "errors": [400,403,404], "auth": "architect", "agent": "tool", "changes": ["definition"], "description": "Revisions of a definition (kind, id), newest first, paged with before and limit"},
    "definition_list": {"read": true, "errors": [400,403,404], "auth": "architect", "agent": "tool", "changes": ["definition"], "description": "Definitions of a kind, optionally of one project or with retired ones"},
    "definition_save": {"read": false, "errors": [400,403,404,409], "auth": "architect", "agent": "tool", "description": "Save a new revision of a definition (kind, id, baseRevision, content, message, optional repoSha); refused when the head moved"},
    "definition_publish": {"read": false, "errors": [400,403,404,409], "auth": "architect", "agent": "tool", "description": "Send Fleet edits of agents, pipelines or the catalogue to the repository (keys[], preview): one Fleet task whose worker opens the pull request; a save does it by itself"},
    "definition_take_repository": {"read": false, "errors": [400,403,404,409], "auth": "architect", "agent": "tool", "description": "Take the repository version for one or more repository-changed definitions (keys[], message, preview)"},
    "definition_add_skill": {"read": false, "errors": [400,403,404,409], "auth": "architect", "agent": "tool", "description": "Add a shipped skill to named agents or all agents in a category (skill, agents[] or category, message, preview)"},
    "definition_usage": {"read": true, "errors": [400,403,404], "auth": "architect", "agent": "tool", "changes": ["definition"], "description": "Where a definition (kind, id) is used and how it ran in the last days"},
    "harness_models": {"read": true, "errors": [400,403,404], "auth": "architect", "agent": "tool", "description": "Models a harness offers"},
    "profiles_list": {"read": true, "errors": [400], "auth": "architect", "agent": "tool", "changes": ["definition"], "description": "Agent profiles"},
    "reconcile": {"read": false, "errors": [400,409], "auth": "architect", "agent": "bound:session", "description": "Settle coordinator-owned queue/handoff state and report unproven executions"},
    "setting_changes": {"read": true, "errors": [], "auth": "person", "agent": "tool", "description": "target: one setting target (host:<id>, connection:<name>, people, ...); before: the nextBefore of the previous page."},
    "skills_list": {"read": true, "errors": [], "auth": "architect", "agent": "tool", "changes": ["definition"], "description": "Shipped skills in config/skills/ with metadata, instructions, and rollout across agent definitions"}
  },
  "planned": {
    "agent_test": {"read": false, "errors": [400, 403, 404, 409]}
  },
  "$defs": {
    "AgentGapsRequest": {"type": "object", "unevaluatedProperties": false, "properties": {"days": {"type": "integer", "minimum": 1, "$comment": "The window in days back from now, 1 to 30; default 7."}, "class": {"type": "string", "$comment": "One class (missing-command:jq) or a family (missing-command)."}, "hostId": {"type": "string"}, "profileId": {"type": "string"}, "projectId": {"type": "string"}}},
    "AgentGapsReply": {"type": "object", "required": ["from", "to", "days", "rules", "total", "other", "runs", "calls", "threshold", "classes"], "properties": {"runs": {"type": "integer", "$comment": "Distinct agent runs with a failed tool call in the window."}, "calls": {"type": "integer", "$comment": "Failed gateway calls in the window."}, "threshold": {"$ref": "#/$defs/AgentGapThreshold"}, "from": {"type": "string", "$comment": "RFC 3339, the window's start (UTC midnight days-1 days before today)."}, "to": {"type": "string"}, "days": {"type": "integer"}, "rules": {"type": "string", "$comment": "The digest of config/agent-gaps.json the coordinator classifies with."}, "classifiedWith": {"type": "array", "items": {"type": "string"}, "$comment": "Rule digests of the counted failures; another digest than rules means the window is not reclassified yet."}, "total": {"type": "integer", "$comment": "Failures counted in the window."}, "other": {"type": "integer", "$comment": "Of them, those no rule names (class other)."}, "truncated": {"type": "boolean", "$comment": "True when the window held more failures than one read counts (50000): the oldest, the previous window first, are left out."}, "classes": {"type": "array", "items": {"$ref": "#/$defs/AgentGapClass"}, "$comment": "Most failures first."}}},
    "AgentGapClass": {"type": "object", "required": ["class", "family", "label", "source", "title", "count", "previousCount", "executions", "daily", "hosts", "harnesses", "profiles", "tools", "projects", "examples", "setting", "firstAt", "lastAt"], "properties": {"class": {"type": "string"}, "family": {"type": "string"}, "label": {"type": "string", "$comment": "The class in plain words: python missing, Sandbox blocks writes."}, "source": {"type": "string", "$comment": "agent (counts runs) or gateway (counts calls): the source of the newest failure."}, "aboveThreshold": {"type": "boolean", "$comment": "The class passes the finding threshold (other never does); present only when days is the finding window (threshold.days)."}, "title": {"type": "string"}, "count": {"type": "integer"}, "previousCount": {"type": "integer", "$comment": "Failures of this class in the same number of days before the window."}, "executions": {"type": "integer", "$comment": "Distinct executions with a failure of this class."}, "daily": {"type": "array", "items": {"$ref": "#/$defs/AgentGapDay"}, "$comment": "Every day of the window, oldest first, zero days included."}, "hosts": {"type": "array", "items": {"$ref": "#/$defs/AgentGapCount"}}, "harnesses": {"type": "array", "items": {"$ref": "#/$defs/AgentGapCount"}}, "profiles": {"type": "array", "items": {"$ref": "#/$defs/AgentGapCount"}}, "tools": {"type": "array", "items": {"$ref": "#/$defs/AgentGapCount"}}, "projects": {"type": "array", "items": {"$ref": "#/$defs/AgentGapCount"}}, "examples": {"type": "array", "items": {"$ref": "#/$defs/AgentGapExample"}, "$comment": "The newest five, one per execution."}, "setting": {"$ref": "#/$defs/AgentGapSetting"}, "firstAt": {"type": "string", "$comment": "Empty when the window holds none (a finding's class after its fix)."}, "lastAt": {"type": "string"}, "finding": {"$ref": "#/$defs/AgentGapFinding"}}},
    "AgentGapFinding": {"type": "object", "required": ["class", "state", "openedAt", "updatedAt"], "properties": {"class": {"type": "string"}, "state": {"$ref": "#/$defs/AgentGapFindingState", "$comment": "open: its problem (cause gap:<class>) is with its owner bot; linked: a pull request is named, waiting for its release on every host; watching: the release runs everywhere (changeAt), the after window fills; fixed or still-failing: the verdict."}, "problemId": {"type": "string", "$comment": "The finding's problem (problem_get)."}, "sessionId": {"type": "string", "$comment": "A PM conversation an earlier Investigate started."}, "pr": {"type": "integer"}, "prUrl": {"type": "string"}, "release": {"type": "string"}, "changeAt": {"type": "string", "$comment": "RFC 3339: when the pull request's release ran on the coordinator and every host seen in the last hour; the marker on the class's sparkline."}, "beforeCount": {"type": "integer", "$comment": "Failures of the class in the watch window before changeAt."}, "beforeRuns": {"type": "integer", "$comment": "Agent runs started in that window."}, "afterCount": {"type": "integer"}, "afterRuns": {"type": "integer"}, "verdictAt": {"type": "string"}, "note": {"type": "string"}, "openedAt": {"type": "string"}, "updatedAt": {"type": "string"}}},
    "AgentGapFindingState": {"type": "string", "enum": ["open", "linked", "watching", "fixed", "still-failing"]},
    "AgentGapsLinkReply": {"type": "object", "required": ["finding"], "properties": {"finding": {"$ref": "#/$defs/AgentGapFinding"}}},
    "AgentGapsLinkRequest": {"type": "object", "unevaluatedProperties": false, "required": ["class", "pr"], "properties": {"class": {"type": "string"}, "pr": {"type": "integer", "minimum": 1}}},
    "AgentGapThreshold": {"type": "object", "required": ["days", "minCount", "minExecutions", "watchDays", "fixedRatio"], "properties": {"days": {"type": "integer"}, "minCount": {"type": "integer"}, "minExecutions": {"type": "integer"}, "watchDays": {"type": "integer"}, "fixedRatio": {"type": "number"}}, "$comment": "The finding section of config/agent-gaps.json."},
    "AgentGapDay": {"type": "object", "required": ["day", "count"], "properties": {"day": {"type": "string", "$comment": "YYYY-MM-DD (UTC)."}, "count": {"type": "integer"}}},
    "AgentGapCount": {"type": "object", "required": ["key", "count"], "properties": {"key": {"type": "string", "$comment": "The host, harness, profile, tool or project id; '-' when the failure has none."}, "count": {"type": "integer"}}, "$comment": "Most first."},
    "AgentGapExample": {"type": "object", "required": ["executionId", "at", "source", "tool", "line"], "properties": {"executionId": {"type": "string"}, "at": {"type": "string"}, "source": {"type": "string", "$comment": "agent (a harness tool call) or gateway (a connection call)."}, "tool": {"type": "string"}, "line": {"type": "string", "$comment": "The decisive line of the failure, at most 200 characters."}, "hostId": {"type": "string"}, "harness": {"type": "string"}, "profileId": {"type": "string"}, "projectId": {"type": "string"}, "path": {"type": "string", "$comment": "The app path that shows the execution: its conversation, task or Lab experiment."}}},
    "AgentGapSetting": {"type": "object", "required": ["kind", "ref", "text"], "properties": {"kind": {"type": "string", "$comment": "host-tools, sandbox, profile, connection, keys, catalogue, contract or rules."}, "ref": {"type": "string", "$comment": "The file or operation that holds the setting."}, "text": {"type": "string", "$comment": "What a fix there does for every future agent."}}},
    "AgentGapsReclassifyRequest": {"type": "object", "unevaluatedProperties": false, "properties": {"days": {"type": "integer", "minimum": 1, "$comment": "1 to 90; default 30."}}},
    "AgentGapsReclassifyReply": {"type": "object", "required": ["rules", "executions", "failures", "gaps"], "properties": {"rules": {"type": "string"}, "executions": {"type": "integer"}, "failures": {"type": "integer", "$comment": "Failed tool calls and gateway calls read."}, "gaps": {"type": "integer", "$comment": "Rows recorded (failures less the skipped and the shell failures no rule names)."}}},
    "DefinitionDeleteRequest": {"type": "object", "required": ["kind", "id", "preview"], "properties": {"kind": {"$ref": "ops.schema.json#/$defs/DefinitionKind"}, "id": {"type": "string"}, "preview": {"type": "boolean"}}, "additionalProperties": false, "$comment": "Owner only (fleet-definition-editors.md, Delete). Deletes a definition nothing uses: an agent or pipeline in state store-only or repository-deleted that no definition names (definition_usage usedBy), no unfinished execution runs and no live Lab experiment runs. A shipped definition is refused: the repository would bring it back; delete its file. preview true changes nothing and answers refused with the reason; false refuses with 409 and that reason. The definition row and its revisions stay (retired and deleted), so the id is never reused and definition_get with a revision still reads a pinned one; it leaves every list, head read, draft and run."},
    "DefinitionDeleteReply": {"type": "object", "required": ["kind", "id", "state", "usedBy", "running", "experiments", "deleted"], "properties": {"kind": {"$ref": "ops.schema.json#/$defs/DefinitionKind"}, "id": {"type": "string"}, "state": {"$ref": "#/$defs/DefinitionState"}, "usedBy": {"type": "array", "items": {"$ref": "#/$defs/DefinitionKey"}}, "running": {"type": "integer"}, "experiments": {"type": "array", "items": {"type": "string"}}, "refused": {"type": "string"}, "deleted": {"type": "boolean"}}, "$comment": "usedBy: definitions naming it; running: unfinished executions pinning it; experiments: live Lab experiments running it; refused: why it cannot be deleted now."},
    "PipelineConditionSource": {"type": "object", "required": ["step", "path"], "properties": {"step": {"type": "string"}, "path": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "PipelineBooleanCondition": {"type": "object", "required": ["kind", "source", "equals"], "properties": {"kind": {"const": "boolean"}, "source": {"$ref": "#/$defs/PipelineConditionSource"}, "equals": {"type": "boolean"}}, "additionalProperties": false},
    "PipelineEnumCondition": {"type": "object", "required": ["kind", "source", "domain", "equals"], "properties": {"kind": {"const": "enum"}, "source": {"$ref": "#/$defs/PipelineConditionSource"}, "domain": {"type": "array", "items": {"type": "string"}}, "equals": {"type": "string"}}, "additionalProperties": false},
    "PipelineCondition": {"oneOf": [{"$ref": "#/$defs/PipelineBooleanCondition"}, {"$ref": "#/$defs/PipelineEnumCondition"}]},
    "Actor": {"type": "object", "required": ["kind"], "properties": {"kind": {"$ref": "#/$defs/ActorKind"}, "person": {"$ref": "#/$defs/Person"}, "executionId": {"type": "string"}, "directedBy": {"$ref": "#/$defs/Person"}}, "$comment": "person: the person (kind person); executionId: the agent execution (kind agent); system: reconcile. directedBy is set for person and agent."},
    "ActorKind": {"type": "string", "enum": ["person", "agent", "system"]},
    "AgentCompatibilityReply": {"type": "object", "required": ["rows"], "properties": {"rows": {"type": "array", "items": {"$ref": "#/$defs/CompatibilityRow"}}}},
    "AgentCompatibilityRequest": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}},
    "AgentDefinition": {"$ref": "profile.schema.json#/$defs/Profile", "$comment": "The agent profile (contracts/profile.schema.json); go/contract.ParseProfile is its validator."},
    "AgentEffectiveReply": {"type": "object", "required": ["layers", "result"], "properties": {"layers": {"type": "array", "items": {"$ref": "#/$defs/EffectiveLayer"}}, "result": {"$ref": "#/$defs/AgentDefinition"}}},
    "AgentEffectiveRequest": {"type": "object", "required": ["id", "projectId"], "properties": {"id": {"type": "string"}, "projectId": {"type": "string"}, "draft": {"type": "boolean"}}},
    "AgentListFacts": {"type": "object", "required": ["harness", "model", "roles"], "properties": {"harness": {"type": "string"}, "model": {"type": "string"}, "effort": {"type": ["string", "null"]}, "roles": {"type": "array", "items": {"type": "string"}}, "purpose": {"type": "string"}, "category": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}, "icon": {"type": "string"}, "monogram": {"type": "string"}, "variantOf": {"type": "string"}, "experiment": {"type": "string"}, "skills": {"type": "array", "items": {"type": "string"}}, "usedBy": {"type": "array", "items": {"$ref": "#/$defs/DefinitionKey"}}}, "$comment": "harness defaults as at session start; roles: the project roles (project.json roles) that name this profile."},
    "BulkOpStatus": {"type": "string", "enum": ["would-apply", "applied", "skipped", "error"]},
    "DefinitionBulkResult": {"type": "object", "required": ["kind", "id", "status"], "properties": {"kind": {"$ref": "ops.schema.json#/$defs/DefinitionKind"}, "id": {"type": "string"}, "status": {"$ref": "#/$defs/BulkOpStatus"}, "revision": {"type": "integer"}, "reason": {"type": "string"}}, "additionalProperties": false},
    "DefinitionPublishRequest": {"type": "object", "required": ["keys", "preview"], "properties": {"keys": {"type": "array", "items": {"$ref": "#/$defs/DefinitionKey"}}, "preview": {"type": "boolean"}, "keep": {"type": "boolean", "$comment": "a repository-changed head (a conflict): keep the Fleet version, rebased on the repository file it replaces, and send it"}}, "additionalProperties": false},
    "DefinitionPublishReply": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "#/$defs/DefinitionBulkResult"}}, "taskId": {"type": "string", "$comment": "the Fleet task whose worker opens the pull request; absent in a preview or when nothing applied"}}, "additionalProperties": false},
    "DefinitionTakeRepositoryRequest": {"type": "object", "required": ["keys", "preview"], "properties": {"keys": {"type": "array", "items": {"$ref": "#/$defs/DefinitionKey"}}, "message": {"type": "string"}, "preview": {"type": "boolean"}}, "additionalProperties": false},
    "DefinitionTakeRepositoryReply": {"type": "object", "required": ["items", "applied"], "properties": {"items": {"type": "array", "items": {"$ref": "#/$defs/DefinitionBulkResult"}}, "applied": {"type": "integer"}}, "additionalProperties": false},
    "DefinitionAddSkillRequest": {"type": "object", "required": ["skill", "preview"], "properties": {"skill": {"type": "string"}, "agents": {"type": "array", "items": {"type": "string"}}, "category": {"type": "string"}, "message": {"type": "string"}, "preview": {"type": "boolean"}}, "additionalProperties": false},
    "DefinitionAddSkillReply": {"type": "object", "required": ["skill", "items", "applied"], "properties": {"skill": {"type": "string"}, "items": {"type": "array", "items": {"$ref": "#/$defs/DefinitionBulkResult"}}, "applied": {"type": "integer"}}, "additionalProperties": false},
    "SkillSummary": {"type": "object", "required": ["id", "name", "description", "path", "body", "agents", "repoAgents", "totalAgents"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "path": {"type": "string"}, "body": {"type": "string"}, "agents": {"type": "array", "items": {"type": "string"}}, "repoAgents": {"type": "array", "items": {"type": "string"}}, "totalAgents": {"type": "integer"}}, "additionalProperties": false},
    "SkillsListRequest": {"type": "object", "additionalProperties": true},
    "SkillsListReply": {"type": "object", "required": ["skills"], "properties": {"skills": {"type": "array", "items": {"$ref": "#/$defs/SkillSummary"}}}, "additionalProperties": false},
    "AgentTestReply": {"type": "object", "required": ["sessionId", "executionId", "definition"], "properties": {"sessionId": {"type": "string"}, "executionId": {"type": "string"}, "definition": {"$ref": "ops.schema.json#/$defs/DefinitionRef"}}},
    "AgentTestRequest": {"type": "object", "required": ["id", "projectId", "prompt"], "properties": {"id": {"type": "string"}, "projectId": {"type": "string"}, "prompt": {"type": "string"}, "draft": {"type": "boolean"}, "hostId": {"type": "string"}}, "$comment": "draft true uses the caller's draft; false the head revision."},
    "CatalogueDefinition": {"type": "object", "required": ["capability", "methods"], "$comment": "The whole config/catalogue.json as it is today (one capability).", "properties": {"capability": {"type": "string"}, "sharedDefault": {"type": "string"}, "methods": {"type": "array", "items": {"$ref": "ops.schema.json#/$defs/CatalogueMethod"}}}},
    "CatalogueReply": {"type": "object","required": ["projectId","capability","sharedDefault","recommendedMethod","recommendationSource","methods"],"properties": {"projectId": {"type": "string"},"capability": {},"sharedDefault": {},"recommendedMethod": {},"recommendationSource": {},"methods": {"type": "array","items": {"$ref": "ops.schema.json#/$defs/CatalogueMethodView"}}}},
    "CatalogueRequest": {"type": "object", "required": ["projectId"], "properties": {"projectId": {"type": "string"}}, "additionalProperties": true},
    "CompatibilityRow": {"type": "object", "required": ["harness", "harnessVersion", "model", "state"], "properties": {"harness": {"type": "string"}, "harnessVersion": {"type": ["string", "null"]}, "model": {"type": "string"}, "effort": {"type": ["string", "null"]}, "state": {"$ref": "#/$defs/CompatibilityState"}, "revision": {"type": ["integer", "null"]}, "evidence": {"$ref": "#/$defs/RunSummary"}, "error": {"type": "string"}}},
    "CompatibilityState": {"type": "string", "enum": ["checked", "failed", "unchecked"]},
    "DefinitionContent": {"type": "object", "properties": {"agent": {"$ref": "#/$defs/AgentDefinition"}, "pipeline": {"$ref": "#/$defs/PipelineDefinition"}, "catalogue": {"$ref": "#/$defs/CatalogueDefinition"}, "project": {"$ref": "ops-projects.schema.json#/$defs/ProjectBundle"}}, "$comment": "Exactly one property, matching the kind."},
    "DefinitionCreateReply": {"type": "object", "required": ["revision"], "properties": {"revision": {"$ref": "#/$defs/Revision"}}},
    "DefinitionCreateRequest": {"type": "object", "required": ["kind", "id", "content", "message"], "properties": {"kind": {"$ref": "ops.schema.json#/$defs/DefinitionKind"}, "id": {"type": "string"}, "content": {"$ref": "#/$defs/DefinitionContent"}, "message": {"type": "string"}}},
    "DefinitionDiffReply": {"type": "object", "required": ["unified", "fields"], "properties": {"unified": {"type": "string"}, "fields": {"type": "array", "items": {"$ref": "#/$defs/FieldChange"}}}},
    "DefinitionDiffRequest": {"type": "object", "required": ["kind", "id", "from", "to"], "properties": {"kind": {"$ref": "ops.schema.json#/$defs/DefinitionKind"}, "id": {"type": "string"}, "from": {"$ref": "#/$defs/DiffSide"}, "to": {"$ref": "#/$defs/DiffSide"}}},
    "DefinitionDraftDiscardReply": {"type": "object", "required": ["discarded"], "properties": {"discarded": {"type": "boolean"}}},
    "DefinitionDraftDiscardRequest": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"$ref": "ops.schema.json#/$defs/DefinitionKind"}, "id": {"type": "string"}}},
    "DefinitionDraftGetReply": {"type": "object", "required": ["draft", "text"], "properties": {"draft": {"$ref": "#/$defs/DraftInfo"}, "content": {"$ref": "#/$defs/DefinitionContent"}, "problems": {"type": "array", "items": {"$ref": "#/$defs/Problem"}}, "text": {"type": "string"}}, "$comment": "No draft: 404. text: the draft as stored (canonical text), byte for byte."},
    "DefinitionDraftGetRequest": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"$ref": "ops.schema.json#/$defs/DefinitionKind"}, "id": {"type": "string"}}},
    "DefinitionDraftPutReply": {"type": "object", "required": ["draft", "problems"], "properties": {"draft": {"$ref": "#/$defs/DraftInfo"}, "problems": {"type": "array", "items": {"$ref": "#/$defs/Problem"}}}},
