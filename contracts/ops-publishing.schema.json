{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Coordinator operations and host CI diagnostics for unified project publishing (GitHub PR + GitLab MR parity).",
  "operations": {
    "publishing_report_blocker": {
      "read": false,
      "errors": [400, 403, 404, 409],
      "auth": "person",
      "agent": "bound:session",
      "description": "Report a persistent publishing access, diagnostic or provider blocker to Problems duty. Use for operational blockers after checking available evidence, never ask a person to fetch logs or rerun CI. No log text, credential values or human question."
    },
    "publishing_rerun_failed": {
      "read": false,
      "errors": [400, 403, 404, 409],
      "auth": "person",
      "agent": "bound:session",
      "description": "Request one policy-granted retry of verified failed CI on the source execution's current pull request head. Returns the durable recovery record."
    },
    "publishing_ci_recovery": {
      "read": true,
      "errors": [400, 404],
      "auth": "person",
      "agent": "bound:session",
      "description": "Read durable PR-head CI recovery records for a visible project, without invoking the provider."
    },
    "publishing_capabilities": {
      "read": true,
      "errors": [400, 404],
      "auth": "person",
      "agent": "tool",
      "description": "Inspect project publishing capabilities per bound repository: detected provider (github or gitlab), host, repository slug, branch/integration policy, eligible hosts, provider facts readiness and publication support."
    },
    "publishing_status": {
      "read": true,
      "errors": [400, 404],
      "auth": "person",
      "agent": "tool",
      "changes": ["delivery:delivery-state:"],
      "description": "Read unified publishing status across visible projects (GitHub pull requests and GitLab merge requests, including self-hosted GitLab): lifecycle stage, checks, review state, merge readiness, releases, host landing and project capabilities."
    },
    "publishing_publish_draft": {
      "read": false,
      "long": true,
      "errors": [400, 403, 404, 409],
      "auth": "person",
      "agent": "bound:session",
      "description": "Push the bound execution branch and open or reuse a draft pull request (GitHub) or draft merge request (GitLab). Enforces repository, branch, host and profile authority plus optional expectedHeadSha fencing."
    },
    "publishing_record_code_review": {
      "read": false,
      "long": true,
      "errors": [400, 403, 404, 409],
      "auth": "person",
      "agent": "bound:session",
      "description": "Verify stored Fleet review evidence referencing expectedHeadSha, write an audit row, and post and read back the code-review commit status on the provider (GitHub or GitLab)."
    },
    "publishing_mark_ready": {
      "read": false,
      "long": true,
      "errors": [400, 403, 404, 409],
      "auth": "person",
      "agent": "bound:session",
      "description": "Mark a draft pull request or merge request ready for review idempotently, fenced by optional expectedHeadSha."
    },
    "publishing_request_merge": {
      "read": false,
      "long": true,
      "errors": [400, 403, 404, 409],
      "auth": "person",
      "agent": "bound:session",
      "description": "Enable provider auto-merge / merge-when-pipeline-succeeds (or enqueue in merge queue) using project mergeMethod and autoMerge authority without admin bypass, fenced by optional expectedHeadSha."
    },
    "publishing_cancel_merge_request": {
      "read": false,
      "long": true,
      "errors": [400, 403, 404, 409],
      "auth": "person",
      "agent": "bound:session",
      "description": "Cancel an active auto-merge request, merge-when-pipeline-succeeds flag, or merge queue entry idempotently, fenced by optional expectedHeadSha."
    }
  },
  "$defs": {
    "PublishingBlockerOperation": {"type": "string", "enum": ["ci_logs", "rerun_failed", "status", "publish_draft", "record_code_review", "mark_ready", "request_merge", "release", "host_landing"]},
    "PublishingBlockerReason": {"type": "string", "enum": ["access_unavailable", "diagnostics_unavailable", "provider_unavailable", "outcome_unconfirmed"]},
    "PublishingReportBlockerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "reason"],
      "properties": {
        "projectId": {"type": "string"},
        "sourceExecutionId": {"type": "string"},
        "operation": {"$ref": "#/$defs/PublishingBlockerOperation"},
        "reason": {"$ref": "#/$defs/PublishingBlockerReason"},
        "number": {"type": "integer", "minimum": 1},
        "expectedHeadSha": {"type": "string"},
        "runId": {"type": "integer", "minimum": 1},
        "attempt": {"type": "integer", "minimum": 1},
        "jobId": {"type": "integer", "minimum": 1}
      }
    },
    "PublishingReportBlockerReply": {"$ref": "ops-tasks.schema.json#/$defs/ProblemGetReply"},
    "PublishingRerunFailedRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "number", "expectedHeadSha", "runId", "attempt", "reason"],
      "properties": {
        "projectId": {"type": "string"},
        "sourceExecutionId": {"type": "string"},
        "requestId": {"type": "string"},
        "number": {"type": "integer", "minimum": 1},
        "expectedHeadSha": {"type": "string"},
        "runId": {"type": "integer", "minimum": 1},
        "attempt": {"type": "integer", "minimum": 1},
        "reason": {"type": "string"}
      }
    },
    "PublishingCIRerunPolicy": {
      "$comment": "Approval for one exact GitHub workflow file revision in one repository.",
      "type": "object",
      "additionalProperties": false,
      "required": ["repoId", "workflow", "workflowBlobSha", "requiredJobs", "profiles"],
      "properties": {
        "repoId": {"type": "string"},
        "workflow": {"type": "string"},
        "workflowBlobSha": {"type": "string"},
        "requiredJobs": {"type": "array", "items": {"type": "string"}},
        "profiles": {"type": "array", "items": {"type": "string"}}
      }
    },
    "PublishingCiRecoveryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId"],
      "properties": {
        "projectId": {"type": "string"},
        "expectedHeadSha": {"type": "string"}
      }
    },
    "PublishingCiRecoveryReply": {
      "type": "object",
      "required": ["recoveries"],
      "properties": {"recoveries": {"type": "array", "items": {"$ref": "#/$defs/PublishingRerunFailedReply"}}}
    },
    "PublishingRerunFailedReply": {
      "type": "object",
      "required": ["id", "projectId", "repo", "number", "headSha", "runId", "attempt", "state", "sourceExecutionId", "requestedAt", "updatedAt", "dispatchAcknowledged"],
      "properties": {
        "id": {"type": "string"},
        "projectId": {"type": "string"},
        "repo": {"type": "string"},
        "number": {"type": "integer"},
        "headSha": {"type": "string"},
        "runId": {"type": "integer"},
        "attempt": {"type": "integer"},
        "state": {"type": "string"},
        "sourceExecutionId": {"type": "string"},
        "requestedAt": {"type": "string"},
        "updatedAt": {"type": "string"},
        "handoff": {"type": "string"},
        "dispatchAcknowledged": {"type": "boolean"},
        "evidence": {"$ref": "#/$defs/PublishingCIObservation"}
      }
    },
    "PublishingCIState": {"type": "string", "enum": ["refused", "rate_limited", "dispatch_unknown", "dispatched", "observing", "passed", "handoff"]},
    "PublishingCIObservation": {
      "$comment": "Only classified provider facts, without response bodies, logs or credential-bearing URLs.",
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": {"$ref": "#/$defs/PublishingCIState"},
        "reason": {"type": "string"},
        "attempt": {"type": "integer"},
        "runId": {"type": "integer"},
        "retryAt": {"type": "integer"},
        "originalJobs": {"type": "array", "items": {"$ref": "#/$defs/PublishingCIFailedJob"}},
        "failedJobs": {"type": "array", "items": {"$ref": "#/$defs/PublishingCIFailedJob"}}
      }
    },
    "PublishingCIFailedJob": {
      "type": "object",
      "required": ["id", "name", "headSha"],
      "properties": {"id": {"type": "integer"}, "name": {"type": "string"}, "headSha": {"type": "string"}}
    },
    "PublishingCIWindowSource": {"type": "string", "enum": ["log", "annotation"]},
    "PublishingCIAnnotationStatus": {"type": "string", "enum": ["complete", "partial", "unavailable"]},
    "PublishingCIScanStatus": {"type": "string", "enum": ["complete", "scan_limit", "interrupted", "missing", "empty", "denied", "rate_limited", "unavailable", "unsupported_redirect"]},
    "PublishingCILogsRequest": {
      "$comment": "Host MCP ci_logs on project-publishing and project-forge. Project, repository and execution branch come from the grant.",
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["expectedHeadSha", "jobId"],
      "properties": {
        "expectedHeadSha": {"type": "string"},
        "jobId": {"type": "integer", "minimum": 1}
      }
    },
    "PublishingCIWindow": {
      "$comment": "Half-open byte offsets into decoded excerpt. Log line numbers are one-based in the normalized trace. Annotation lines refer to path.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "startByte", "endByte"],
      "properties": {
        "source": {"$ref": "#/$defs/PublishingCIWindowSource"},
        "startByte": {"type": "integer"},
        "endByte": {"type": "integer"},
        "startLine": {"type": "integer"},
        "endLine": {"type": "integer"},
        "path": {"type": "string"},
        "section": {"type": "string"},
        "partial": {"type": "boolean"}
      }
    },
    "PublishingCIFailedStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "name", "conclusion"],
      "properties": {
        "number": {"type": "integer"},
        "name": {"type": "string"},
        "conclusion": {"type": "string"}
      }
    },
    "PublishingCILogsReply": {
      "$comment": "Host MCP reply JSON, at most 16384 bytes. Complete scan means EOF. A tail on an incomplete scan points to the end of the scanned prefix. Omitted windows counts known candidates only. Absent attempt means unknown; GitLab jobId identifies the individual retry.",
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "host", "repo", "branch", "headSha", "jobId", "jobUrl", "observedAt", "excerpt", "windows", "truncated", "scanStatus", "scannedBytes", "omittedWindows"],
      "properties": {
        "provider": {"$ref": "#/$defs/PublishingProvider"},
        "host": {"type": "string"},
        "repo": {"type": "string"},
        "branch": {"type": "string"},
        "headSha": {"type": "string"},
        "jobId": {"type": "integer"},
        "jobUrl": {"type": "string"},
        "observedAt": {"type": "string"},
        "jobName": {"type": "string"},
        "workflowName": {"type": "string"},
        "runId": {"type": "integer"},
        "pipelineId": {"type": "integer"},
        "attempt": {"type": "integer"},
        "stage": {"type": "string"},
        "failureReason": {"type": "string"},
        "failedSteps": {"type": "array", "items": {"$ref": "#/$defs/PublishingCIFailedStep"}},
        "omittedFailedSteps": {"type": "integer"},
        "annotationStatus": {"$ref": "#/$defs/PublishingCIAnnotationStatus"},
        "excerpt": {"type": "string"},
        "windows": {"type": "array", "items": {"$ref": "#/$defs/PublishingCIWindow"}},
        "tail": {"$ref": "#/$defs/PublishingCIWindow"},
        "truncated": {"type": "boolean"},
        "scanStatus": {"$ref": "#/$defs/PublishingCIScanStatus"},
        "scannedBytes": {"type": "integer"},
        "omittedWindows": {"type": "integer"}
      }
    },
    "PublishingProvider": {
      "type": "string",
      "enum": ["github", "gitlab"]
    },
    "PublishingKind": {
      "type": "string",
      "enum": ["pull_request", "merge_request"]
    },
    "MergeMethod": {
      "type": "string",
      "enum": ["squash", "merge", "rebase"]
    },
    "PublishingCapabilitiesRequest": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "projectId": {"type": "string"},
        "repoId": {"type": "string"},
        "sessionId": {"type": "string"},
        "executionId": {"type": "string"}
      }
    },
    "PublishingCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "repoId",
        "provider",
        "host",
        "repo",
        "defaultBranch",
        "forgeEnabled",
        "autoMergeGranted",
        "mergeMethod",
        "eligibleHosts",
        "providerFactsConfigured",
        "publicationSupported",
        "supportedActions"
      ],
      "properties": {
        "projectId": {"type": "string"},
        "repoId": {"type": "string"},
        "provider": {"$ref": "#/$defs/PublishingProvider"},
        "host": {"type": "string"},
        "repo": {"type": "string"},
        "remote": {"type": "string"},
        "defaultBranch": {"type": "string"},
        "gitConnection": {"type": "string"},
        "forgeEnabled": {"type": "boolean"},
        "ciRerunPolicy": {"$ref": "#/$defs/PublishingCIRerunPolicy"},
        "ciRerunHosts": {"type": "array", "items": {"type": "string"}},
        "autoMergeGranted": {"type": "boolean"},
        "mergeMethod": {"type": "string"},
        "eligibleHosts": {"type": "array", "items": {"type": "string"}},
        "providerFactsConfigured": {"type": "boolean"},
        "publicationSupported": {"type": "boolean"},
        "supportedActions": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": "string"}
      }
    },
    "PublishingCapabilitiesReply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repos"],
      "properties": {
        "projectId": {"type": "string"},
        "repos": {"type": "array", "items": {"$ref": "#/$defs/PublishingCapability"}}
      }
    },
    "PublishingStatusRequest": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "projectId": {"type": "string"},
        "projectIds": {"type": "array", "items": {"type": "string"}},
        "excludeProjectIds": {"type": "array", "items": {"type": "string"}},
        "repoId": {"type": "string"},
        "branch": {"type": "string"},
        "sessionId": {"type": "string"},
        "executionId": {"type": "string"},
        "taskId": {"$comment": "only the pull requests from branches of this task's sessions", "type": "string"}
      }
    },
    "PublishingRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "provider",
        "host",
        "repo",
        "kind",
        "number",
        "title",
        "url",
        "stage",
        "since"
      ],
      "properties": {
        "projectId": {"type": "string"},
        "repoId": {"type": "string"},
        "provider": {"$ref": "#/$defs/PublishingProvider"},
        "host": {"type": "string"},
        "repo": {"type": "string"},
        "kind": {"$ref": "#/$defs/PublishingKind"},
        "number": {"type": "integer"},
        "title": {"type": "string"},
        "url": {"type": "string"},
        "branch": {"type": "string"},
        "baseBranch": {"type": "string"},
        "headSha": {"type": "string"},
        "isDraft": {"type": "boolean"},
        "state": {"type": "string"},
        "stage": {"type": "string"},
        "since": {"type": "string"},
        "opened": {"type": "string"},
        "merged": {"type": "string"},
        "release": {"type": "string"},
        "checksState": {"type": "string"},
        "reviewState": {"type": "string"},
        "mergeable": {"type": "string"},
        "autoMergeEnabled": {"type": "boolean"},
        "mergeMethod": {"type": "string"},
        "sourceExecutionId": {"type": "string"}
      }
    },
    "PublishingStatusReply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "items", "records", "capabilities", "samples", "landing"],
      "properties": {
        "refreshedAt": {"type": ["string", "null"]},
        "source": {"$ref": "ops-executions.schema.json#/$defs/DeliverySource"},
        "error": {"type": "string"},
        "items": {"type": "array", "items": {"$ref": "ops-executions.schema.json#/$defs/DeliveryItem"}},
        "records": {"type": "array", "items": {"$ref": "#/$defs/PublishingRecord"}},
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/PublishingCapability"}},
        "samples": {"type": "array", "items": {"$ref": "ops-executions.schema.json#/$defs/DeliverySample"}},
        "landing": {"type": "integer"}
      }
    },
    "PublishingPublishDraftRequest": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["requestId", "title", "body"],
      "properties": {
        "requestId": {"type": "string"},
        "projectId": {"type": "string"},
        "repoId": {"type": "string"},
        "sourceExecutionId": {"type": "string"},
        "expectedHeadSha": {"type": "string"},
        "title": {"type": "string"},
        "body": {"type": "string"}
      }
    },
    "PublishingPublishDraftReply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "provider", "host", "repo", "branch", "baseBranch", "kind", "number", "url", "headSha", "isDraft", "existing"],
      "properties": {
        "requestId": {"type": "string"},
        "provider": {"$ref": "#/$defs/PublishingProvider"},
        "host": {"type": "string"},
        "repo": {"type": "string"},
        "branch": {"type": "string"},
        "baseBranch": {"type": "string"},
        "kind": {"$ref": "#/$defs/PublishingKind"},
        "number": {"type": "integer"},
        "url": {"type": "string"},
        "headSha": {"type": "string"},
        "isDraft": {"type": "boolean"},
        "existing": {"type": "boolean"},
        "sourceExecutionId": {"type": "string"}
      }
    },
    "PublishingRecordCodeReviewRequest": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["requestId", "expectedHeadSha", "artifactId", "description"],
      "properties": {
        "requestId": {"type": "string"},
        "projectId": {"type": "string"},
        "repoId": {"type": "string"},
        "sourceExecutionId": {"type": "string"},
        "expectedHeadSha": {"type": "string"},
        "artifactId": {"type": "string"},
        "description": {"type": "string"}
      }
    },
    "PublishingRecordCodeReviewReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "verified",
        "provider",
        "host",
        "repo",
        "branch",
        "kind",
        "headSha",
        "context",
        "state",
        "description",
        "artifactId",
        "artifactSha256",
        "providerActor",
        "fleetActor",
        "independentReview",
        "readbackVerified"
      ],
      "properties": {
        "requestId": {"type": "string"},
        "verified": {"type": "boolean"},
        "provider": {"$ref": "#/$defs/PublishingProvider"},
        "host": {"type": "string"},
        "repo": {"type": "string"},
        "branch": {"type": "string"},
        "kind": {"$ref": "#/$defs/PublishingKind"},
        "number": {"type": "integer"},
        "url": {"type": "string"},
        "headSha": {"type": "string"},
        "context": {"type": "string"},
        "state": {"type": "string"},
        "description": {"type": "string"},
        "artifactId": {"type": "string"},
        "artifactSha256": {"type": "string"},
        "providerActor": {"type": "string"},
        "fleetActor": {"type": "string"},
        "onBehalfOf": {"type": "string"},
        "reviewExecutionId": {"type": "string"},
        "sourceExecutionId": {"type": "string"},
        "independentReview": {"type": "boolean"},
        "readbackVerified": {"type": "boolean"},
        "targetUrl": {"type": "string"},
        "updatedAt": {"type": "string"}
      }
    },
    "PublishingMarkReadyRequest": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["requestId"],
      "properties": {
        "requestId": {"type": "string"},
        "projectId": {"type": "string"},
        "repoId": {"type": "string"},
        "repo": {"type": "string"},
        "number": {"type": "integer"},
        "branch": {"type": "string"},
        "hostId": {"type": "string"},
        "sourceExecutionId": {"type": "string"},
        "expectedHeadSha": {"type": "string"}
      }
    },
    "PublishingMarkReadyReply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "provider", "host", "repo", "branch", "kind", "number", "url", "isDraft", "requested", "alreadyReady"],
      "properties": {
        "requestId": {"type": "string"},
        "provider": {"$ref": "#/$defs/PublishingProvider"},
        "host": {"type": "string"},
        "repo": {"type": "string"},
        "branch": {"type": "string"},
        "kind": {"$ref": "#/$defs/PublishingKind"},
        "number": {"type": "integer"},
        "url": {"type": "string"},
        "headSha": {"type": "string"},
        "isDraft": {"type": "boolean"},
        "requested": {"type": "boolean"},
        "alreadyReady": {"type": "boolean"},
        "note": {"type": "string"}
      }
    },
    "PublishingRequestMergeRequest": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["requestId"],
      "properties": {
        "requestId": {"type": "string"},
        "projectId": {"type": "string"},
        "repoId": {"type": "string"},
        "repo": {"type": "string"},
        "number": {"type": "integer"},
        "branch": {"type": "string"},
        "hostId": {"type": "string"},
        "sourceExecutionId": {"type": "string"},
        "expectedHeadSha": {"type": "string"},
        "mergeMethod": {"$ref": "#/$defs/MergeMethod"}
      }
    },
    "PublishingRequestMergeReply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "provider", "host", "repo", "branch", "kind", "number", "url", "requested", "autoMergeEnabled"],
      "properties": {
        "requestId": {"type": "string"},
        "provider": {"$ref": "#/$defs/PublishingProvider"},
        "host": {"type": "string"},
        "repo": {"type": "string"},
        "branch": {"type": "string"},
        "kind": {"$ref": "#/$defs/PublishingKind"},
        "number": {"type": "integer"},
        "url": {"type": "string"},
        "headSha": {"type": "string"},
        "requested": {"type": "boolean"},
        "autoMergeEnabled": {"type": "boolean"},
        "mergeMethod": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "PublishingCancelMergeRequestRequest": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["requestId"],
      "properties": {
        "requestId": {"type": "string"},
        "projectId": {"type": "string"},
        "repoId": {"type": "string"},
        "repo": {"type": "string"},
        "number": {"type": "integer"},
        "branch": {"type": "string"},
        "hostId": {"type": "string"},
        "sourceExecutionId": {"type": "string"},
        "expectedHeadSha": {"type": "string"}
      }
    },
    "PublishingCancelMergeRequestReply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "provider", "host", "repo", "branch", "kind", "number", "url", "cancelled", "alreadyInactive"],
      "properties": {
        "requestId": {"type": "string"},
        "provider": {"$ref": "#/$defs/PublishingProvider"},
        "host": {"type": "string"},
        "repo": {"type": "string"},
        "branch": {"type": "string"},
        "kind": {"$ref": "#/$defs/PublishingKind"},
        "number": {"type": "integer"},
        "url": {"type": "string"},
        "headSha": {"type": "string"},
        "cancelled": {"type": "boolean"},
        "alreadyInactive": {"type": "boolean"},
        "note": {"type": "string"}
      }
    }
  }
}
