{
  "$comment": "Baseline arm: the current TypeScript coordinator. Commands run with sh from the worktree root. Go and Rust arms add their own file with the same keys (docs/designs/fleet-stack.md#trial-slice-l1).",
  "setup": "pnpm install --frozen-lockfile --offline --silent",
  "clean": "rm -rf dist contracts/generated",
  "check": "node contracts/gen-ts.mjs && node_modules/.bin/tsc",
  "build": "node contracts/gen-ts.mjs && node_modules/.bin/tsc && node packages/coordinator/build.mjs",
  "edit": "packages/coordinator/stream.ts",
  "server": "node packages/coordinator/server.ts",
  "artifact": ["dist/packages/coordinator/server-main.js"],
  "runtime": "node",
  "lockfiles": ["pnpm-lock.yaml"],
  "roots": ["fastify", "@fastify/static", "pg", "@clickhouse/client", "typescript", "esbuild", "@types/node", "@types/pg"],
  "disk": ["node_modules", "dist", "contracts/generated"]
}
